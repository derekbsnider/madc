# ! /bin/sh
# AOT object lane: c2m compiles to a relocatable .o (-fobject), the host cc
# links it against libmir (which exports the mir.* builtins for AOT), and the
# result must run and produce the same output as the JIT lanes.
compiler=$1
shift
bdir=`dirname $compiler`
# -no-pie: R2 object code uses absolute text relocations (non-PIC); the PIC
# mode rung lifts this.
$compiler $* -fobject -o ttt.o && cc -no-pie ttt.o $bdir/libmir.a -lm -o ttt && (./ttt; exit $?)
code=$?
rm -f ttt.o ttt
exit $code
