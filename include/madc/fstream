// madc embedded <fstream> — std::ofstream / std::ifstream as header-defined
// classes that bind to the REAL libstdc++ Itanium symbols (the Cfront model:
// madc emits no method bodies; the linker resolves them against libstdc++).
//
// WORK IN PROGRESS — retire-std-hardcoding campaign, replacing the builtin
// DataDef*STREAM + add_fstream_methods + ifstream_*/ofstream_* wrappers. Staged:
//   inc 4 (here): the basic_* templates + their offset-0 nullary methods
//                 (ctor/dtor/close/is_open) — these match libstdc++ exactly and
//                 bind via the generic header-defined-class keystone.
//   inc 5: the real ios_base/basic_ios/basic_ostream/basic_istream base
//          hierarchy + the basic_ios virtual-base this-offset, so good()/eof()
//          (and <<) resolve; open(const char*, openmode); layout-faithful sizes.
//   inc 6: the `ofstream`/`ifstream`/`fstream` typedefs + DELETE the builtins.
//
// char_traits is declared here as the std:: template the stream args name; it
// will move to a shared bits header when std::string migrates.

namespace std {
    template<typename _CharT> class char_traits { char _M_dummy; };

    template<typename _CharT, typename _Traits> class basic_ofstream {
	// Opaque storage placeholder — the real layout (ostream base + filebuf,
	// basic_ios virtual base) lands in inc 5. Size does not affect the mangled
	// method symbols, only object allocation/layout (validated by a doctest).
	long _M_storage[63];
    public:
	basic_ofstream();
	~basic_ofstream();
	void close();
	bool is_open();
    };

    template<typename _CharT, typename _Traits> class basic_ifstream {
	long _M_storage[64];
    public:
	basic_ifstream();
	~basic_ifstream();
	void close();
	bool is_open();
    };
}
