// madc embedded <ns_ui_web> — the WEB target host (design §3.2 of
// docs/plans/2026-09-06-ui-web-target-and-madcide-gui.md): the platform
// webview (WebKitGTK / WKWebView / WebView2) through the typed madcwebview
// module interface. Pulled in by any mention of ui_web:: (auto-include); it
// registers itself as ui target "web" at startup — a file-scope static's
// dynamic initializer, before main. The engine (src/ns_ui.cpp, web_model)
// never names a platform library: this fragment is the ONE place that does,
// through the module map (`import madcwebview;`). The page it shows is the
// engine's (ui_web/page.js + page.css, embedded); the host only hosts.
//
// THREAD CONTRACT: a host is confined to the thread that opened it; the
// page's bound callback runs inside webview_run on that same thread;
// webview_dispatch is the only cross-thread door and nothing here uses it.
import madcwebview;

namespace ui_web {
    // The host state the engine sees only as an opaque handle.
    struct host {
	webview_t view;
	void *ctx;		// the engine session — ui::post_event's key
	int posted;		// events posted during the current run()
	int running;		// inside webview_run (terminate is meaningful)
    };

    // The most recently opened host — the test seam's target
    // (menu_activate); a GUI test opens one window.
    host *__last_host = 0;

    // An event posted from inside the platform loop stops it ONCE per run:
    // the platform delivers terminate through its own idle queue, so a
    // second terminate for a second event in the same run would fire in a
    // LATER run and end it with nothing posted — read as the window
    // closing. Posted OUTSIDE run (the test seam's activate), the event is
    // queued and the engine reads it before running again: no terminate,
    // or the same stale idle would end the next run empty.
    void posted_event(host *h)
    {
	if ( h->posted++ == 0 && h->running )
	    webview_terminate(h->view);	// run() returns; the engine drains the events
    }

    // The ONE bound callback: the page calls window.madc(json) -> here. The
    // request is the call's argument array (["{...}"]); the engine's door
    // unwraps the one string argument.
    void on_event(const char *id, const char *req, void *arg)
    {
	host *h = (host *)arg;
	ui::post_event(h->ctx, req);
	webview_return(h->view, id, 0, "null");
	posted_event(h);
    }

    // A native menu selection (madcwebview_menu_on_action): the SAME door
    // the page uses, as the action event a bound chord would produce.
    void on_menu_action(const char *id, void *arg)
    {
	host *h = (host *)arg;
	var ev = { "kind": "action", "action": id };
	ui::post_event(h->ctx, js::stringify(ev));
	posted_event(h);
    }

    // GTK4 draws the window through its GL renderer, and a software GL
    // (Mesa llvmpipe — every X server without a GPU: Xvfb, VcXsrv, a
    // Docker-to-desktop forward) presents its frames over MIT-SHM. An X
    // connection over TCP has no shared memory — DISPLAY names a host, as
    // Docker → a Windows X server does — and there the GL path fails to
    // attach its images and the window stays BLACK: entirely (measured
    // 2026-09-08 against Xvfb -listen tcp: "MESA: error: Failed to attach
    // to x11 shm", not one painted pixel) or from the first window grow on
    // (the owner's VcXsrv: the exposed region never paints — S0, KG
    // web_window_resize_fill). GTK's cairo renderer draws through plain
    // XPutImage and is correct over any connection, so it is the DEFAULT
    // for a remote display — chosen before GTK initializes (inside
    // webview_create) and only when the user has not named a renderer. A
    // local display (":0", "unix:0", Wayland) keeps GTK's own default.
    // Runs once, on the opening thread, before any GTK thread exists.
    void renderer_default_for_display()
    {
	const char *disp = getenv("DISPLAY");
	if ( !disp || disp[0] == 0 || disp[0] == ':' )
	    return;
	if ( strncmp(disp, "unix:", 5) == 0 )
	    return;
	if ( getenv("GSK_RENDERER") )
	    return;
	setenv("GSK_RENDERER", "cairo", 1);
    }

    void *open(const char *title, const char *page, void *ctx)
    {
	// The module row is LAZY: this fragment compiles and runs on a system
	// without the library; the first call would raise — refuse here with
	// the reason instead (design §3.2).
	if ( !madc::module_available("madcwebview") )
	{
	    println(stderr, "ui_web: the madcwebview library is not available on this system");
	    return 0;
	}
	host *h = (host *)malloc(sizeof(host));
	if ( !h )
	    return 0;
	renderer_default_for_display();
	h->view = webview_create(0, 0);
	if ( !h->view )
	{
	    println(stderr, "ui_web: webview_create failed (no display?)");
	    free(h);
	    return 0;
	}
	h->ctx = ctx;
	h->posted = 0;
	h->running = 0;
	webview_set_title(h->view, title);
	webview_set_size(h->view, 960, 640, WEBVIEW_HINT_NONE);
	webview_bind(h->view, "madc", on_event, h);
	madcwebview_menu_on_action(h->view, on_menu_action, h);
	webview_set_html(h->view, page);
	__last_host = h;
	return h;
    }

    // The native menu bar (S2): the engine's menu JSON — {"bar":[{"title",
    // "items":[{"id","title","key"?,"enabled"}|{"sep"}]}]} — walked here and
    // handed to the platform layer item by item (madcwebview_menu_*: JSON-
    // free by design). 0 = drawn; 1 = the platform has no native menu yet
    // (Win32 / Cocoa) or the text is not a menu — the page stands as it is.
    int64_t menu(void *hv, const char *json)
    {
	host *h = (host *)hv;
	var m;
	if ( !js::parse(m, json) || m["bar"].is_null() )
	    return 1;
	if ( madcwebview_menu_begin(h->view) != 0 )
	    return 1;
	for ( var mn : m["bar"] )
	{
	    var title = mn["title"];
	    for ( var it : mn["items"] )
	    {
		if ( !it["sep"].is_null() )
		{
		    madcwebview_menu_separator(h->view, title.c_str());
		    continue;
		}
		var id = it["id"];
		var itl = it["title"];
		var key = it["key"];
		bool en = it["enabled"].is_null() || it["enabled"].as_boolean();
		madcwebview_menu_add(h->view, title.c_str(), id.c_str(), itl.c_str(),
				     key.is_null() ? "" : key.c_str(), en ? 1 : 0);
	    }
	}
	return madcwebview_menu_end(h->view) == 0 ? 0 : 1;
    }

    // The test seam: choose a menu item by its command id as the user would
    // (the platform fires the action; the event reaches the engine).
    // 0 = fired; 1 = no window, no menu, or no such item.
    int64_t menu_activate(const char *id)
    {
	if ( !__last_host )
	    return 1;
	return madcwebview_menu_activate(__last_host->view, id) == 0 ? 0 : 1;
    }

    void close(void *hv)
    {
	host *h = (host *)hv;
	if ( __last_host == h )
	    __last_host = 0;
	webview_unbind(h->view, "madc");
	webview_destroy(h->view);
	free(h);
    }

    // Script text into the page; 0 = accepted. Evals before the first run()
    // are the platform view's to drop (the page has not loaded yet): the
    // first resize event is the page's ready signal — render after it.
    int64_t eval(void *hv, const char *js)
    {
	host *h = (host *)hv;
	return webview_eval(h->view, js) == WEBVIEW_ERROR_OK ? 0 : 1;
    }

    // Run the platform loop until the page posts ONE event (on_event
    // terminates the loop), then return 0; the loop ending with nothing
    // posted means the window closed: 1.
    int64_t run(void *hv)
    {
	host *h = (host *)hv;
	h->posted = 0;
	h->running = 1;
	webview_error_t rc = webview_run(h->view);
	h->running = 0;
	if ( rc != WEBVIEW_ERROR_OK )
	    return 1;
	return h->posted ? 0 : 1;
    }

    // The name a program hands ui::open.
    const char *target() { return "web"; }
}

static ui::ui_host_ops __ui_web_ops = { ui_web::open, ui_web::close, ui_web::eval, ui_web::run, ui_web::menu };
static bool __ui_web_registered = ui::register_host("web", &__ui_web_ops);
