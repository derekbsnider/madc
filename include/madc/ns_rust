// madc embedded <ns_rust> — Rust-style string + array conveniences.
// DIALECT-LEAN (owner standing rule 2026-08-21): ZERO includes — the
// char*/array-typed surface below is always available; the std::string
// C++-interop conveniences are declared only when <string> was included
// BEFORE this header (the <ns_madc> guard convention; auto-include
// orders <string> first, explicit includers write it above this line).

// Declarations only (cpp-first-api.md): libmadc defines every rust::
// public (src/ns_rust.cpp), resolved mangled-direct.
namespace rust {
    int64_t contains(const char *text, const char *needle);
    int64_t starts_with(const char *text, const char *prefix);
    int64_t ends_with(const char *text, const char *suffix);
    int64_t len(const char *text);
    int64_t is_empty(const char *text);
    void split(array &out, const char *text, const char *delim);
    void split_whitespace(array &out, const char *text);
    void push(array &values, const char *value);
    // Lean PRIMARIES (dialect-lean.md, Rust parity): trim/replace/repeat/
    // join return NEW strings — ring-lifetime returns (the c_str
    // contract). first/last/get/pop return the ELEMENT via a value
    // out-param (Rust's Option: `out` stays null when there is nothing).
    const char *trim(value &s);
    const char *trim(const char *s);
    const char *trim_start(value &s);
    const char *trim_start(const char *s);
    const char *trim_end(value &s);
    const char *trim_end(const char *s);
    const char *replace(value &s, const char *from, const char *to);
    const char *replace(const char *s, const char *from, const char *to);
    const char *repeat(value &s, int64_t count);
    const char *repeat(const char *s, int64_t count);
    const char *join(array &values, const char *sep);
    value &first(value &out, array &values);
    value &last(value &out, array &values);
    value &get(value &out, array &values, int64_t idx);
    value &pop(value &out, array &values);
}

#if defined(_GLIBCXX_STRING) || defined(_LIBCPP_STRING)
// std::string C++-INTEROP conveniences — present only because <string>
// precedes this header.

namespace rust {
    std::string &trim(std::string &s);
    std::string &trim_start(std::string &s);
    std::string &trim_end(std::string &s);
    std::string &replace(std::string &s, const char *from, const char *to);
    std::string &repeat(std::string &s, int64_t count);
    std::string &join(std::string &result, array &values, const char *sep);
    std::string &first(std::string &result, array &values);
    std::string &last(std::string &result, array &values);
    std::string &get(std::string &result, array &values, int64_t idx);
    std::string &pop(std::string &result, array &values);
}
#endif
