// madc embedded <ns_ruby> — Ruby-style string + array conveniences.
// DIALECT-LEAN (owner standing rule 2026-08-21): ZERO includes — the
// char*/array-typed surface below is always available; the std::string
// C++-interop conveniences are declared only when <string> was included
// BEFORE this header (the <ns_madc> guard convention; auto-include
// orders <string> first, explicit includers write it above this line).

extern "C" {
    const char *__rb_delete_cstr(const char *, const char *);
    const char *__rb_delete_value(value *, const char *);
}

// Declarations only (cpp-first-api.md): libmadc defines every ruby::
// public (src/ns_ruby.cpp), resolved mangled-direct.
namespace ruby {
    void chars(array &out, const char *text);
    int64_t count(const char *text, const char *chars);
    int64_t include(const char *text, const char *substr);
    void rotate(array &values, int64_t n);
    void compact(array &values);
    void flatten(array &values, const char *text);
    // Lean PRIMARIES (dialect-lean.md, Ruby parity): these are the
    // NON-BANG methods — they return a NEW string. Ring-lifetime returns
    // (the c_str contract): pass onward or capture immediately.
    const char *squeeze(value &s);
    const char *squeeze(const char *s);
    const char *capitalize(value &s);
    const char *capitalize(const char *s);
    const char *tr(value &s, const char *from, const char *to);
    const char *tr(const char *s, const char *from, const char *to);
    // `delete` is a C++ keyword: host C++ cannot define ruby::delete, so
    // its overloads keep their bodies over the extern "C" cores (R3 compiles
    // dialect bodies into libmadc).
    const char *delete(value &s, const char *chars) { return __rb_delete_value(&s, chars); }
    const char *delete(const char *s, const char *chars) { return __rb_delete_cstr(s, chars); }
    const char *gsub(value &s, const char *pattern, const char *replacement);
    const char *gsub(const char *s, const char *pattern, const char *replacement);
    const char *sub(value &s, const char *pattern, const char *replacement);
    const char *sub(const char *s, const char *pattern, const char *replacement);
}

#if defined(_GLIBCXX_STRING) || defined(_LIBCPP_STRING)
// std::string C++-INTEROP conveniences — present only because <string>
// precedes this header.

extern "C" {
    std::string *__rb_delete(std::string *, const char *);
}

namespace ruby {
    std::string &squeeze(std::string &s);
    std::string &tr(std::string &s, const char *from, const char *to);
    std::string &capitalize(std::string &s);
    std::string &delete(std::string &s, const char *chars) { return *__rb_delete(&s, chars); }
    std::string &gsub(std::string &s, const char *pattern, const char *replacement);
    std::string &sub(std::string &s, const char *pattern, const char *replacement);
}
#endif
