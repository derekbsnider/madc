// madc embedded <ns_ui_ws> — the WEB target over a BYTE CHANNEL (client-server
// arc V6b): the same engine page.js and the same web_model, but the DOM ops go
// down a madc::channel (an RFC6455 WebSocket channel) and the page's event JSON
// comes back up it — instead of a platform webview. libmadc's own host
// (src/ui_ws.cpp): the engine serves target "ws" at ui::WEB BY NAME
// (ui::open("ws")), never by level, so it never collides with the webview
// host that also serves ui::WEB.
//
// The channel is the SEAT'S: this host borrows it for the frontend's lifetime
// and never closes it (the serve task that accepted + upgraded it owns that).
//
// THREAD CONTRACT: a host is confined to the cooperative scheduler thread that
// opened it (the serve task). run()'s readline PARKS that task on the socket,
// so other clients' tasks run while this one idles — no OS-thread block.

namespace ui_ws {
    // The connection the NEXT open("ws") on this thread binds. The serve seat
    // calls attach() immediately before ui::open("ws"); the cooperative
    // scheduler never yields between those two calls, so two seats can never
    // race the slot (it is per thread in libmadc).
    void attach(madc::channel *ch);

    // The host's table entries (ui::ui_host_ops), libmadc's (src/ui_ws.cpp):
    // open(title, page, ctx) binds the pending channel to a new frontend
    // (`page` is ignored — a ws client loaded it over HTTP before dialing
    // the socket); close(host) drops the host, never the seat's channel;
    // eval(host, js) sends one ws text frame (0 = sent, 1 = the socket
    // failed); run(host) reads one message and posts it as the page's event
    // (0), or ends the window on a closed channel (1).
    void *open(const char *title, const char *page, void *ctx);
    void close(void *hv);
    int64_t eval(void *hv, const char *js);
    int64_t run(void *hv);
}
