extern "C" {
    long madarray_size(array *);
    const char *__php_array_get_cstr(array *, long);
}

long __madc_array_size(array &values) { return madarray_size(&values); }
const char *__madc_array_get_cstr(array &values, long index) { return __php_array_get_cstr(&values, index); }

namespace std {
    void for_each(array &values, void (*fn)(string)) {
	string value;
	long n = __madc_array_size(values);
	for (long i = 0; i < n; i = i + 1) {
	    value = __madc_array_get_cstr(values, i);
	    fn(value);
	}
    }
}
