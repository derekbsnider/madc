// madc embedded <set> — std::set<T> as a real madc template.
//
// std::set is an ordinary std::-namespaced madc template, instantiated per use
// by the template-instantiation engine (Borland monomorphization). It is NOT a
// lexer keyword and NOT a libstdc++ wrapper — it is madc's own STL container,
// defined here and compiled through the class model.
//
// Implementation: a flat array with linear search (madc's own simple set, not
// a balanced tree). insert() dedups. String elements compare via c_str()+strcmp
// (std::string operator== is an inlined free template, not a dlsym-exported
// symbol). The search loop is inlined into each method rather than factored
// into a private __find(): madc does not yet support an unqualified sibling-
// method call from inside a class method. A method call on a subscript element
// (`data[i].c_str()`) is likewise not yet a supported parse form, so each
// search copies the element into a local first.
#include <stdlib.h>
#include <string.h>
namespace std {
template<typename T> class set {
    T* data;
    long len;
    long cap;
    set() { data = (T*)malloc(4 * sizeof(T)); len = 0; cap = 4; }
    ~set() { free(data); }
    void insert(T v) {
	long i = 0;
	while ( i < len ) {
	    T cur = data[i];
	    if ( strcmp(cur.c_str(), v.c_str()) == 0 )
		return;			// dedup: element already present
	    i = i + 1;
	}
	if ( len >= cap ) {
	    cap = cap * 2;
	    data = (T*)realloc(data, cap * sizeof(T));
	}
	T* slot = data + len;		// pointer arith (NOT &data[len] — parser gap)
	new (slot) T(v);		// placement copy-construct (works for string)
	len = len + 1;
    }
    int contains(T v) {
	long i = 0;
	while ( i < len ) {
	    T cur = data[i];
	    if ( strcmp(cur.c_str(), v.c_str()) == 0 )
		return 1;
	    i = i + 1;
	}
	return 0;
    }
    long size() { return len; }
};
}
