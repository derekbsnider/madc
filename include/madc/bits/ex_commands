// madc embedded <bits/ex_commands> — the ex core's command vocabulary as an
// ENUM, the ONE text for two readers: the engine (madc::ex::command aliases
// it, include/madc_ex.h) and the dialect (<ns_madc> includes it, so a host
// that edits switches on `madc::ex_command::write` — an enumerator the
// compiler checks — never on a typed name).
// Plain C++11 enums, nothing else (dialect-lean).
//
// Thread contract: constants.
#ifndef __MADC_BITS_EX_COMMANDS
#define __MADC_BITS_EX_COMMANDS 1

namespace madc {
    // Every command the core knows (D24's list). A typed name becomes one
    // of these once, through the one table (src/madc_ex.cpp); `none` is a
    // line with no command — a bare address or an empty line.
    enum class ex_command : unsigned char
    {
	none,
	print, number, list, line_number,		// p  nu/#  l  =
	append, insert, change, del, join,		// a  i  c  d  j
	move, copy, shift_right, shift_left,		// m  t/co  >  <
	undo, redo,					// u  red
	substitute, repeat_sub, repeat_sub_flags,	// s  &  &&
	global, vglobal,				// g  v
	sort, retab,					// sor  ret
	mark, marks,					// ma/k  marks
	read, write, write_quit, exit, update, saveas, edit, quit,
							// r w wq x up sav e q
	buffers, buffer, bnext, bprevious,		// ls  b  bn  bp
	cd, pwd, set, help, shell			// cd pw se h  !
    };
}

#endif // __MADC_BITS_EX_COMMANDS
