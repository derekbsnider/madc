// madc embedded <bits/session_enums> — an interactive session's reply
// vocabularies as ENUMS, the ONE text for two readers: the engine
// (InteractiveSession::OfferState and SessionClient::Reply::Kind alias these)
// and the dialect (<ns_madc> includes it, so a pane switches on
// `r["kind"] == madc::session_reply::complete` — an enumerator the compiler
// checks — instead of comparing a word).
// Plain C++11 enums, nothing else (dialect-lean). The wire's words are the
// backend's own table (src/madc_session_client.cpp), never re-typed here.
//
// Thread contract: constants.
#ifndef __MADC_BITS_SESSION_ENUMS
#define __MADC_BITS_SESSION_ENUMS 1

namespace madc {
    // An offered entry's verdict (plan §41.5a): taken (final — it ran or was
    // refused), incomplete (keep reading), extendable (a finished if with no
    // else; D11 waits one line).
    enum class offer_state : unsigned char { taken, incomplete, extendable };
    // What a session reply answers (plan §41.9a): running (an offered entry
    // was taken and runs now — Jupyter's execute_input; its output follows,
    // then its offer reply), an offer, a completion, the backend's end (a
    // crash; the session's state went with it), a program file loaded, its
    // main run (the cores of %load and %run), D11's question answered, or
    // the names the session defined (%whos's rows, plan §41.11a step 3d).
    enum class session_reply : unsigned char { running, offer, complete, stopped, load, run, continues, bindings };
    // What a taken command asks its HOST to do (IPython's payloads: a
    // kernel's execute reply asks its frontend to act) with the reply's
    // `argv`, the file and then its arguments, the host reading the file (an
    // IDE's open buffer is its live text): none; load (%load, D25: the file
    // loaded, nothing run); run (%run, D16: a FRESH session, which the
    // session cannot start itself — the host restarts it, loads the file and
    // runs its main, as F5 does); run_here (%run -i: loaded and run in this
    // session).
    enum class session_payload : unsigned char { none, load, run, run_here };
    // What a top-level name names (plan §41.8a; the engine's
    // Program::TopLevelName::Kind aliases it): a binding row's `kind`
    // (%whos, madcide's Variables view, plan §41.11a) is one of these codes.
    enum class name_kind : unsigned char
    {
	object, function, type, tag, name_space, class_template,
	function_template, keyword, macro, header_name, dialect_word, result
    };
}

#endif // __MADC_BITS_SESSION_ENUMS
