// madc embedded <bits/session_enums> — an interactive session's reply
// vocabularies as ENUMS, the ONE text for two readers: the engine
// (InteractiveSession::OfferState and SessionClient::Reply::Kind alias these)
// and the dialect (<ns_madc> includes it, so a pane switches on
// `r["kind"] == madc::session_reply::complete` — an enumerator the compiler
// checks — instead of comparing a word).
// Plain C++11 enums, nothing else (dialect-lean). The wire's words are the
// backend's own table (src/madc_session_client.cpp), never re-typed here.
//
// Thread contract: constants.
#ifndef __MADC_BITS_SESSION_ENUMS
#define __MADC_BITS_SESSION_ENUMS 1

namespace madc {
    // An offered entry's verdict (plan §41.5a): taken (final — it ran or was
    // refused), incomplete (keep reading), extendable (a finished if with no
    // else; D11 waits one line).
    enum class offer_state : unsigned char { taken, incomplete, extendable };
    // What a session reply answers (plan §41.9a): running (an offered entry
    // was taken and runs now — Jupyter's execute_input; its output follows,
    // then its offer reply), an offer, a completion, the backend's end (a
    // crash; the session's state went with it), a program file loaded, its
    // main run (the cores of %load and %run), D11's question answered, or
    // the names the session defined (%whos's rows, plan §41.11a step 3d), a
    // file built (%build, plan §7f), a file checked (%check), a host's
    // edited REPL buffer read again (the live reparse), a rebuild's entry
    // (replayed: its running row carries the entry's text) or the rebuild
    // done (rebuild: the host's REPL buffer run again, then its main).
    enum class session_reply : unsigned char { running, offer, complete, stopped, load, run, continues, bindings, build, check, edited, replayed, rebuild };
    // What a taken command asks its HOST to do (IPython's payloads: a
    // kernel's execute reply asks its frontend to act) with the reply's
    // `argv`, the file and then its arguments, the host reading the file (an
    // IDE's open buffer is its live text): none; load (%load, D25: the file
    // loaded, nothing run); run (%run, D16: a FRESH session, which the
    // session cannot start itself — the host restarts it, loads the file and
    // runs its main, as F5 does); run_here (%run -i: loaded and run in this
    // session); build (%build: argv is FILE, then OUT — the host hands
    // FILE's text to the session's build); call (%call FILE(ARGS), cling's
    // .x: argv is FILE, then the call's text — loaded, then a run with
    // `call` calls the function named after FILE, else its main); open
    // (%open, %edit: argv is FILE, then the line when one is named — an IDE
    // opens its editor there, a terminal runs $EDITOR); quit (%quit: end
    // the session, IPython's ask_exit — a terminal ends, an IDE pane starts
    // a fresh session; no argv); command (a command the HOST registered on
    // the session, split arc 1A.2: the reply's `code` is the row's code,
    // argv is its argument — the host runs it, nothing ran in the session);
    // reset (%reset: a fresh session under the same standard; no argv);
    // standard (%std NAME: a fresh session under the standard argv[0]
    // spells — c17, gnu++20, madc; split arc 1B.7); check (%check [FILE]:
    // argv FILE, "" for the host's current buffer — the host hands the
    // backend its text; split arc 1B.8); args (%args [ARGS]: argv the
    // argument line — the program's arguments a host's %run of its current
    // buffer passes, kept by the host); project (%project opened, changed
    // or closed the session's project: argv the manifest's path, "" for
    // none — the host keeps it across restarts, an IDE opens it).
    enum class session_payload : unsigned char { none, load, run, run_here, build, call, open, quit, command, reset, standard, check, args, project };
    // An entry's MODE, its first character (owner 2026-10-09; split arc
    // 1A.2, docs/plans/2026-10-09-command-registry-design.md): `%` and `.`
    // the REPL's commands (IPython / clang-repl style, cling / Node style,
    // each with its own aliases), `?` the query, `:` colon mode — ed / ex /
    // vim commands ONLY, run by the host that holds the documents, never by
    // the session. none: not a command (C).
    enum class command_mode : unsigned char { none, percent, dot, query, colon };
    // A session command (plan §41.8a, D13/D24; the engine's
    // InteractiveSession::Command aliases it): what an entry's `%name` or
    // `.name` names, an alias's command included (cling's `.L` is load).
    // none: no built-in command — a registered one (split arc 1A.2), or a
    // typo the session refuses.
    enum class session_command : unsigned char
    {
	none, help, type, pinfo, whos, load, run, build, call, open, edit, quit,
	history, reset, standard, check, args, project
    };
    // What a top-level name names (plan §41.8a; the engine's
    // Program::TopLevelName::Kind aliases it): a binding row's `kind`
    // (%whos, madcide's Variables view, plan §41.11a) is one of these codes.
    enum class name_kind : unsigned char
    {
	object, function, type, tag, name_space, class_template,
	function_template, keyword, macro, header_name, dialect_word, result
    };
}

#endif // __MADC_BITS_SESSION_ENUMS
