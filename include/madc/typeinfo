// madc embedded <typeinfo> — std::type_info as a header-defined class (S5).
//
// type_info's name()/operator==/operator!= are INLINE in libstdc++'s own header
// (they are NOT exported symbols — only the dtors/__do_catch/__do_upcast are), so
// they cannot be bound to libstdc++ via the keystone. They are given inline bodies
// here instead, matching libstdc++'s definitions.
//
// LAYOUT (Itanium): a type_info object is { vtable_ptr @0 ; const char* __name @8 }.
// The objects madc emits for user classes (_ZTI<cls>, see cir_builder S5b) and the
// objects libstdc++ emits (_ZTI<builtin>) both follow this layout, so __name (the
// 2nd field) is the mangled type-name string (_ZTS<cls>). `typeid` (cir_builder S5d)
// yields a type_info reference pointing at one of these objects.
//
// operator== is object identity: madc emits exactly ONE _ZTI per type (deduped in
// Pass 1.5) and typeid always yields that object for a given type, so equal type
// <=> same object. (libstdc++ compares __name; identity is equivalent here and
// needs no strcmp dependency.)
//
// NOTE: no `const` is used on the members/methods/params — madc does not yet parse
// a const-qualified class member or a trailing const method qualifier (orthogonal
// parser gaps), and it does not enforce const-correctness, so this is faithful in
// behaviour. name() returns char* rather than const char* for the same reason.

namespace std {
    class type_info {
	void *__vtable_ptr;   // offset 0: the type_info-class vtable address point
	char *__name;         // offset 8: the mangled type name (_ZTS<cls>)
    public:
	char *name() { return __name; }
	// Identity via the name pointer: madc emits exactly ONE _ZTS per type, so
	// equal type <=> equal __name pointer. (Comparing __name avoids taking the
	// address of a reference param, which madc lowers to a pointer.)
	bool operator==(type_info &__o) { return __name == __o.__name; }
	bool operator!=(type_info &__o) { return __name != __o.__name; }
    };
}
