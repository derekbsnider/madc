// madc embedded <ns_python> — Python-style string conveniences.
// DIALECT-LEAN (owner standing rule 2026-08-21): ZERO includes — the
// char*-typed surface below is always available; the std::string
// C++-interop conveniences are declared only when <string> was included
// BEFORE this header (the <ns_madc> guard convention; auto-include
// orders <string> first, explicit includers write it above this line).

// Declarations only (cpp-first-api.md): libmadc defines every python::
// public (src/ns_python.cpp), resolved mangled-direct.
namespace python {
    // Python str.format on the shared std::format engine ({} automatic,
    // {0} manual, format specs, {{ }} escaping); the value-out lean
    // primary — the std::string form below is the guarded convenience.
    value &format(value &out, const char *fmt, array &args);
    int64_t count(const char *haystack, const char *needle);
    int64_t startswith(const char *text, const char *prefix);
    int64_t endswith(const char *text, const char *suffix);
    int64_t isdigit(const char *text);
    int64_t isalpha(const char *text);
    int64_t isalnum(const char *text);
    int64_t isspace(const char *text);
    // Lean PRIMARIES (dialect-lean.md, Python parity): Python strings are
    // immutable — every str method returns a NEW string. Ring-lifetime
    // returns (the c_str contract): pass onward or capture immediately.
    const char *title(value &s);
    const char *title(const char *s);
    const char *swapcase(value &s);
    const char *swapcase(const char *s);
    const char *center(value &s, int64_t width, const char *fill);
    const char *center(const char *s, int64_t width, const char *fill);
    const char *ljust(value &s, int64_t width, const char *fill);
    const char *ljust(const char *s, int64_t width, const char *fill);
    const char *rjust(value &s, int64_t width, const char *fill);
    const char *rjust(const char *s, int64_t width, const char *fill);
    const char *zfill(value &s, int64_t width);
    const char *zfill(const char *s, int64_t width);
    const char *replace(value &s, const char *old_text, const char *new_text);
    const char *replace(const char *s, const char *old_text, const char *new_text);
    // shlex.split (POSIX mode): the words of a shell-like command line into
    // OUT — '...' literal, "..." keeping \" and \\ as escapes, a backslash
    // outside quotes taking the next character. False = an unclosed quote
    // or a trailing backslash (Python's ValueError); OUT is left empty.
    // Declared here, defined in the host (src/ns_python.cpp), resolved
    // mangled-direct. Thread contract: a pure function.
    bool shlex_split(value &out, const char *text);
    // shlex.quote: WORD spelled so shlex_split reads it back as that one word
    // — as it is when only letters, digits and @%+=:,./-_ ; '' when empty;
    // else '...' with each ' spelled '"'"'. Ring-lifetime text; defined in
    // the host, resolved mangled-direct. Thread contract: a pure function.
    const char *shlex_quote(const char *word);
}

