// madc embedded <map> — std::map<K,V> as a real madc template.
//
// std::map is an ordinary std::-namespaced madc template, instantiated per
// use by the template-instantiation engine (Borland monomorphization). It is
// NOT a lexer keyword and NOT a libstdc++ wrapper — it is madc's own STL
// container, defined here and compiled through the class model.
//
// Implementation: parallel arrays of keys/values with linear search (madc's
// own simple map, not a balanced tree). Keys compare through operator==. The
// header instantiates per K, so only the matching code is compiled; no
// scalar-key test exists.
//
// The search loop is inlined into each method rather than factored into a
// private __find(): madc does not yet support an unqualified sibling-method
// call from inside a class method (`__find(k)` -> "undeclared identifier").
// An operator on a subscript element (`keys[i] == k`) IS now a supported parse
// form, so each search compares the key directly (no copy-to-local).
#include <stdlib.h>
#include <string.h>
namespace std {
template<typename K, typename V> class map {
    K* keys;
    V* vals;
    long len;
    long cap;
public:
    map() {
	keys = (K*)malloc(4 * sizeof(K));
	vals = (V*)malloc(4 * sizeof(V));
	len = 0;
	cap = 4;
    }
    ~map() {
	// Destruct each live key and value before releasing the buffers, as
	// std::map does (destroy every node's key+value, then deallocate).
	// __destroy is the element-type-driven destroy intrinsic: it calls the
	// class dtor for an object key/value (string -> ~basic_string) and is a
	// no-op for a scalar/pointer K/V. Pointer arith (keys + i / vals + i),
	// NOT &keys[i] (member-subscript parser gap).
	long i = 0;
	while ( i < len ) { __destroy(keys + i); __destroy(vals + i); i = i + 1; }
	free(keys);
	free(vals);
    }
    void put(K k, V v) {
	long i = 0;
	while ( i < len ) {
	    if ( keys[i] == k ) {
		V* vslot = vals + i;	// pointer arith (NOT &vals[i] — parser gap)
		new (vslot) V(v);	// overwrite value in place
		return;
	    }
	    i = i + 1;
	}
	if ( len >= cap ) {
	    cap = cap * 2;
	    keys = (K*)realloc(keys, cap * sizeof(K));
	    vals = (V*)realloc(vals, cap * sizeof(V));
	}
	K* kslot = keys + len;
	V* vslot = vals + len;
	new (kslot) K(k);		// placement copy-construct (works for string)
	new (vslot) V(v);
	len = len + 1;
    }
    V get(K k) {
	long i = 0;
	while ( i < len ) {
	    if ( keys[i] == k )
		return vals[i];
	    i = i + 1;
	}
	return vals[0];
    }
    int contains(K k) {
	long i = 0;
	while ( i < len ) {
	    if ( keys[i] == k )
		return 1;
	    i = i + 1;
	}
	return 0;
    }
    long size() { return len; }
    V& operator[](K k) {
	long i = 0;
	while ( i < len ) {
	    if ( keys[i] == k )
		return vals[i];
	    i = i + 1;
	}
	if ( len >= cap ) {
	    cap = cap * 2;
	    keys = (K*)realloc(keys, cap * sizeof(K));
	    vals = (V*)realloc(vals, cap * sizeof(V));
	}
	K* kslot = keys + len;
	V* vslot = vals + len;
	new (kslot) K(k);
	new (vslot) V();		// default-construct the value slot
	long at = len;
	len = len + 1;
	return vals[at];
    }
};
}
