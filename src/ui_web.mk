# ui_web.mk — the ui_web MODULE (include/madc_module.h): the WEB target's host
# over the platform webview (WebKitGTK 6.0 / WKWebView / WebView2). A program
# says `import ui_web;`; madc finds the module by name in its module directory
# (lib/madc/modules/ui_web.<dso>), the module describes itself (its face, the
# GUI flag) and, as it loads, registers its host as ui target "web" serving
# ui::WEB. Nothing about it lives in the core; madc itself never loads it, only
# a program that imports it does. Built by `make -C src ui_web` (or the named
# cross targets below); never linked into libmadc.
#
# ONE image holds upstream's library (third_party/webview), madc's native
# chrome around it (modules/ui_web/madcwebview_chrome.cc — menu bar, file
# dialogs, clipboard, the loop's stop and tick on GTK4 / Cocoa / Win32), the
# host (modules/ui_web/ui_web.cpp) and the declaration table generated from
# its face (modules/ui_web/ui_web.madi: ui_web::menu_activate). The webview C
# API is the module's own: the host calls it, a program reaches the window
# through ui::.
#
# The module binds libmadc's own symbols (ui::register_host, ui::post_event,
# madc::value, js::parse / js::stringify, the registration API its generated
# builders call) at LOAD, from the image that imported it: undefined at link
# on ELF and Mach-O (-undefined dynamic_lookup); a PE DLL links libmadc's
# import lib (../lib/libmadc.dll.a from ../bin/libmadc-0.dll).
WEBVIEW_DIR = ../third_party/webview
WEBVIEW_SOURCE = $(WEBVIEW_DIR)/core/src/webview.cc
UI_WEB_DIR = modules/ui_web
UI_WEB_SRC = $(UI_WEB_DIR)/ui_web.cpp $(UI_WEB_DIR)/madcwebview_chrome.cc
UI_WEB_FACE = $(UI_WEB_DIR)/ui_web.madi
UI_WEB_HDRS = $(UI_WEB_DIR)/madcwebview_chrome.h $(INCDIR)/madc_module.h $(INCDIR)/madcdis/ui_host.h $(INCDIR)/libmadc/value.h
WEBVIEW_HEADERS = $(wildcard $(WEBVIEW_DIR)/core/include/*.h $(WEBVIEW_DIR)/core/include/webview/*.h $(WEBVIEW_DIR)/compatibility/mingw/include/*.h)
WEBVIEW_WEBKITGTK_API ?= 6.0
WEBVIEW_MACOS_MINOS ?= 13.3
WEBVIEW2_SDK_DIR ?= $(abspath ../obj/webview/webview2-sdk)
WEBVIEW_FLAGS = -O2 -DWEBVIEW_BUILD_SHARED -I$(WEBVIEW_DIR)/core/include -I$(INCDIR)
UI_WEB_BUILD_DIR = ../obj/ui_web/$(MODE)
WEBVIEW_CXX = $(CXX)
UI_WEB_LINK_PREREQ =

ifeq ($(MODE),hosted-x86-64-windows)
UI_WEB_LIBRARY = $(MODULE_LIBDIR)/ui_web.dll
WEBVIEW_CXXFLAGS = -std=c++14 $(WEBVIEW_FLAGS) -I$(WEBVIEW_DIR)/compatibility/mingw/include -I$(WEBVIEW2_SDK_DIR)/build/native/include
# Use the SAME UCRT C++/pthread runtime as madc; never introduce an MSVCRT
# libstdc++ copy. win_ucrt_compat supplies the static-libgcc setjmp imports.
# comctl32: the window subclass the chrome reads WM_COMMAND through; uuid:
# the file-dialog CLSIDs / IIDs (madcwebview_chrome.cc); libmadc's import lib:
# the engine symbols the host calls.
WEBVIEW_LDFLAGS = -shared -static-libgcc -L$(WIN_UCRT_LIBSTDCXX)/lib -L../lib -lmadc.dll -ladvapi32 -lole32 -lshell32 -lshlwapi -luser32 -lversion -lcomctl32 -luuid -lpthread
WEBVIEW_EXTRA = $(OBJDIR)/win_ucrt_compat.o $(WEBVIEW2_SDK_DIR)/.sha256
UI_WEB_LINK_PREREQ = ../bin/libmadc-0.dll
else ifdef HOSTED_DARWIN_TARGET
WEBVIEW_CXX = $(DARWIN_CLANGXX) -target $(subst x86-64,x86_64,$(DARWIN_ARCH))-apple-macos$(WEBVIEW_MACOS_MINOS) --sysroot $(MACOS_SDK) $(DARWIN_CXX_ISYS)
UI_WEB_LIBRARY = $(MODULE_LIBDIR)/$(DARWIN_ARCH)-macos/ui_web.dylib
# -fblocks: the save/open panel's completion handler is a block (the chrome
# is C++ over the ObjC runtime, like the library itself).
WEBVIEW_CXXFLAGS = -std=c++11 $(WEBVIEW_FLAGS) -fblocks
WEBVIEW_LDFLAGS = $(DARWIN_LD_FLAGS) -dynamiclib -Wl,-install_name,@rpath/ui_web.dylib -undefined dynamic_lookup -framework WebKit
else
UI_WEB_LIBRARY = $(MODULE_LIBDIR)/ui_web.so
WEBVIEW_CXXFLAGS = -std=c++11 $(WEBVIEW_FLAGS) -fPIC $(shell pkg-config --cflags webkitgtk-$(WEBVIEW_WEBKITGTK_API) gtk4 2>/dev/null)
WEBVIEW_LDFLAGS = -shared -Wl,-soname,ui_web.so $(shell pkg-config --libs webkitgtk-$(WEBVIEW_WEBKITGTK_API) gtk4 2>/dev/null) -ldl
endif

# The face's generated table: one file for every target (the builders name
# DataDefs, never sizes or symbols), generated by the build host's madc.
$(eval $(call madc_module_table_rules,ui_web,$(UI_WEB_FACE)))
UI_WEB_TABLE = $(MODULE_TABLE_DIR)/ui_web/ui_web.inc

.PHONY: ui_web ui_web-windows ui_web-macos ui_web-arm64-macos ui_web-x86-64-macos ui_web-deps
ui_web: $(UI_WEB_LIBRARY)
ifeq ($(MODE),hosted-x86-64-windows)
ui_web: ../bin/libstdc++-6.dll ../bin/libwinpthread-1.dll
endif
ui_web-windows:
	$(MAKE) MODE=hosted-x86-64-windows ui_web
ui_web-macos: ui_web-arm64-macos ui_web-x86-64-macos
ui_web-arm64-macos ui_web-x86-64-macos:
	$(MAKE) MODE=hosted-$(patsubst ui_web-%,%,$@) ui_web

ui_web-deps:
ifeq ($(MODE),hosted-x86-64-windows)
	@test -f $(WIN_UCRT_LIBSTDCXX)/lib/libstdc++.dll.a || { echo 'ui_web needs the UCRT stage: scripts/build_win_ucrt_libstdcxx.sh' >&2; exit 1; }
else ifndef HOSTED_DARWIN_TARGET
	@test '$(WEBVIEW_WEBKITGTK_API)' = 6.0 || { echo 'madc webview requires WEBVIEW_WEBKITGTK_API=6.0' >&2; exit 1; }
	pkg-config --exists webkitgtk-$(WEBVIEW_WEBKITGTK_API) gtk4 || { echo 'ui_web needs libwebkitgtk-6.0-dev (scripts/provision_container.sh)' >&2; exit 1; }
endif

$(WEBVIEW2_SDK_DIR)/.sha256: ../scripts/fetch_webview2_sdk.sh
	bash $< $(WEBVIEW2_SDK_DIR)

# A command stamp makes knob/toolchain changes rebuild this library, while
# identical commands leave the artifact alone on repeated invocations.
$(UI_WEB_BUILD_DIR)/command: FORCE
	@mkdir -p $(dir $@)
	@printf '%s\n' '$(WEBVIEW_CXX) $(WEBVIEW_CXXFLAGS) $(WEBVIEW_LDFLAGS)' > $@.tmp
	@cmp -s $@.tmp $@ && rm $@.tmp || mv $@.tmp $@

$(UI_WEB_LIBRARY): $(WEBVIEW_SOURCE) $(UI_WEB_SRC) $(UI_WEB_HDRS) $(UI_WEB_TABLE) $(WEBVIEW_HEADERS) $(WEBVIEW_EXTRA) $(UI_WEB_LINK_PREREQ) $(UI_WEB_BUILD_DIR)/command | ui_web-deps
	mkdir -p $(dir $@)
	$(WEBVIEW_CXX) $(WEBVIEW_CXXFLAGS) -I$(UI_WEB_DIR) -I$(dir $(UI_WEB_TABLE)) $(WEBVIEW_SOURCE) $(UI_WEB_SRC) $(filter %.o,$(WEBVIEW_EXTRA)) -o $@ $(WEBVIEW_LDFLAGS)
ifdef HOSTED_DARWIN_TARGET
	# The flat copy of THIS arch, where the module path looks
	# ($(MODULE_LIBDIR)/ui_web.dylib); packaging installs it flat too.
	cp -f $@ $(MODULE_LIBDIR)/ui_web.dylib
endif
