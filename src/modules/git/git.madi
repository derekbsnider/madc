// The face of `git`, the madc module (include/madc_module.h): what a program
// that says `import git;` may call. A READ-ONLY view of a local repository
// through libgit2, linked into the module — a dependency of the IDE's nexus,
// never part of madc (owner ruling 2026-09-15). Declarations only: the
// module's C++ (git.cpp) defines them, and the build generates the module's
// declaration table from this file (madc --emit-module-table).
//
// Every answer is an object, or {error: <prose>}; open answers 0 for a path
// with no repository above it. Each answer is the out-parameter, returned.
//   head(out, h)                     {sha, branch, detached}
//   revparse(out, h, spec)           {sha}
//   log(out, h, path, limit)         {rows: [{sha, author, email, when, summary}]},
//                                    newest first; "" = no path filter;
//                                    limit <= 0 = 100
//   show(out, h, rev, path)          {text}: the blob's bytes at rev
//   blame(out, h, path, line, count) {rows: [{line, count, sha, author, when,
//                                    summary}]}; 1-based line; count 0 = to the end
//   dirty(out, h, path)              {dirty: bool}
//   blame_text(out, h, path, text, line, count)
//                                    blame the LIVE text against path's committed
//                                    history; an uncommitted hunk has sha ""
//   relpath(out, h, path)            {path} relative to the working tree, both
//                                    sides canonicalised
//   status(out, h)                   {rows: [{path, from, index, worktree}],
//                                    workdir}: git status's rows, their paths
//                                    relative to workdir; the states are
//                                    git::file_state codes (git_enums)
//   commit(out, h, rev)              {sha, author, email, when, summary}
//   diff(out, h, rev, path, text)    {patch, hunks: [{old_start, old_lines,
//                                    new_start, new_lines, header}]}: path at rev
//                                    against TEXT; equal = ""
//   command(out, argument)           {text} or {error}: `%git ARGUMENT`'s text, by
//                                    the module's own verbs (log, show, blame,
//                                    status, diff). A FILE, and with none the
//                                    current buffer, are read as the running
//                                    program's buffers answer them
//                                    (madc::host_documents: an editor's live
//                                    text), else from disk.
//   command_row(out)                 {name, usage, summary}: the session's %git
//                                    row — a host that offers %git itself
//                                    (madcide's REPL) registers it under the
//                                    module's words
//   relative_date(out, when, now)    {text}: a time as git's --date=relative
//                                    spells it, `now` the clock
// THREAD CONTRACT: a handle is used only from the thread that opened it.
#include "git_enums"	// git::file_state: a status row's codes

namespace git {
    int64_t open(const char *path);
    bool close(int64_t handle);
    var &head(var &out, int64_t handle);
    var &revparse(var &out, int64_t handle, const char *spec);
    var &log(var &out, int64_t handle, const char *path, int64_t limit);
    var &show(var &out, int64_t handle, const char *rev, const char *path);
    var &blame(var &out, int64_t handle, const char *path, int64_t line, int64_t count);
    var &dirty(var &out, int64_t handle, const char *path);
    var &blame_text(var &out, int64_t handle, const char *path, const char *text,
		    int64_t line, int64_t count);
    var &relpath(var &out, int64_t handle, const char *path);
    var &status(var &out, int64_t handle);
    var &commit(var &out, int64_t handle, const char *rev);
    var &diff(var &out, int64_t handle, const char *rev, const char *path,
	      const char *text);
    var &command(var &out, const char *argument);
    var &command_row(var &out);
    var &relative_date(var &out, int64_t when, int64_t now);
}
