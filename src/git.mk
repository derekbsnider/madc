# git.mk — the git MODULE (include/madc_module.h): madc's READ-ONLY view of a
# LOCAL git repository over libgit2. A program says `import git;`; madc finds
# the module by name in its module directory (lib/madc/modules/git.<dso>) and
# the module describes itself — its declarations, the session's %git command,
# a tool server's history tools. Nothing about it lives in the core. libgit2
# is a dependency of the IDE's nexus, never part of madc — no subtree, never
# linked into libmadc or any madc image; the engine's export surface carries
# no git_* symbol (scripts/check-c-abi-surface.sh).
#
# THE FACE: modules/git/git.madi; its declaration table is generated by madc
# (madc_modules.mk's madc_module_table_rules) and compiled into the module
# (git.cpp includes it).
#
# HOW libgit2 REACHES EACH TARGET (docs/plans/2026-09-15-madcgit-cross-targets-plan.md):
#   every target, Linux included — libgit2 is a BUILD REQUIREMENT statically
#     linked INTO the module: the minimal read-only static archive
#     scripts/stage_libgit2.sh builds for the target
#     ($(LIBGIT2_STAGE)/libgit2-<target>.a). Nothing named libgit2 ships, and
#     no package depends on a system libgit2. One exception, on the Linux/host
#     arm only: with no stage, a SYSTEM libgit2 at the floor builds the module
#     (Homebrew's formula depends on its own libgit2).
#   THE FLOOR (owner 2026-10-04): libgit2 1.8.7 or 1.9.7, or newer — the
#     releases carrying libgit2's security fixes. LIBGIT2_TAG below is the ONE
#     pin; the staged paths carry it, so a bump re-stages.
#     modules/git/libgit2_floor.h is the ONE statement of the floor: the
#     module refuses to compile below it, and the host arm preprocesses it to
#     judge a system libgit2. Ubuntu 24.04's system libgit2 is 1.7.2, below the
#     floor, which is why Linux links the staged archive too.
#
# The module binds libmadc's own symbols (madc::value, madc::error, the error
# composer, the path canonicalizer, the registration API its generated
# builders call) at LOAD, from the image that imported it. On ELF/Mach-O they
# stay UNDEFINED at link (bin/madc exports them; darwin uses -undefined
# dynamic_lookup). A Windows PE DLL cannot carry undefined symbols, so there
# the module links libmadc's import lib (../lib/libmadc.dll.a from
# ../bin/libmadc-0.dll); at runtime those imports bind to the loaded libmadc-0.dll.
#
# (GITMOD_, not GIT_: make reads the environment, and git's own GIT_DIR,
# GIT_WORK_TREE, ... must never reach this file.)
GITMOD_SRC = modules/git/git.cpp modules/git/git_verbs.cpp modules/git/git_history.cpp
GITMOD_FACE = modules/git/git.madi
GITMOD_FLOOR = modules/git/libgit2_floor.h
GITMOD_HDRS = modules/git/git_repo.h modules/git/git_enums modules/git/git_verbs.h $(GITMOD_FLOOR) $(INCDIR)/madc_module.h $(INCDIR)/handle_table.h $(INCDIR)/madc_module_commands.h $(INCDIR)/madc_module_tools.h $(INCDIR)/madc_tools.h $(INCDIR)/madc_session.h
GITMOD_BUILD_DIR = ../obj/git/$(MODE)
GITMOD_DEFAULT =
# Where scripts/stage_libgit2.sh stages the per-target minimal static libgit2
# and the pinned source's public headers (mirrors DARWIN_ZSTD_DIR), one
# directory per pinned tag.
LIBGIT2_DIR ?= /workspace/libgit2
LIBGIT2_TAG := v1.9.7
LIBGIT2_STAGE = $(LIBGIT2_DIR)/$(LIBGIT2_TAG)
LIBGIT2_INCLUDE = $(LIBGIT2_STAGE)/src/include
GITMOD_LINK_PREREQ =

ifeq ($(MODE),hosted-x86-64-windows)
# --- Windows bundle: lib/madc/modules/git.dll. Self-contained libgit2
# (bundled zlib in the archive); madc:: resolves through libmadc's import lib.
# ws2_32: libgit2 references winsock symbols even with the network backends
# off. Uses the SAME UCRT libstdc++/pthread runtime as madc (webview
# discipline) — never an MSVCRT libstdc++ copy.
GITMOD_LIBRARY = $(MODULE_LIBDIR)/git.dll
GITMOD_LIBGIT2 = $(LIBGIT2_STAGE)/libgit2-x86-64-windows.a
GITMOD_CFLAGS = -I$(LIBGIT2_INCLUDE)
# --export-all-symbols: the module's own symbols -- the git:: publics madc
# resolves by mangled name -- are its exports, as on ELF; the dllexport on
# madc_module_git alone would otherwise turn ld's auto-export off.
# --exclude-libs,ALL: the archives' globals (libgit2's whole API among them)
# stay out of the DLL's export table (gate: check-module-exports.sh).
GITMOD_LINK_FLAGS = -shared -static-libgcc -L$(WIN_UCRT_LIBSTDCXX)/lib -Wl,--export-all-symbols -Wl,--exclude-libs,ALL
GITMOD_LIBS = $(GITMOD_LIBGIT2) -L../lib -lmadc.dll -lws2_32 -lsecur32 -lpthread
GITMOD_LINK_PREREQ = ../bin/libmadc-0.dll
else ifdef HOSTED_DARWIN_TARGET
# --- macOS bundle: lib/madc/modules/<arch>-macos/git.dylib. libgit2 static
# (compiled against the SDK's zlib); -lz is resolved here (a system lib on
# every mac). madc:: stays undefined -> -undefined dynamic_lookup, bound at
# dlopen from madc (which exports its globals to dlsym without -rdynamic).
GITMOD_LIBRARY = $(MODULE_LIBDIR)/$(DARWIN_ARCH)-macos/git.dylib
GITMOD_LIBGIT2 = $(LIBGIT2_STAGE)/libgit2-$(DARWIN_ARCH)-macos.a
GITMOD_CFLAGS = -I$(LIBGIT2_INCLUDE)
GITMOD_LINK_FLAGS = $(DARWIN_LD_FLAGS) -dynamiclib -Wl,-install_name,@rpath/git.dylib -undefined dynamic_lookup
# -load_hidden: the archive's symbols load with hidden visibility, so the
# dylib never exports libgit2's API (a script's dlsym fallback would otherwise
# find them; gate: check-module-exports.sh).
GITMOD_LIBS = -Wl,-load_hidden,$(GITMOD_LIBGIT2) -lz
else
# --- Linux/host: the staged static libgit2 for this host
# (scripts/stage_libgit2.sh host), linked into git.so with the system zlib
# madc already depends on. With no stage, a system libgit2 (pkg-config) builds
# the module when the floor header preprocesses cleanly against its flags;
# GITMOD_LIBGIT2 stays empty then (no archive linked, no notice to ship: the
# system package carries its own). `all` builds the module where either is
# present; a release (package_release.sh) requires the stage.
GITMOD_STAGED = $(LIBGIT2_STAGE)/libgit2-$(STAGE_HOST_TARGET).a
ifneq ($(wildcard $(GITMOD_STAGED)),)
GITMOD_LIBGIT2 = $(GITMOD_STAGED)
GITMOD_AVAILABLE := 1
GITMOD_CFLAGS = -I$(LIBGIT2_INCLUDE)
GITMOD_LIBS = $(GITMOD_LIBGIT2) -lz -lpthread
else
GITMOD_LIBGIT2 =
GITMOD_CFLAGS := $(shell pkg-config --cflags libgit2 2>/dev/null)
GITMOD_AVAILABLE := $(shell pkg-config --exists libgit2 2>/dev/null && $(CXX) -E -x c++ $(GITMOD_CFLAGS) $(GITMOD_FLOOR) >/dev/null 2>&1 && echo 1)
GITMOD_LIBS := $(shell pkg-config --libs libgit2 2>/dev/null)
endif
GITMOD_LIBRARY = $(MODULE_LIBDIR)/git.so
# --exclude-libs,ALL: the static archive's git_* stay internal to the module.
# Modules load RTLD_GLOBAL (madc_dl_open_global), so an exported copy would
# enter the process's global scope beside any libgit2 a program loads itself
# (gate: check-module-exports.sh).
GITMOD_LINK_FLAGS = -shared -fPIC -Wl,-soname,git.so -Wl,--exclude-libs,ALL
ifeq ($(GITMOD_AVAILABLE),1)
GITMOD_DEFAULT = $(GITMOD_LIBRARY)
# The module's unit test: the module's objects + libgit2, not the engine's
# generic unit link (its fixture repository is built through libgit2's own
# write API — the oracle, never a second owner).
TESTBINS += $(BINDIR)/test_gitrepo
endif
endif

# The face's generated table: one file for every target (the builders name
# DataDefs, never sizes or symbols), generated by the build host's madc.
$(eval $(call madc_module_table_rules,git,$(GITMOD_FACE)))
GITMOD_TABLE = $(MODULE_TABLE_DIR)/git/git.inc

.PHONY: git git-deps git-windows git-macos git-arm64-macos git-x86-64-macos

git: $(GITMOD_LIBRARY)
ifeq ($(MODE),hosted-x86-64-windows)
git: ../bin/libstdc++-6.dll ../bin/libwinpthread-1.dll
endif

git-windows:
	$(MAKE) MODE=hosted-x86-64-windows git
git-macos: git-arm64-macos git-x86-64-macos
git-arm64-macos git-x86-64-macos:
	$(MAKE) MODE=hosted-$(patsubst git-%,%,$@) git

git-deps:
ifeq ($(MODE),hosted-x86-64-windows)
	@test -f $(GITMOD_LIBGIT2) || { echo 'git ($(MODE)) needs $(GITMOD_LIBGIT2) — scripts/stage_libgit2.sh x86-64-windows' >&2; exit 1; }
	@test -f $(WIN_UCRT_LIBSTDCXX)/lib/libstdc++.dll.a || { echo 'git win needs the UCRT stage: scripts/build_win_ucrt_libstdcxx.sh' >&2; exit 1; }
else ifdef HOSTED_DARWIN_TARGET
	@test -f $(GITMOD_LIBGIT2) || { echo 'git ($(MODE)) needs $(GITMOD_LIBGIT2) — scripts/stage_libgit2.sh $(DARWIN_ARCH)-macos' >&2; exit 1; }
else
	@test -n "$(GITMOD_AVAILABLE)" || { echo 'git needs libgit2 1.8.7, 1.9.7 or newer: $(GITMOD_STAGED) (scripts/stage_libgit2.sh host), or a system libgit2 at the floor' >&2; exit 1; }
endif

# A command stamp makes flag/toolchain changes rebuild the library, while
# identical commands leave the artifact alone (the ui_web.mk discipline).
$(GITMOD_BUILD_DIR)/command: FORCE
	@mkdir -p $(dir $@)
	@printf '%s\n' '$(CXX) $(GITMOD_LINK_FLAGS) $(CXXFLAGS) $(DEFINES) $(GITMOD_CFLAGS) $(GITMOD_LIBS)' > $@.tmp
	@cmp -s $@.tmp $@ && rm $@.tmp || mv $@.tmp $@

# -I. : the module lives one directory down and reads the engine's src-local
# headers (madc_datachannel_internal.h, madc_posix_io.h) like any engine file;
# the table's directory holds git.inc.
$(GITMOD_LIBRARY): $(GITMOD_SRC) $(GITMOD_HDRS) $(GITMOD_TABLE) $(GITMOD_LINK_PREREQ) $(GITMOD_BUILD_DIR)/command | git-deps
	mkdir -p $(dir $@)
	$(CXX) $(GITMOD_LINK_FLAGS) -o $@ $(CXXFLAGS) $(DEFINES) -I. -I$(dir $(GITMOD_TABLE)) $(GITMOD_CFLAGS) $(GITMOD_SRC) $(GITMOD_LIBS)
ifdef HOSTED_DARWIN_TARGET
	# The flat copy of THIS arch, where the module path looks
	# ($(MODULE_LIBDIR)/git.dylib); packaging installs it flat too.
	cp -f $@ $(MODULE_LIBDIR)/git.dylib
endif

$(BINDIR)/test_gitrepo: $(TESTDIR)/test_gitrepo.cpp $(GITMOD_SRC) $(GITMOD_HDRS) $(GITMOD_TABLE) $(DEPENDS) $(LIBMADC_STATIC) $(MIRLIB) | git-deps
	$(CXX) -o $@ $(CXXFLAGS) $(DEFINES) -I. -I$(dir $(GITMOD_TABLE)) $(GITMOD_CFLAGS) $< $(GITMOD_SRC) $(WHOLE_ARCHIVE_BEGIN) $(LIBMADC_STATIC) $(WHOLE_ARCHIVE_END) $(MIRLIB) $(GITMOD_LIBS) $(LIBS)
