prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@

Name: libmadc
Description: Mad-C embeddable JIT scripting engine
URL: https://github.com/derekbsnider/madc
Version: @PACKAGE_VERSION@
Cflags: -I${includedir}
Libs: -L${libdir} -lmadc
Libs.private: -ldl -lz -lm -lpthread @OPTIONAL_LIBS@
