// ---- driving the session as a client does ---------------------------------
// The event builders a client sends (text, key, action), the settle that
// lets the session's pump answer, and the REPL pane's input. Inline: every
// unit that includes this header keeps one copy.

inline void ev_text(var &e, const char *t)
{
    var f = { "event": "text", "event_code": ui::event_kind::text, "text": t };
    e = f;
}

inline void ev_key(var &e, const char *k)
{
    var f = { "event": "key", "event_code": ui::event_kind::key, "key": k,
	      "key_code": ui::key_code(k) };
    e = f;
}

inline void ev_action(var &e, const char *a, const char *seq)
{
    var f = { "event": "action", "event_code": ui::event_kind::action,
	      "action": a, "seq": seq };
    e = f;
}

// An action no key sequence posted (a menu row, a button, a test's command).
inline void ev_action(var &e, const char *a)
{
    ev_action(e, a, "");
}

// Let the pump run until nothing is outstanding (or `ms` passed): an offer
// answered, a completion answered — or, with `running`, until the offered
// entry has been taken and runs.
inline void settle(long w, long es, bool running)
{
    for ( long waited = 0; waited < 20000; waited = waited + 10 )
    {
	if ( running && es_int(w, es, "replrunning", 0) != 0 )
	    return;
	if ( !running && es_int(w, es, "replbusy", 0) == 0
	     && es_int(w, es, "replcseq", 0) == 0
	     && es_int(w, es, "replbseq", 0) == 0 )
	    return;
	madc::sleep_ms(10);
    }
    println("settle: timed out");
}

// Type a line into whatever has the keyboard, then press enter and settle.
inline void enter_line(IdeSession &S, long doc, long w, long es, const char *text)
{
    var e;
    if ( strlen(text) > 0 )
    {
	ev_text(e, text);
	S.apply_ide_event(doc, e);
    }
    ev_key(e, "enter");
    S.apply_ide_event(doc, e);
    settle(w, es, false);
}

// Has the REPL pane's input the keyboard (1 / 0)? A console's focus is its
// view's kind (consolefocus).
inline long repl_focused(long w, long es)
{
    return es_int(w, es, "consolefocus", 0) == repl_view(w) ? 1 : 0;
}

// The REPL input's caret: the field's own, kept on its document (-1 = no
// input yet).
inline long repl_field_caret(long w, long es)
{
    long rin = es_int(w, es, "replin", 0);
    return rin == 0 ? -1 : field_caret(w, rin);
}

