// vised — the visual (TUI) text editor (Track 7.2 R5, design doc §7).
// Usage: madc tools/texteditor/vised.mad <file> [ro] [--web]
// Run it from the repository root (the verb bodies load by relative
// path). The SAME document actions as lined: typing/backspace/del/enter
// edit at the caret; arrows/home/end/pgup/pgdn move it; ^B sets the
// mark, ^K cuts mark..caret, ^U pastes; ^F finds; ^S saves (the w verb),
// ^Q quits (the q verb — refused while modified), ^X discards (q!).
// Tab moves focus to the menu bar; arrows navigate it, enter chooses.
#include "lined_core.inc"
#include "editor_events.inc"
#include "vised_core.inc"

int main(int argc, char **argv)
{
    if ( argc < 2 )
    {
	printf("usage: vised <file> [ro] [--web]\n");
	return 1;
    }
    // The UI level is ONE flag (ui::level): --web shows the same tree in a
    // window through the web level (<ns_ui_web>, a lazy module row — a
    // machine without the library refuses at open with the reason); the
    // grid (ui::TUI) is the default. `ro` opens the file read-only.
    bool ro = false;
    ui::level lvl = ui::TUI;
    for ( int i = 2; i < argc; i++ )
    {
	if ( strcmp(argv[i], "--web") == 0 )
	    lvl = ui::WEB;
	else if ( strcmp(argv[i], "ro") == 0 )
	    ro = true;
    }
    run_visual(argv[1], ro, lvl);
    return 0;
}
