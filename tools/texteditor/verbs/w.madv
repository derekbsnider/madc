// lineed verb: w — write the document back to its own path (ui::doc_save:
// the file write and "the file on disk IS this" in one). The
// read-only rule is the shared availability check (checks/editable.madv).
// `doc` = the subject document, resolved by the prepended _subject.madv
var p;
ui::doc_path(p, w, doc);
if ( strlen(p.c_str()) == 0 )
    return "No path.";
if ( !ui::doc_save(w, doc) )
    return "Write failed.";
return format("Wrote {} bytes.", ui::text_size(w, doc));
