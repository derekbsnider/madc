// lineed verb: q — quit, refusing while the document has unsaved changes
// (§7.3's modified rule; q! is the discard path).
// `doc` = the subject document, resolved by the prepended _subject.madv
var m;
ui::get(m, w, doc, "modified");
if ( !m.is_null() && m.as_boolean() )
    return "Unsaved changes — w to save, q! to discard.";
ui::set(w, actor, "quit", true);
return "Bye.";
