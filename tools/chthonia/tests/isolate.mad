// Chthonia's code in a process of its own: with settings.json's
// "plugins.isolate", opening the chthonia bundle runs its code in a child
// (the host transport), and its Symbols view fills after F5 as it does when
// the code runs in the session's own process. The configuration directory
// is this test's (its .env).
#include <madcide/harness>

int main()
{
    var cfg;
    madcide_config_dir(cfg);
    php::mkdir(cfg.c_str());
    var stp = format("{}/settings.json", cfg);
    php::file_put_contents(stp.c_str(), "{\"plugins.isolate\": true}\n");
    const char *path = "tmp/isolate.c";
    php::file_put_contents(path, "int main() { return 0; }\n");
    IdeSession C;
    long doc = C.open(path, false, "chthonia");
    println("isolate-open: transport-host={}",
	    plugin_active_transport(C.w, "chthonia") == ptHOST ? 1 : 0);
    ui::text_load(C.w, doc, "#include <stdio.h>\n"
	"int count = 3;\n"
	"int square(int n) { return n * n; }\n"
	"int main() { printf(\"%d\\n\", square(5)); }\n");
    var e;
    ev_action(e, "replrun", "f5");
    C.apply_ide_event(doc, e);
    settle(C.w, C.es, false);
    var rows;
    for ( long waited = 0; waited < 20000; waited = waited + 10 )
    {
	ui::get(rows, C.w, C.es, "chthonia.symbols");
	if ( rows.is_array() && php::count(rows) > 0 )
	    break;
	madc::sleep_ms(10);
    }
    var shown = "";
    for ( var r : rows )
	shown = format("{}{}|", shown, r["content"]);
    println("isolate-rows: [{}]", shown);
    C.close();
    php::unlink(path);
    system(format("rm -rf {}", cfg));
    return 0;
}
