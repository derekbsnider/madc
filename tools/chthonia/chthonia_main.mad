// chthonia — the easy GUI to learn C and C++: a product built on madcide.
// Its program is two units (chthonia.json), the chthonia plugin's code and
// this one, which names the product and calls the base, linked with
// madcide's base, the library libmadcide.
//
// The descriptor is the whole difference from madcide: chthonia's name (its
// usage, its configuration directory), its bundle, a window by default
// (--tui gives the console), its plugin linked in, and what Help ▸ About
// says — Chthonia, its own version (chthonia_version.h, apart from madc's),
// the home page, the copyright holder and the MPL-2.0 summary.
//
// Thread contract: <madcide/product>'s — main hands the descriptor to the
// base, which records it before any session or thread starts.
#include <madcide/product>
#include "chthonia_version.h"

const ide_product chthonia_product = { "chthonia", "chthonia", ui::WEB,
				       "chthonia", madcide_plugin_activate,
				       "Chthonia", CHTHONIA_VERSION,
				       "https://github.com/derekbsnider/madc",
				       "Derek Snider", MADCIDE_MPL2_SUMMARY };

int main(int argc, char **argv)
{
    return madcide_main(argc, argv, chthonia_product);
}
