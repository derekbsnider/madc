// SMAUG.mad — top-level bootstrap for the madc port of SMAUG 1.8.
//
// Convention: this file names the application; running
//     bin/madc SMAUG.mad
// compiles and executes the whole project. Include the .mah headers
// and .mad source files in dependency order; the one containing
// int main() must be last.

// --- string hashing (leaf utility, no deps) ---------------------------
#include "hashstr.mad"

// TODO: add more files as we port them, then a main.mad at the bottom.

int main()
{
    // Placeholder — exercise a few hashstr entry points to confirm linkage.
    char *a = str_alloc("hello");
    char *b = str_alloc("hello");   // expect to share with a
    char *c = str_alloc("world");
    printf("a == b (same ptr)? %ld\n", a == b ? 1 : 0);
    printf("hash_stats:\n%s\n", hash_stats());
    str_free(a);
    str_free(b);
    str_free(c);
    return 0;
}
