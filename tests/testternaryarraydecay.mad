#include <stdio.h>
#include <string.h>

volatile int z = 0;
const char ca[2][3] = { "12" };
char vb[2][3] = { { '1', '2', '3' }, { '4', '5' } };

int main(void)
{
	const char *a = z ? "1" : ca[0];
	const char *b = z ? "1" : vb[0];
	printf("%d %d %c %c\n", strlen(a), strlen(b), a[1], b[3]);
	return 0;
}
