// Regression: the C++20 bit-field brace-or-equal default member initializer's
// BRACE form (`m : 1 {v}` — [class.mem]) was unconsumed by
// skip_bitfield_default_init (only `= v` was), so the member walk died at the
// '{'. Both forms are now skipped to the top-level ','/';' via the shared
// DelimDepth scanner (the lambda's hand-rolled depth counter migrated per
// delimiter-tracking.md). NOTE: madc does not APPLY bit-field initializers
// (both spellings share that documented policy); this gate checks parse +
// explicit assignment only. libc++ shape: __format/unicode.h:51.
// Oracle: g++ -std=c++20 and clang++ -std=c++20 accept; output "9 6 ok".
#include <cstdio>

struct F {
	unsigned a : 3 {2};
	unsigned b : 5 = 7, b2 : 2 {1};
	unsigned c : 8;
};

int main()
{
	F f;
	f.c = 9;
	f.b = 6;
	printf("%u %u ok\n", f.c, f.b);
	return 0;
}
