#!/../bin/madc

float fx(float x) { return 1.0 + 3.0 / (2.302585093 * x); }
float inita(void) { return 3.0; }
float initc(void) { return 4.0; }

int main(void)
{
  float fx(), inita(), initc(), a, b, c;
  a = inita();
  c = initc();
  b = fx(c) + a;
  printf("%.1f %.4f %.1f\n", a, b, c);
  return 0;
}
