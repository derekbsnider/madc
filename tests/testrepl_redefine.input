int f() { return 101; }
int g() { return f() * 10 + 3; }
int (*p)() = f;
println("first {} {} {} {}", f(), g(), p(), twice(4));
int f() { return 202; }
println("second {} {} {}", f(), g(), p());
int twice(int k) { return 3 * k; }
println("file {}", twice(4));
int f() { return 303; }
println("third {} {} {}", f(), g(), p());
inline int sq(int v) { return v * v; }
int use(int v) { return sq(v) + 1; }
println("inline {}", use(3));
inline int sq(int v) { return v * v * v; }
println("inline again {} {}", use(3), sq(2));
