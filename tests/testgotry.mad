// MT-2 opener: try/catch is TASK-LOCAL across yields. Two tasks each hold
// an open `try` across a yield(), then throw — pre-fix the global SJLJ
// chain's top belonged to the OTHER task (t1's throw landed in t2's
// jmp_buf); with per-context exception-state switching each task catches
// its own. FIFO determinism pins the complete schedule via the trace.
var tr;

void thrower(long id)
{
    try
    {
	tr = format("{}t{}try;", tr, id);
	yield();
	throw id * 10;
    }
    catch (long e)
    {
	tr = format("{}t{}c{};", tr, id, e);
    }
    tr = format("{}t{}end;", tr, id);
    println("end t{} tr={}", id, tr);
}

int main()
{
    go thrower(1);
    go thrower(2);
    tr = format("{}m1;", tr);
    return 0;
}
