#include <stdio.h>
#include <stdarg.h>

extern int __builtin_fputc(int, FILE *);
extern int __builtin_fputs(const char *, FILE *);
extern size_t __builtin_fwrite(const void *, size_t, size_t, FILE *);

void relay(char *fmt, ...)
{
	va_list ap;
	va_start(ap, fmt);
	vprintf(fmt, ap);
	va_end(ap);
}

int main(void)
{
	const char *const s1 = "hello";
	const char *const s2[] = { s1, 0 };

	relay("%s %c %d\n", *s2, **s2, 7);
	__builtin_printf("%s", "A");
	__builtin_putchar('B');
	__builtin_puts("");
	__builtin_fputc('C', stdout);
	__builtin_fputs("D\n", stdout);
	__builtin_fwrite("EF\n", 1, 3, stdout);
	return 0;
}
