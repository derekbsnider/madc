#!/../bin/madc
#include <iostream>
using namespace std;

int main()
{
    auto fn = [](string name) {
        cout << "Lambda says: " << name << endl;
    };
    fn("hello");

    auto add = [int](int a, int b) {
        return a + b;
    };
    int result;
    result = add(17, 25);
    cout << result << endl;

    return 0;
}
