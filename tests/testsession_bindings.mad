// A session's bindings over the backend (plan §41.11a step 3d):
// session_bindings asks for the names the session defined, and the reply's
// rows carry each one's name, kind (a madc::name_kind code), type (the
// source's spelling), value (an object's, the row form) and place (the entry
// that declared it). A pointer's row shows its address and follows nothing:
// `char *p = (char *)1;` neither reads memory nor ends the backend.

// The next reply, passing over running notices; the program's output
// printed before it is appended to `out`.
long next_reply(var &r, long h, var &out)
{
    var cases;
    cases[0] = madc::session_readable(h);
    for ( ;; )
    {
	long got = madc::session_poll(r, h);
	var o;
	madc::session_output(o, h);
	out = format("{}{}", out, o);
	if ( got != 0 && r["kind"] == madc::session_reply::running )
	    continue;
	if ( got != 0 )
	    return got;
	var fired;
	madc::chan_select(fired, cases);
    }
}

int main()
{
    long h = madc::session_open("c17");
    var r;
    var out = "";
    madc::session_offer(h, "int count = 3;", true);
    next_reply(r, h, out);
    madc::session_offer(h, "char *p = (char *)1;", true);
    next_reply(r, h, out);
    madc::session_offer(h, "int square(int x) { return x * x; }", true);
    next_reply(r, h, out);

    madc::session_bindings(h);
    next_reply(r, h, out);
    println("bindings: {}", r["kind"] == madc::session_reply::bindings);
    for ( var row : r["rows"] )
	println("{} object={} function={} type={} value={} at {}:{}",
		row["name"], row["kind"] == madc::name_kind::object,
		row["kind"] == madc::name_kind::function, row["type"],
		row["value"], row["file"], row["line"]);
    println("running: {}", madc::session_running(h));
    madc::session_close(h);
    return 0;
}
