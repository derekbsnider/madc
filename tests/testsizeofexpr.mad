// `sizeof(expr)` for postfix-chain expressions. The parser's sizeof
// handler previously only accepted `sizeof(TYPE)` or `sizeof(var)`,
// throwing "Expecting ')' after sizeof type" on subscript / member
// forms that real C code uses heavily (`sizeof(buf[0])` for
// array-stride compile-time constants, `sizeof(obj.field)` for
// struct members, `sizeof(p->field)` through pointers). Now routes
// any identifier followed by `[` / `.` / `->` through
// parsePostfixChain and takes the chain's result datadef's size.

#include <stdio.h>

struct node { int a; char b; double c; };

int main()
{
    char buf[100];
    printf("buf=%d\n", sizeof(buf));
    printf("buf0=%d\n", sizeof(buf[0]));
    printf("n=%d\n", sizeof(buf) / sizeof(buf[0]));

    int arr[5];
    printf("arr=%d\n", sizeof(arr));
    printf("arr0=%d\n", sizeof(arr[0]));

    struct node n;
    printf("na=%d nb=%d nc=%d\n",
	    sizeof(n.a), sizeof(n.b), sizeof(n.c));

    struct node *p = &n;
    printf("pa=%d pb=%d pc=%d\n",
	    sizeof(p->a), sizeof(p->b), sizeof(p->c));

    return 0;
}
