/* SysV varargs: an all-SSE small struct (float pair/triple) whose XMM
 * eightbytes no longer ALL fit demotes WHOLE to the overflow area, and the
 * fp counter stays for later args. MIR's va_block_arg case 2 had no
 * exhaustion check (cases 1/3/4 do), so the 9th SSE eightbyte here — the
 * fourth f3, after fmt + f2(1) + 3×f3(2) = 8 — read past the register save
 * area (c-testsuite 00204's two wrong "HFA float" lines). Oracle: gcc -O0
 * prints the same struct four times. */
#include <stdio.h>
#include <stdarg.h>
struct f2 { float a, b; };
struct f3 { float a, b, c; };
void p(char *fmt, ...)
{
    va_list ap;
    va_start(ap, fmt);
    struct f2 x2 = va_arg(ap, struct f2);
    printf("%.1f,%.1f ", x2.a, x2.b);
    for ( int i = 0; i < 4; i++ )
    {
        struct f3 x3 = va_arg(ap, struct f3);
        printf("%.1f,%.1f ", x3.a, x3.c);
    }
    printf("\n");
    va_end(ap);
}
int main()
{
    struct f2 a = { 12.1f, 12.2f };
    struct f3 b = { 13.1f, 13.2f, 13.3f };
    p("", a, b, b, b, b);
    return 0;
}
