chthonic-open: doc=1 bundle=chthonic keys=thonny
chthonic-views: repl=1 problems-tab=0 outline=0 project=0 terminal=0 sidebar=0
chthonic-menu: [File Edit Run View Tools Help] run=[replrun replstop repllang]
chthonic-repl: live=1 running=1
chthonic-toolbar: Open=editfile Save=save Run=replrun Stop=replstop codes=1
keystyle-list: tools=[keystyle] listed=true marked=true
keystyle-choose: keys=vscode msg=Keys: VS Code. kept=vscode
keystyle-reopen: keys=vscode
default-open: bundle=default repl-shown=0 live=0 replh=0
default-menu: [File Edit Search View Window Build Help]
default-toolbar: none
keystyle-default: keys=joe
