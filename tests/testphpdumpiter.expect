--- nested sequence value
Array
(
    [a] => Array
        (
            [0] => 1
            [1] => 2
        )
    [b] => Array
        (
            [0] => 3
        )
)
std::map<std::string,std::vector<int>>(2) {
  ["a"]=>
  std::vector<int>(2) {
    [0]=>
    int(1)
    [1]=>
    int(2)
  }
  ["b"]=>
  std::vector<int>(1) {
    [0]=>
    int(3)
  }
}
