extern "C" int printf(const char *, ...);

template<class T> struct Envelope {
	template<class U> struct Entry { U value; };
};
struct Result {
	using type = int;
	static const int value = 23;
};
Result produce();

int main()
{
	struct Envelope<int>::Entry<int> entry;
	struct Envelope<int>::template Entry<char> letter;
	entry.value = 41;
	letter.value = 7;
	printf("elaborated member: %d %d\n", entry.value, letter.value);
	decltype(produce())::value;
	decltype(produce())::type scalar = 29;
	decltype(produce()) result;
	printf("decltype scope: %d %d\n", decltype(produce())::value, scalar);
}
