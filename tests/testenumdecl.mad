// Regression: a trailing declarator on an enum DEFINITION (`enum [Tag] {...}
// e;`) was unparseable everywhere — TokenENUM::parse consumed an optional ';'
// after the body and left the declarator dangling ("Expecting type in class
// definition" / unknown identifier). The definition tail now re-feeds the
// just-defined enum as a bare type token so the caller parses `EnumType
// declarator...` — the same model as the forward-reference path and the class
// walk's nested-aggregate arm. libc++ shape: __format/unicode.h:51
// `enum : char32_t { __ok, __error } __status : 1 {__ok};` (anonymous
// fixed-base enum, bit-field declarator, braced init).
// Oracle: g++ -std=c++20 and clang++ -std=c++20 accept; output "2 1 3 ok".
#include <cstdio>

enum Color { red = 1, green = 2 } g_col;

struct S {
	enum E { ok = 0, err = 1 } st;
	enum : unsigned { A = 3 } an : 4 {A};
	unsigned pad : 4;
};

int main()
{
	g_col = green;
	S s;
	s.st = S::err;
	s.an = S::A;
	printf("%d %d %u ok\n", (int)g_col, (int)s.st, (unsigned)s.an);
	return 0;
}
