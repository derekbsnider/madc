#!../bin/madc
// A concrete-arg variadic class template used as a real OBJECT must really
// instantiate to a COMPLETE type (members + storage), not an opaque member-less
// shell. Before Wall A1, `h.count` failed with "Unidentified member in
// 'Holder_int'" because the variable's variadic-template type stayed opaque.
#include <iostream>
using namespace std;

template<typename... Ts>
struct Holder {
    int count;
    int first;
};

// Forward-declared variadic template: the forward decl registers BOTH a
// datatype_map placeholder and a template_map entry, so `Bag<int> b;` must
// still resolve as a template-id (not hand the bare `Bag` to the declarator).
template<typename... Ts> struct Bag;
template<typename... Ts> struct Bag { int n; int v; };

int main()
{
    Holder<int> h;
    h.count = 3;
    h.first = 42;
    cout << "count: " << h.count << endl;
    cout << "first: " << h.first << endl;

    Bag<int> b;
    b.n = 2;
    b.v = 7;
    cout << "bag n: " << b.n << endl;
    cout << "bag v: " << b.v << endl;
    return 0;
}
