#!/usr/bin/env madc
#include <iostream>
using namespace std;

int divide(int a, int b)
{
	int q = a / b;
	int r = a - (q * b);
	return q, r;
}

int minmax(int a, int b)
{
	if (a < b)
	{
		return a, b;
	}
	return b, a;
}

int main()
{
	q, r := divide(17, 5);
	cout << q << endl;
	cout << r << endl;

	lo, hi := minmax(42, 7);
	cout << lo << endl;
	cout << hi << endl;

	return 0;
}
