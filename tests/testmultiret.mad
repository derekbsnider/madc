#!/usr/bin/env madc
// Test multiple return values

int divide(int a, int b)
{
	int q = a / b;
	int r = a - (q * b);
	return q, r;
}

int main()
{
	q, r := divide(17, 5);
	cout << q << endl;
	cout << r << endl;

	// second call
	a, b := divide(100, 7);
	cout << a << endl;
	cout << b << endl;

	return 0;
}
