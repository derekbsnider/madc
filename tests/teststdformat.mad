// std::format returns ring-lifetime const char* (the c_str() contract;
// the <string> closure stays out of dialect TUs). These shapes pin the
// C++-interop consumption: declaration-init of a real std::string from
// the ring text, and expression operand of cout <<.
std::string t = std::format("n={:#06X}", 255);
cout << t << endl;
cout << std::format("inline {}", 99) << endl;
std::string u = std::format("{}|{:>8}|{:.2f}", 1, "hi", 2.5);
cout << u << endl;
