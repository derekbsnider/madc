// The empty '[]' append accessor is a CARRIER operation: a non-carrier
// receiver refuses loudly (C has no postfix `x[]`, so nothing legal is
// shadowed — the old failure was a bare "Missing operand" pointing at
// the ']').
// Oracle: gcc `arr[] = 5;` -> "expected expression before ']' token".
int main()
{
	int arr[4];
	arr[] = 5;
	return 0;
}
