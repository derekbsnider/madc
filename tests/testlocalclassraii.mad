// Local RAII class inside a member template — the reduced shape of
// std::basic_string::_M_construct's `_Guard` (a scope-exit guard: ctor arms,
// dtor disposes unless disarmed). The parse-once path materializes the concrete
// local class and remaps the pattern ctor/dtor calls to its stable identity.
// See docs/plans/2026-07-01-tsubst-step2-local-class-HANDOFF.md.
#include <iostream>
using namespace std;

template<class T>
struct Box {
	T val;
	void reset() { val = T(); }
	template<class U>
	void build(U x) {
		// _Guard analogue: arms on construction, disposes (reset) on
		// scope exit UNLESS disarmed by clearing its pointer first.
		struct Guard {
			Box* b;
			Guard(Box* p) : b(p) {}
			~Guard() { if (b) b->reset(); }
		} g(this);
		this->val = x;
		g.b = 0;			// disarm: dtor becomes a no-op
	}
};

int main() {
	Box<int> bx;
	bx.build(42);
	cout << bx.val << endl;		// 42 (guard disarmed → not reset)
	return 0;
}
