// std::is_destructible / is_trivially_destructible through the real headers
// ([meta.unary.prop]): scalars and classes with an accessible non-deleted
// destructor are destructible; deleted (`= delete`) and private destructors
// are not, nor is a class HOLDING a deleted-destructor member (the implicit
// destructor is deleted, [class.dtor]p7); void is not. (An ARRAY type as a
// template argument -- is_destructible<int[3]> -- is a separate madc
// template-argument-grammar gap, filed; probe omitted here.) Trivial destructibility additionally requires no
// user destructor in the subobject tree. The libc++ twin
// (testdestructible_libcxx) drives the same battery through madc's
// __is_destructible builtin via libc++'s `#if __has_builtin` path; this
// default-flavor leg goes through libstdc++'s SFINAE/declval chain.
// Oracle: g++ 13 == clang++-18 (-stdlib=libc++) print "1 1 1 0 0 0 0\n1 0".
#include <type_traits>
#include <cstdio>
struct triv { int x; };
struct userd { int x; ~userd() {} };
struct deld { int x; ~deld() = delete; };
struct privd { int x; private: ~privd() {} };
struct holds_deld { deld d; };
int main()
{
    printf("%d %d %d %d %d %d %d\n",
	   (int)std::is_destructible<int>::value,
	   (int)std::is_destructible<triv>::value,
	   (int)std::is_destructible<userd>::value,
	   (int)std::is_destructible<deld>::value,
	   (int)std::is_destructible<privd>::value,
	   (int)std::is_destructible<holds_deld>::value,
	   (int)std::is_destructible<void>::value);
    printf("%d %d\n",
	   (int)std::is_trivially_destructible<triv>::value,
	   (int)std::is_trivially_destructible<userd>::value);
    return 0;
}
