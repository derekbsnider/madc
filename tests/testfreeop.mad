// Free (non-member) operator functions dispatch by overload resolution:
// a parsed global operator with a body is found and called for class
// operands (the family hoisted hidden friends ride). `a == 0` exercises
// the null-pointer-constant rule: literal 0 binds the const int* overload
// (standard conversion) over operator==(A,A) via the A(int) ctor (udc).
#include <cstdio>
class A {
public:
	int v;
	A(int x) : v(x) {}
};
bool operator<(A a, int b) { return a.v < b; }
bool operator==(A a, A b) { return a.v == b.v; }
bool operator==(A a, const int *p) { return p == 0; }
int main()
{
	A a(-1);
	A b(-1);
	if (a < 0)
		printf("less\n");
	if (a == b)
		printf("eq\n");
	if (a == 0)
		printf("nullptr-const\n");
	return 0;
}
