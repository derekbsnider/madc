#!../bin/madc
#include <iostream>
#include <sstream>
using namespace std;

int gimmie5()
{
    return 5;
}

int main()
{
    stringstream ss;
    string hello = "Hello, World!";
    string bye = "Goodbye, cruel World!";
    uint32_t i = 456;
    uint32_t j;

    puti(i);
    puti(123);

    j = gimmie5();
    puti(j);

    ss << hello << " ... " << bye;
    ss << " i: " << i;
    ss << " 123: " << 123;
    // Standard idiom to print the accumulated buffer (the old `printstream(ss)`
    // convenience builtin was tied to the retired hardcoded dtSSTREAM stream tag).
    cout << ss.str() << endl;

    cout << "This is a test to cout: " << gimmie5() << endl;
//    endl(cout);
//    printstr("...");

    return 0;
}
