extern char *strcpy(char *, const char *);
extern int __builtin_setjmp(void *);
extern void __builtin_longjmp(void *, int);

void *buf[20];
char *gp;  // global — survives longjmp (asmjit may put locals in caller-saved regs)

void jump_back(void)
{
	__builtin_longjmp(buf, 1);
}

int main(void)
{
	gp = (char *)__builtin_alloca(20);
	strcpy(gp, "test");

	if (__builtin_setjmp(buf))
	{
		printf("%s\n", gp);
		return 0;
	}

	jump_back();
	return 1;
}
