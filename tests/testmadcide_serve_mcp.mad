// V6c-1, split arc 1D: the MCP seat. `madcide <file> --mcp` is a headless
// Model Context Protocol server over stdio (JSON-RPC 2.0, one message per
// line) served by the session's tool host: madc's tools (the code graph, the
// project memory's) and madcide's registry commands as tools — a command
// tool is an adapter over api_run, the SAME command core the --serve api
// seat drives. This test IS run_mcp: the JSON-RPC requests arrive on stdin
// (the .input fixture), the responses go to stdout (matched by .expect),
// exactly as a real MCP client drives the deployed `--mcp` process. It
// exercises initialize (madc's server), a notification (no reply),
// tools/list (the registry as tools), tools/call on a real command
// (isError:false, the session's projections) and an unknown tool (the
// JSON-RPC invalid-params error naming it).
#include "../tools/texteditor/editor_events.inc"
#include "../tools/madcide/madcide_core.inc"
#include "../tools/madcide/madcide_client.inc"
#include "../tools/madcide/madcide_api.inc"
#include "../tools/madcide/madcide_seat.inc"
#include "../tools/madcide/madcide_ws.inc"
#include "../tools/madcide/madcide_serve.inc"

int main()
{
    const char *path = "madc_ide_mcp.mad";
    // A deliberate arity error so `check` yields a structured diagnostic, plus
    // `add` for the structured outline — the lean API result (not the tree).
    php::file_put_contents(path,
	"long add(long a, long b) { return a + b; }\nint main() { return add(1); }\n");

    // The MCP server over stdin/stdout — the deployed `--mcp` path end to end.
    // stdin is the .input JSON-RPC stream; stdout is the JSON-RPC responses.
    long rc = run_mcp(path, false);

    php::unlink(path);
    return rc;
}
