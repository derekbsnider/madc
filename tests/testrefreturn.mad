#!/../bin/madc
// Reference return types (T& method() / T& operator[]). A reference is a
// strict pointer known to point at something: the method returns the address,
// the call site reads through it (*p) or stores through it (*p = rhs) — exactly
// what g++ emits. Works on plain classes and template instantiations alike.
#include <iostream>
#include <stdlib.h>
using namespace std;

// Named reference-returning method, used as both lvalue and rvalue.
class Arr {
    int* data;
public:
    Arr() { data = (int*)malloc(4 * sizeof(int)); }
    ~Arr() { free(data); }
    int& at(long i) { return data[i]; }
};

// Templated container with a reference-returning operator[] — the canonical
// container element accessor that containers (vector etc.) will build on.
template<typename T> class Vec {
    T* data;
    long len;
    long cap;
public:
    Vec() { data = (T*)malloc(4 * sizeof(T)); len = 0; cap = 4; }
    ~Vec() { free(data); }
    void push(T v) {
        if (len >= cap) { cap = cap * 2; data = (T*)realloc(data, cap * sizeof(T)); }
        data[len] = v;
        len = len + 1;
    }
    T& operator[](long i) { return data[i]; }
    long size() { return len; }
};

int main()
{
    Arr a;
    a.at(0) = 11;
    a.at(1) = 22;
    a.at(0) = a.at(0) + a.at(1);
    printf("arr: %d %d\n", a.at(0), a.at(1));

    Vec<int> v;
    v.push(10);
    v.push(20);
    v[1] = 99;
    printf("vec: size=%ld [0]=%d [1]=%d\n", v.size(), v[0], v[1]);
    return 0;
}
