/* A C enum is compatible with its underlying integer type (C11 6.7.2.2p4),
   and gcc's (and clang's) choice is unsigned int when no enumerator is
   negative, int when one is, and the 64-bit twin past 32 bits. It has that
   type's rank, so its arithmetic is that type's. madc lowered every such
   enum as a signed int, so `(enum U)-1 > 0` was false, `u - 2 > 0` was
   false, and `(enum U)-2 / 2` divided signed: silent wrong answers.
   Oracle: gcc and clang -std=c17 print "unsigned 1 1 1 1 1 1",
   "signed 1 1", "widen 4294967295 18446744073709551615" and
   "ops 2147483647 1 4". */
#include <stdio.h>

enum U { UA = 1 };
enum S { SA = -1 };
enum M { MA = 0xFFFFFFFFu };
enum Big { BA = 0x100000000LL };
enum NBig { NA = -0x100000000LL };
typedef enum { TA = 1 } T;

int byparam(enum U u) { return u - 2 > 0; }

int main(void)
{
    enum U u = UA;
    enum { AA = 1 } a = AA;
    T t = TA;
    enum M m = MA;
    unsigned long long w = (enum U)-1;
    printf("unsigned %d %d %d %d %d %d\n", (enum U)-1 > 0, u - 2 > 0, a - 2 > 0,
	   t - 2 > 0, byparam(UA), m > 0);
    printf("signed %d %d\n", (enum S)-1 < 0, (enum NBig)-1 < 0);
    printf("widen %llu %llu\n", w, (unsigned long long)(enum Big)-1);
    printf("ops %u %u %d\n", (enum U)-2 / 2, (enum U)-1 >> 31,
	   (int)sizeof((enum U)-1));
    return 0;
}
