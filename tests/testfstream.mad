#!/../bin/madc

int main()
{
    // write a file
    ofstream outf;
    string fname = "/tmp/madc_test.txt";
    outf.open(fname);
    outf << "Hello from madc!" << endl;
    outf << "Line 2" << endl;
    outf << "Line 3" << endl;
    outf.close();
    cout << "wrote file" << endl;

    // read it back line by line
    ifstream inf;
    string line;
    inf.open(fname);

    getline(inf, line);
    cout << "1: " << line << endl;
    getline(inf, line);
    cout << "2: " << line << endl;
    getline(inf, line);
    cout << "3: " << line << endl;

    inf.close();

    // type conversions
    string s;
    to_string(s, 42);
    cout << "to_string: " << s << endl;

    string num = "12345";
    int n;
    n = stoi(num);
    cout << "stoi: " << n << endl;

    n = strlen(num);
    cout << "strlen: " << n << endl;

    // cleanup
    string rm = "rm -f /tmp/madc_test.txt";
    system(rm);

    return 0;
}
