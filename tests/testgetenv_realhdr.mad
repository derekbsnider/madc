// Gap{builtin_redecl_half_adopt}: real <stdlib.h> re-declares getenv/setenv,
// which madc pre-registers as builtins with wrapper conventions (getenv's
// 2-param result-buffer __madc_getenv). gcc canon: an explicit prototype
// replaces a builtin — the header's 1-param getenv must win WHOLESALE and the
// call must bind the real libc symbol (not the wrapper). The setenv→getenv
// round-trip proves the calls really hit libc.
// Oracle: gcc/g++ compile and print "1" then "roundtrip".
#include <stdlib.h>
#include <stdio.h>

int main()
{
	// PATH, not HOME: HOME is not set on Windows (USERPROFILE is), and this
	// probe is about getenv's SHAPE — the real 1-param prototype replacing
	// madc's 2-param wrapper builtin — not about which variables a host
	// happens to define. PATH is set on Linux, macOS and Windows alike, so
	// the assertion is the same everywhere and nothing about the Linux
	// coverage changes.
	char *p = getenv("PATH");
	printf("%d\n", p != 0);
	setenv("MADC_GETENV_TEST", "roundtrip", 1);
	printf("%s\n", getenv("MADC_GETENV_TEST"));
	return 0;
}
