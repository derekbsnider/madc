// Classic C function-pointer cast syntax: `(RET (*)(PARAMS)) expr`.
// Used by qsort(), bsearch(), atexit()-style libc APIs. SMAUG's
// sort_exits() relies on this to pass a typed comparator through
// qsort's `int (*)(const void *, const void *)` argument slot.

#include <stdio.h>
#include <stdlib.h>

int mycmp(const void *a, const void *b)
{
    int ia = *((int *)a);
    int ib = *((int *)b);
    if (ia < ib) return -1;
    if (ia > ib) return 1;
    return 0;
}

int main()
{
    int arr[5] = {3, 1, 4, 1, 5};
    qsort(arr, 5, sizeof(int),
          (int (*)(const void *, const void *)) mycmp);
    int i;
    for (i = 0; i < 5; i++) printf("%d\n", arr[i]);
    return 0;
}
