// fix-what-you-find (2026-09-07, found measuring the web editor): the ONE
// text-mutation owner's span shifter (shift_anchors, editor_events.inc)
// rebuilt every row from a field list of its own — a second copy of the
// row shape — and so DROPPED a field the converter (spans_to_hspans) had
// gained; the web renderer read that field, so every keystroke killed its
// syntax colour until the next reparse while the TUI never saw it. The
// contract pinned here: an edit moves a row's GEOMETRY (s/e) and leaves
// every other field the converter stamped intact — today the scheme's
// style spec `c` (the colour-unification slice, 2026-09-08: the one fact
// both renderers read). Oracle: the converter's row shape
// (tests/testidespans.mad) — a shifted row equals the unshifted row with
// s/e moved by the inserted length.
#include "../tools/texteditor/lined_core.inc"
#include "../tools/texteditor/editor_events.inc"
#include "../tools/madcide/madcide_core.inc"

int main()
{
    const char *path = "madc_ide_spanshift.mad";
    php::file_put_contents(path, "long id(long x) { return x; }\n");
    long w = ui::world_new();
    long doc = setup_editor(w, path, false);
    long es = ui::entity_by_name(w, "editor-state");
    ui::set(w, es, "profile_dir", "tools/madcide/profiles");
    load_theme(w, es, "default");
    long h = ensure_phandle(w, es, doc);
    refresh_spans(w, es, doc, h);
    var before;
    ui::get(before, w, es, "hspans");

    // The anchor registry (V3a) shifts the selection markers too, not just
    // the spans: a marker set before a keystroke follows the text (it went
    // stale before). mark inside the doc, bend later, and an unset (-1)
    // marker that must pass through untouched.
    ui::set(w, es, "mark", 10);
    ui::set(w, es, "bend", 20);

    // An insert at the top of the document shifts every span by its
    // length; nothing else about a row may change.
    ed_text_insert(w, es, doc, 0, "//x\n");
    var after;
    ui::get(after, w, es, "hspans");
    println("rows before={} after={}", php::count(before), php::count(after));
    long kept = 0;
    long shifted = 0;
    long i = 0;
    for ( var r : after )
    {
	var b = before[i];
	var rc = r["c"];
	var bc = b["c"];
	if ( !rc.is_null() && !bc.is_null() && strcmp(rc.c_str(), bc.c_str()) == 0 )
	    kept++;
	if ( r["s"].as_integer() == b["s"].as_integer() + 4
	  && r["e"].as_integer() == b["e"].as_integer() + 4 )
	    shifted++;
	println("span c={} s={} e={}", rc.is_null() ? "-" : rc.c_str(), r["s"], r["e"]);
	i++;
    }
    println("all c kept: {}", kept == php::count(after) ? "yes" : "no");
    println("all shifted: {}", shifted == php::count(after) ? "yes" : "no");

    // The markers followed the +4 insert (10->14, 20->24).
    println("mark={} bend={}", es_int(w, es, "mark", -1), es_int(w, es, "bend", -1));
    // An erase of the same 4 bytes at the top brings them back (both are
    // past the erased range); an unset marker stays unset.
    ui::set(w, es, "sel_unset", -1);
    ed_text_erase(w, es, doc, 0, 4);
    shift_es_offset(w, es, "sel_unset", 0, -4);
    println("after-erase mark={} bend={} unset={}",
	    es_int(w, es, "mark", -1), es_int(w, es, "bend", -1),
	    es_int(w, es, "sel_unset", 0));
    return 0;
}
