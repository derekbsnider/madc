#!/../bin/madc
// Compound-assign on a TokenDerefExpr LHS — `*(expr) op= rhs;` where
// `expr` is a pointer-yielding subexpression (cast, pointer
// arithmetic, etc.). TokenDerefExpr reports type() == ttMember but
// isn't a TokenMember or TokenDeref, so resolveCompoundLHS used to
// throw "compound assignment <op> on unsupported member type".
//
// SMAUG `reset.c` and similar bit-flag macros expand to
// `*((int *)p) |= flag` patterns.

#include <stdio.h>

int main()
{
    int arr[4];
    arr[0] = 0xFF;
    arr[1] = 0;
    arr[2] = 0;
    arr[3] = 0;
    int *p = arr;

    // *(p+0) |= ... — the (p+0) subexpression yields a TokenDerefExpr.
    *(p+0) &= 0x0F;
    *(p+1) |= 0xAA;
    *(p+2) ^= 0x55;
    *(p+3) += 7;

    printf("%x %x %x %d\n", arr[0], arr[1], arr[2], arr[3]);

    return 0;
}
