// Multi-return loud-reject gate: every return statement in a multi-return
// function must supply all the values — a bare `return;` would leave
// transport slots indeterminate (a silent wrong answer).
int pair2(int a)
{
	if (a > 0)
		return a, a + 1;
	return;
}

int main()
{
	x, y := pair2(1);
	return 0;
}
