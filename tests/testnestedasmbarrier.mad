int foo(void)
{
    unsigned int x = 0;

    void nested(void)
    {
	x = 254;
    }

    nested();
    asm volatile("" :: "r" (x));
    asm volatile("" :: "m" (x));
    asm volatile("" :: "mr" (x));
    asm volatile("" : "=r" (x) : "0" (x));
    asm volatile("" : "=m" (x) : "m" (x));
    return x;
}

int bar(void)
{
    unsigned int x = 0;

    void nested(void)
    {
	asm volatile("" :: "r" (x));
	asm volatile("" :: "m" (x));
	asm volatile("" :: "mr" (x));
	x += 4;
	asm volatile("" : "=r" (x) : "0" (x));
	asm volatile("" : "=m" (x) : "m" (x));
    }

    nested();
    return x;
}

int baz(void)
{
    unsigned int x = 0;

    void nested(void)
    {
	void nested2(void)
	{
	    asm volatile("" :: "r" (x));
	    asm volatile("" :: "m" (x));
	    asm volatile("" :: "mr" (x));
	    x += 4;
	    asm volatile("" : "=r" (x) : "0" (x));
	    asm volatile("" : "=m" (x) : "m" (x));
	}

	nested2();
	nested2();
    }

    nested();
    return x;
}

int main(void)
{
    printf("%u %u %u\n", foo(), bar(), baz());
    return 0;
}
