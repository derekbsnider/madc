#!../bin/madc
// std::transform with a FUNCTION argument. Exercises [temp.deduct.call]
// function-to-pointer argument decay in namespace-fn-template deduction: the
// unary-operation type parameter deduces from the function `dbl`, which must
// DECAY to a pointer-to-function. Without the decay it bound to the bare
// FuncDef and emitted an incomplete, non-callable `void __op` parameter
// ("incomplete parameter type in function definition").
//
// Iterators are passed as pointers (`a+0`, `b+0`); a BARE C-array argument
// (`transform(a, a+4, b, dbl)`) still hits a separate call-site overload-
// binding gap, tracked for a later slice.
#include <iostream>
#include <algorithm>
using namespace std;

int dbl(int x) { return x * 2; }

int main()
{
    int a[4] = {1, 2, 3, 4};
    int b[4] = {0, 0, 0, 0};
    transform(a + 0, a + 4, b + 0, dbl);   // function op decays to a fn pointer
    for (int i = 0; i < 4; i++)
        cout << b[i] << " ";
    cout << endl;                           // 2 4 6 8
    return 0;
}
