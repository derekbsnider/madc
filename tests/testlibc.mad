#include <iostream>
using namespace std;
// Test libc dlsym fallback — functions available without #include or #load

int main()
{
#ifndef _WIN32
    // getpid() — always returns a positive int
    int pid;
    pid = getpid();
    if ( pid > 0 )
        cout << "pid ok" << endl;   // pid ok
#endif

    // The Win64 arm uses a nonzero duration so the runtime conversion and
    // finite-timeout path execute; POSIX hosts keep this fast fallback probe.
    int r;
#ifdef _WIN32
    r = sleep(1);
#else
    r = sleep(0);
#endif
    cout << r << endl;              // 0

    // Process and user identity are outside this Win64 POSIX slice. Keep
    // exercising their bare-name fallback on POSIX hosts; the Win64 arm of
    // this test owns only the lowercase sleep resolution settled by D3.
#ifndef _WIN32
    // getuid — returns current user id
    int uid;
    uid = getuid();
    if ( uid >= 0 )
        cout << "uid ok" << endl;   // uid ok

    // getppid — parent process id
    int ppid;
    ppid = getppid();
    if ( ppid > 0 )
        cout << "ppid ok" << endl;  // ppid ok
#endif

    return 0;
}
