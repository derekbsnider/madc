#include <stdio.h>
#include <stdlib.h>

struct node {
    int value;
    struct node *next;
};

struct node *table[8];

struct node *get_slot(int i)
{
    return table[i];
}

int main()
{
    struct node *a = (struct node *) malloc(sizeof(struct node));
    struct node *b = (struct node *) malloc(sizeof(struct node));
    a->value = 7;
    a->next = b;
    b->value = 11;
    b->next = NULL;
    table[3] = a;

    struct node *p = table[3];
    printf("p=%d\n", p->value);
    printf("direct=%d\n", table[3]->value);
    printf("next=%d\n", table[3]->next->value);
    printf("call=%d\n", get_slot(3)->value);

    free(a);
    free(b);
    return 0;
}
