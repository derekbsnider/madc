// A braced linkage specification sets language linkage; it does not apply the
// `extern` storage class to each directly-contained declaration.  Therefore
// the two namespace-scope objects below are definitions, and the locals in
// the enclosed function definitions are ordinary automatic variables.
#include <cstdio>

extern "C++" {
int cpp_linkage_object;

int addup(int a, int b)
{
	int t = a;
	t = t + b;
	return t;
}
}

extern "C" {
int c_linkage_object;

int cadd(int a, int b)
{
	int u = a + b;
	return u;
}
}

int main()
{
	cpp_linkage_object = 13;
	c_linkage_object = 17;
	printf("%d %d %d %d\n", addup(3, 4), cadd(5, 6),
		cpp_linkage_object, c_linkage_object);
	return 0;
}
