// Slice V2 — no explicit includes: `string` and `madc` auto-include
// <string> before <ns_madc>, so its gated std::string overloads are present.
// Exercise the convenience directly without depending on a platform's
// external command set (Wine does not ship a POSIX `sort`).
int main()
{
    string result;
    madc::eval_expression_string(result, "\"apple\"");
    printf("evaluated: %s\n", result.c_str());
    printf("done\n");
    return 0;
}
