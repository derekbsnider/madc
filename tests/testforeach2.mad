#!/../bin/madc
#include <iostream>
#include <string>
#include <vector>
#include <algorithm>
using namespace std;
void print_name(string name)
{
    cout << "Name: " << name << endl;
}

int main()
{
    vector<string> names;
    names.push_back("Alice");
    names.push_back("Bob");
    names.push_back("Charlie");

    // std::for_each (3-arg iterator form) with a named function pointer
    auto fn = print_name;
    std::for_each(names.begin(), names.end(), fn);

    // std::for_each with a lambda
    std::for_each(names.begin(), names.end(), [](string name) {
        cout << "Hi " << name << endl;
    });

    return 0;
}
