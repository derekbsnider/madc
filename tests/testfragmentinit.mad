// The ws UI host is libmadc's own (src/ui_ws.cpp): the engine holds target
// "ws" from the start, by name, with no initializer in the program. A second
// host claiming "ws" is refused, and the same host (its identity,
// "ns_ui_ws") claiming it again is accepted. Until the dialect became
// builtin, the host claimed the name in <ns_ui_ws>'s file-scope initializers
// (a static table and a static flag set by ui::register_host), and the
// packed madc once bound the flag without its initializer: "ws" was never
// registered, ui::open("ws") said "unknown target 'ws'", and every GUI test
// failed.
// Oracle: g++ 13 and clang++ 18 over the C++ analogue (a registry holding a
// named table, a main that claims the name with another table and then with
// the same identity) print "refused" then "accepted", as madc does.
ui::ui_host_ops other_host;
ui::ui_host_ops same_host;

int main()
{
	ui_ws::attach(0);
	other_host.open = ui_ws::open;
	other_host.run = ui_ws::run;
	other_host.identity = "other";
	same_host.open = ui_ws::open;
	same_host.run = ui_ws::run;
	same_host.identity = "ns_ui_ws";
	bool other = ui::register_host("ws", ui::WEB, &other_host);
	println("another host claims ws: {}", other ? "accepted" : "refused");
	bool same = ui::register_host("ws", ui::WEB, &same_host);
	println("ns_ui_ws claims ws again: {}", same ? "accepted" : "refused");
	return 0;
}
