// Regression: __is_trivially_copyable was not in madc's trait-builtin
// registry, so libc++'s `static_assert(is_trivially_copyable_v<
// __parsed_specifications<char>>)` (parser_std_format_spec.h:324) died
// "Expecting integer constant expression". [class.prop]/1 evaluator with the
// same documented conservatism as trait_is_trivial (any user-declared ctor
// -> false: a false negative fails LOUDLY or disables an optimization, never
// miscompiles). Registry membership also answers __has_builtin.
// NOTE the libstdc++ `std::is_trivial_v<T>` VARIABLE-TEMPLATE spelling has a
// separate, pre-existing fold gap (tmp/r49d) — this gate uses the builtin
// and class forms, which fold in both flavors.
// Oracle: g++ -std=c++20 and clang++ -std=c++20 accept; output "1 1 0 ok".
#include <cstdio>

struct plain { int v; };
template <class T> struct box { T v; };
struct virt { virtual ~virt() {} int v; };

static_assert(__is_trivially_copyable(plain), "p");
static_assert(__is_trivially_copyable(box<char>), "b");
static_assert(!__is_trivially_copyable(virt), "nv");

int main()
{
	printf("%d %d %d ok\n", (int)__is_trivially_copyable(plain),
	       (int)__is_trivially_copyable(box<char>),
	       (int)__is_trivially_copyable(virt));
	return 0;
}
