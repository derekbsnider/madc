#!/../bin/madc
// INVARIANT TEST for the "std::string as a real class" refactor
// (docs/superpowers/plans/2026-05-31-stdtypes-as-real-classes.md). This pins the
// std::string behaviour that already works today, so it stays correct while the
// implementation is migrated from the legacy dtSTRING special-casing to the C++
// class model. It must keep passing through every task of the refactor.
//
// string-by-value PARAMETER + RETURN (`string f(string){ return ... }`) now
// works via the class path (A4c Surface 5): the return uses the struct-return
// (__retbuf) ABI. greet() below pins it. Dedicated coverage lives in
// tests/teststringreturn.mad.
#include <iostream>
#include <string>
using namespace std;

string greet(string name) { string r = "Hello, "; r += name; return r; }

int main() {
    string a = "alpha";
    string b = a;                   // copy-construct
    cout << a << " " << b << endl;  // operator<<
    cout << "len=" << a.length() << endl;
    a = "beta";                     // operator=(const char*)
    cout << a << endl;
    string g = greet("world");      // string param + string return-by-value
    cout << g << endl;
    return 0;
}
