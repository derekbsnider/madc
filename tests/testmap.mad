#!/../bin/madc
#include <iostream>
#include <map>
#include <string>
using namespace std;

int main()
{
    map<string, int> ages;
    string key = "Alice";
    ages[key] = 30;
    key = "Bob";
    ages[key] = 25;

    int sz;
    sz = ages.size();
    cout << "size: " << sz << endl;

    key = "Alice";
    int age;
    age = ages[key];
    cout << "Alice: " << age << endl;

    int found;
    key = "Bob";
    found = ages.find(key) != ages.end();
    cout << "has Bob: " << found << endl;

    key = "Charlie";
    found = ages.find(key) != ages.end();
    cout << "has Charlie: " << found << endl;

    return 0;
}
