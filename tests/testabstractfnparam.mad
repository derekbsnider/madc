// Abstract function-type parameters and array-of-fn-ptr declarators
// (c-testsuite 00209): `int f1 (int (), int)` adjusts the fn-type param
// to pointer-to-function (C11 6.7.6.3p8); `typedef int (*fptr4[4])(int)`
// and the abstract `int (*[4])(int)` are ONE shape (array of fn-ptrs);
// `int (int())` nests the adjustment; `int ([4])` parenthesizes an
// abstract array. Declarations and typedef spellings of the same
// function must redeclare compatibly, and calls run through both.
// Oracle: gcc/clang print f1=42 f4a=1 f4b=2.
typedef int (*fptr1)();
int f1 (int (), int);
typedef int (*fptr2)(int x);
int f2 (int (int x), int);
typedef int (*fptr4[4])(int);
int f4 (int (*[4])(int), int);
typedef int (*fptr5)(fptr1);
int f5 (int (int()), fptr1);
int f8 (int ([4]), int);

static int inc(int x)
{
    return x + 1;
}

static int dbl(int x)
{
    return x + x;
}

int f1 (fptr1 fp, int i)
{
    return (*fp)(i);
}

int f4 (fptr4 fp, int i)
{
    return (*fp[i])(i);
}

int main()
{
    fptr4 t;
    t[0] = inc;
    t[1] = dbl;
    printf("f1=%d f4a=%d f4b=%d\n", f1(inc, 41), f4(t, 0), f4(t, 1));
    return 0;
}
