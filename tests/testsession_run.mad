// A program's text loaded into a session and its main run (plan §41.10a
// slice 2; the cores of %load and %run, D25): the text is one unit named by
// its path, main runs with the argv given and prints before its reply, and
// the entries that follow call its functions. A refused text cites its path
// and leaves the session as it was. session_edited reads a changed REPL
// buffer entry again (the live reparse); session_rebuild runs a REPL buffer
// again in a restarted backend (Restart and Run All): its lines taken as
// typed — an entry over several lines, an if taking its else — each entry
// announced with its text, then main, unless an entry named main.

// The next reply, passing over running notices; the program's output
// printed before it is appended to `out`.
long next_reply(var &r, long h, var &out)
{
    var cases;
    cases[0] = madc::session_readable(h);
    for ( ;; )
    {
	long got = madc::session_poll(r, h);
	var o;
	madc::session_output(o, h);
	out = format("{}{}", out, o);
	if ( got != 0 && r["kind"] == madc::session_reply::running )
	    continue;
	if ( got != 0 )
	    return got;
	var fired;
	madc::chan_select(fired, cases);
    }
}

// A rebuild's rows up to its answer: each entry's text (its running row)
// into `entries`, each replayed row's shown value into `shown`; the
// program's output appended to `out`.
void rebuild_reply(var &r, long h, var &out, var &entries, var &shown)
{
    var cases;
    cases[0] = madc::session_readable(h);
    for ( ;; )
    {
	long got = madc::session_poll(r, h);
	var o;
	madc::session_output(o, h);
	out = format("{}{}", out, o);
	if ( got != 0 && r["kind"] == madc::session_reply::running )
	    entries.push(r["entry"]);
	else if ( got != 0 && r["kind"] == madc::session_reply::replayed )
	    shown.push(r["shown"]);
	else if ( got != 0 )
	    return;
	else
	{
	    var fired;
	    madc::chan_select(fired, cases);
	}
    }
}

int main()
{
    long h = madc::session_open("c17");
    var r;
    var out = "";
    madc::session_offer(h, "int before = 1;", true);
    next_reply(r, h, out);

    madc::session_load(h, "buffer.c", "int broken( { return 0; }\n");
    next_reply(r, h, out);
    var rendered = r["rendered"];
    println("refused: load={} ok={} cites the path={}",
	    r["kind"] == madc::session_reply::load, r["ok"],
	    rust::contains(rendered.c_str(), "buffer.c:1:") != 0);

    madc::session_load(h, "buffer.c",
	"#include <stdio.h>\n"
	"static int triple(int v) { return 3 * v; }\n"
	"int main(int argc, char **argv)\n"
	"{\n"
	"    printf(\"main ran: argc=%d last=%s\\n\", argc, argv[argc - 1]);\n"
	"    return 5;\n"
	"}\n");
    next_reply(r, h, out);
    println("loaded: ok={}", r["ok"]);

    var argv = {};
    argv.push("buffer.c");
    argv.push("extra");
    out = "";
    madc::session_run(h, argv);
    next_reply(r, h, out);
    print("output: {}", out);
    println("ran: run={} ok={} status={}", r["kind"] == madc::session_reply::run,
	    r["ok"], r["status"]);

    madc::session_offer(h, "triple(14) + before", true);
    next_reply(r, h, out);
    println("entry: {}", r["shown"]);

    madc::session_offer(h, "int scale = 2;", true);
    next_reply(r, h, out);
    madc::session_edited(h, "int scale = 2;\n", "int scale = 7;\n");
    next_reply(r, h, out);
    println("edited: edited={} ok={}", r["kind"] == madc::session_reply::edited,
	    r["ok"]);
    madc::session_offer(h, "scale", true);
    next_reply(r, h, out);
    println("after the edit: {}", r["shown"]);

    var rebuilt = {};
    rebuilt.push("[REPL]");
    madc::session_restart(h, "c17");
    out = "";
    var entries = {};
    var shown = {};
    madc::session_rebuild(h,
	"int count = 2;\n"
	"int twice(int v)\n"
	"{\n"
	"    return 2 * v;\n"
	"}\n"
	"\n"
	"if ( count > 5 ) count = 0;\n"
	"else count = twice(count);\n"
	"#include <stdio.h>\n"
	"int main(int argc, char **argv)\n"
	"{\n"
	"    printf(\"main ran: argc=%d last=%s count=%d\\n\", argc, argv[argc - 1], count);\n"
	"    return 5;\n"
	"}\n"
	"count\n", rebuilt);
    rebuild_reply(r, h, out, entries, shown);
    println("rebuilt: rebuild={} ok={} main={} status={} entries={} replayed={}",
	    r["kind"] == madc::session_reply::rebuild, r["ok"], r["main"],
	    r["status"], php::count(entries), php::count(shown));
    println("third entry: {}", entries[2]);
    println("last shown: {}", shown[5]);
    print("rebuilt: {}", out);

    madc::session_restart(h, "c17");
    out = "";
    entries = {};
    shown = {};
    madc::session_rebuild(h,
	"#include <stdio.h>\n"
	"int main(void) { printf(\"once\\n\"); return 0; }\n"
	"main();\n", rebuilt);
    rebuild_reply(r, h, out, entries, shown);
    println("named, not run again: ok={} main={} runs={}", r["ok"], r["main"],
	    python::count(out.c_str(), "once"));
    madc::session_close(h);
    return 0;
}
