#!/usr/bin/env madc
#include <iostream>
using namespace std;
// Test cin >> input operator

int main()
{
	string name;
	int age;

	cin >> name;
	cin >> age;
	cout << "name: " << name << endl;
	cout << "age: " << age << endl;

	// chained input
	string a;
	string b;
	cin >> a >> b;
	cout << a << " " << b << endl;

	return 0;
}
