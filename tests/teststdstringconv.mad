#!/../bin/madc
#include <stdio.h>
#include <string>

int main()
{
    // std::to_string is the standard 1-arg value->string converter (returns
    // the string); it is NOT an (out, value) writer — that 2-arg form only
    // existed under the old embedded shims and both g++/clang reject it.
    std::string s = std::to_string(42);
    printf("%s\n", s.c_str());

    std::string num = "12345";
    int n = std::stoi(num);
    printf("%d\n", n);

    std::string dbl = "3.5";
    double d = std::stod(dbl);
    printf("%g\n", d);

    return 0;
}
