#include <stdio.h>

int classify(int x) {
    switch (x) {
        case 1 ... 5: return 1;
        case 10 ... 20: return 2;
        case 100: return 3;
        default: return 0;
    }
}

int main() {
    printf("%d %d %d %d %d %d\n",
        classify(3), classify(15), classify(100),
        classify(0), classify(7), classify(50));
    return 0;
}
