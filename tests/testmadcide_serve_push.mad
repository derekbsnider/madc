// V6a duplex (client-server, D2): the {"event":…} PUSH feed. A hub serving
// multiple clients fans each change out at append time — when one client's
// command advances the change log, the serving task broadcasts the new
// event(s) down every OTHER connected client's socket (broadcast-at-append,
// the industry-standard server-authoritative hub). This pins that an IDLE
// observer, parked on its own readline having sent nothing, still receives a
// peer's edit — the whole point of duplex.
//
// The EDITOR speaks first (the first api client to speak = owner, so it may
// edit, V6a tiers), the observer second — the seat (serve_conn_task, the
// production task) classifies and share()-registers a connection on its first
// byte — THEN the editor edits, so the observer is on the roster before the
// broadcast runs.
#include "../tools/texteditor/lined_core.inc"
#include "../tools/texteditor/editor_events.inc"
#include "../tools/madcide/madcide_core.inc"
#include "../tools/madcide/madcide_discover.inc"
#include "../tools/madcide/madcide_client.inc"
#include "../tools/madcide/madcide_api.inc"
#include "../tools/madcide/madcide_mcp.inc"
// The connection seat routes a client's LSP traffic to lsp_handle (V6c-3c),
// so the dispatcher comes first — madcide.mad's own order.
#include "../tools/madcide/madcide_lsp.inc"
#include "../tools/madcide/madcide_seat.inc"
#include "../tools/madcide/madcide_ws.inc"
#include "../tools/madcide/madcide_serve.inc"

int main()
{
    const char *path = "madc_ide_serve_push.mad";
    php::file_put_contents(path, "long add(long a, long b) { return a + b; }\n");

    IdeSession S;
    long doc = S.open(path, false);
    S.terminal(false);

    madc::channel listener("listen://127.0.0.1:0");
    if ( !listener.ok() )
    {
	println("listen-fail: {}", listener.last_error());
	return 1;
    }
    var addr = listener.local_endpoint();
    var uri = format("tcp://{}", addr);

    // Both clients dial (editor first on the backlog); accept both before
    // spawning, so the editor's task shares first and is granted owner.
    madc::channel ed(uri.c_str());
    madc::channel obs(uri.c_str());
    madc::channel te;
    listener.wait_readable();
    listener.accept(te);
    long conn_ed = te.detach();
    madc::channel to;
    listener.wait_readable();
    listener.accept(to);
    long conn_obs = to.detach();

    go serve_conn_task(&S, doc, conn_ed);
    go serve_conn_task(&S, doc, conn_obs);
    yield();			// both tasks park on their first byte

    // Each client speaks once so the seat classifies, shares and tiers it —
    // the editor first (owner), then the observer. A silent connection is not
    // yet an api client: it is not on the roster and receives no push.
    ed.write("{\"cmd\":\"check\",\"seq\":5}\n");
    yield();
    var h1;
    ed.readline(h1);
    obs.write("{\"cmd\":\"check\",\"seq\":6}\n");
    yield();
    var h2;
    obs.readline(h2);

    // The editor edits; its task wakes, mutates, broadcasts to the observer.
    ed.write("{\"cmd\":\"delline\",\"seq\":7}\n");
    yield();

    var evline;
    obs.readline(evline);
    var ev;
    js::parse(ev, evline);
    println("observer-event: kind={} seq={}",
	    ev["event"]["kind"], ev["event"]["seq"].as_integer());

    var rl;
    ed.readline(rl);
    var reply;
    js::parse(reply, rl);
    println("editor-reply: seq={} ok={}", reply["seq"].as_integer(),
	    reply["ok"].as_boolean() ? 1 : 0);

    ed.close_write();
    obs.close_write();
    madc::task_drain();

    ed.close();
    obs.close();
    listener.close();
    S.close();
    php::unlink(path);
    return 0;
}
