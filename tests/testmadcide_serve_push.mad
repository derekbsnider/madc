// V6a duplex (client-server, D2): the {"event":…} PUSH feed. A hub serving
// multiple clients fans each change out at append time — when one client's
// command advances the change log, the serving task broadcasts the new
// event(s) down every OTHER connected client's socket (broadcast-at-append,
// the industry-standard server-authoritative hub). This pins that an IDLE
// observer, parked on its own readline having sent nothing, still receives a
// peer's edit — the whole point of duplex.
//
// The EDITOR connects first (first connection = owner, so it may edit, V6a
// tiers), the observer second; both park idle, THEN the editor edits — so the
// observer is share()-registered before the broadcast runs.
#include "../tools/texteditor/lined_core.inc"
#include "../tools/texteditor/editor_events.inc"
#include "../tools/madcide/madcide_core.inc"
#include "../tools/madcide/madcide_api.inc"

int main()
{
    const char *path = "madc_ide_serve_push.mad";
    php::file_put_contents(path, "long add(long a, long b) { return a + b; }\n");

    IdeSession S;
    long doc = S.open(path, false);
    S.terminal(false);

    madc::channel listener("listen://127.0.0.1:0");
    if ( !listener.ok() )
    {
	println("listen-fail: {}", listener.last_error());
	return 1;
    }
    var addr = listener.local_endpoint();
    var uri = format("tcp://{}", addr);

    // Both clients dial (editor first on the backlog); accept both before
    // spawning, so the editor's task shares first and is granted owner.
    madc::channel ed(uri.c_str());
    madc::channel obs(uri.c_str());
    madc::channel te;
    listener.wait_readable();
    listener.accept(te);
    long conn_ed = te.detach();
    madc::channel to;
    listener.wait_readable();
    listener.accept(to);
    long conn_obs = to.detach();

    go serve_client_task(&S, doc, conn_ed);
    yield();			// editor shares (owner), parks idle
    go serve_client_task(&S, doc, conn_obs);
    yield();			// observer shares (observer), parks idle

    // The editor edits; its task wakes, mutates, broadcasts to the observer.
    ed.write("{\"cmd\":\"delline\",\"seq\":7}\n");
    yield();

    var evline;
    obs.readline(evline);
    var ev;
    js::parse(ev, evline);
    println("observer-event: kind={} seq={}",
	    ev["event"]["kind"], ev["event"]["seq"].as_integer());

    var rl;
    ed.readline(rl);
    var reply;
    js::parse(reply, rl);
    println("editor-reply: seq={} ok={}", reply["seq"].as_integer(),
	    reply["ok"].as_boolean() ? 1 : 0);

    ed.close_write();
    obs.close_write();
    madc::task_drain();

    ed.close();
    obs.close();
    listener.close();
    S.close();
    php::unlink(path);
    return 0;
}
