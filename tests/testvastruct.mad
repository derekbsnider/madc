#include <stdarg.h>
#include <stdio.h>

struct GP { long g; };
struct FP { double d; };
struct BIG { char b[17]; };

long sum_after_gp(struct GP a, struct GP b, ...)
{
	va_list ap;
	va_start(ap, b);
	long s = a.g + b.g;
	s += va_arg(ap, long);
	s += va_arg(ap, long);
	va_end(ap);
	return s;
}

double sum_after_fp(struct FP a, ...)
{
	va_list ap;
	va_start(ap, a);
	double s = a.d;
	s += va_arg(ap, double);
	va_end(ap);
	return s;
}

long sum_after_big(struct BIG a, ...)
{
	va_list ap;
	va_start(ap, a);
	long s = a.b[0] + a.b[16];
	s += va_arg(ap, long);
	s += va_arg(ap, long);
	va_end(ap);
	return s;
}

int main()
{
	struct GP g1, g2;
	struct FP f1;
	struct BIG bg;
	g1.g = 10; g2.g = 20;
	f1.d = 1.5;
	int i;
	for (i = 0; i < 17; i++) bg.b[i] = (char)(i + 1);
	printf("%ld\n", sum_after_gp(g1, g2, 100L, 200L));
	printf("%.1f\n", sum_after_fp(f1, 2.25));
	printf("%ld\n", sum_after_big(bg, 1000L, 2000L));
	return 0;
}
