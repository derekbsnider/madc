#!/../bin/madc
// A full scalar container built purely from template instantiation + the class
// model: ctor/dtor, push_back via realloc, size(), T& operator[] (read+write),
// and range-for over the class (index loop on size()/operator[]). This is the
// proof-of-concept for the real include/madc/vector (which is gated on the
// `vector` lexer keyword being retired).
#include <iostream>
#include <stdlib.h>
using namespace std;

template<typename T> class Vec {
    T* data;
    long len;
    long cap;
    Vec() { data = (T*)malloc(4 * sizeof(T)); len = 0; cap = 4; }
    ~Vec() { free(data); }
    void push_back(T v) {
        if (len >= cap) { cap = cap * 2; data = (T*)realloc(data, cap * sizeof(T)); }
        data[len] = v;
        len = len + 1;
    }
    T& operator[](long i) { return data[i]; }
    long size() { return len; }
};

int main()
{
    Vec<int> v;
    v.push_back(10);
    v.push_back(20);
    v.push_back(30);
    printf("size=%ld\n", v.size());

    v[1] = 99;                       // write through operator[] (T&)
    printf("[0]=%d [1]=%d [2]=%d\n", v[0], v[1], v[2]);

    long sum = 0;
    for (int n : v) { sum = sum + n; }   // range-for over the class
    printf("sum=%ld\n", sum);

    // grow past initial capacity (exercises realloc)
    Vec<long> big;
    long i = 0;
    while (i < 10) { big.push_back(i * i); i = i + 1; }
    printf("big.size=%ld big[9]=%ld\n", big.size(), big[9]);
    return 0;
}
