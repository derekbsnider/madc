// `madcide FILE --line` is madc's line mode, `madc -i FILE` (split arc
// 1D.18, decided 2026-10-09): run_line — the loop madcide's main hands
// --line to — runs the running madc on the file with the terminal handed
// over, and madcide keeps no line grammar of its own. Oracle: vim -e on the
// colon lines of the same transcript (tests/testmadcide_line.input) leaves
// the file with "hello" appended after its last line; the write's message
// is the ex core's vim-form file message; the entry `add(2,3)` answers 5
// from the file's definition. Pins: the transcript's answers on stdout (the
// child's), the file as written, and run_line's exit status (madc's).
#include "../tools/texteditor/editor_events.inc"
#include "../tools/madcide/madcide_core.inc"
#include "../tools/madcide/madcide_line.inc"

int main()
{
    const char *path = "madc_ide_line.mad";
    php::file_put_contents(path, "long add(long a, long b) { return a + b; }\n");
    var none = {};		// no further files on the command line
    long rc = run_line(path, false, none);
    var saved;
    php::file_get_contents(saved, path);
    println("line-saved: {}", saved == "long add(long a, long b) { return a + b; }\nhello\n" ? "ok" : "FAIL");
    println("line-rc: {}", rc);
    // a test leaves nothing in its working directory
    remove(path);
    return 0;
}
