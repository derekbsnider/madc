spaces: ok=1 n=3 [<a><b><c>]
double: ok=1 n=2 [<hello world><x>]
single-adjacent: ok=1 n=1 [<its>]
escaped-space: ok=1 n=1 [<a b>]
escaped-quote: ok=1 n=1 [<a"b>]
double-keeps-n: ok=1 n=1 [<a\nb>]
single-literal: ok=1 n=1 [<a\b>]
empty: ok=1 n=0 []
blank: ok=1 n=0 []
empty-word: ok=1 n=3 [<x><><y>]
hash: ok=1 n=3 [<#not><a><comment>]
joined: ok=1 n=1 [<ab cd>]
tab-newline: ok=1 n=3 [<a><b><c>]
double-keeps-dollar: ok=1 n=1 [<\$HOME>]
double-backslash: ok=1 n=1 [<a\b>]
plain-backslash: ok=1 n=1 [<a\b>]
escaped-apostrophe: ok=1 n=1 [<it's>]
unclosed-double: ok=0 n=0 []
trailing-escape: ok=0 n=0 []
unclosed-single: ok=0 n=0 []
