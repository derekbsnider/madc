#include <iostream>
using namespace std;
// Test command line arguments: int main(int argc, char **argv)
// Run: bin/madc tests/testargv.mad hello world

int main(int argc, char **argv)
{
    cout << "argc: " << argc << endl;

    int i;
    for ( i = 0; i < argc; i++ )
        cout << "argv[" << i << "]: " << argv[i] << endl;

    // Legacy helper kept for backward compatibility — exercise it once
    // so the registration stays covered.
    cout << "legacy: " << get_argv(argv, 0) << endl;

    return 0;
}
