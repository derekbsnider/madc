// Test command line arguments: int main(int argc, char **argv)
// Run: bin/madc tests/testargv.mad hello world

int main(int argc, char **argv)
{
    cout << "argc: " << argc << endl;

    int i;
    for ( i = 0; i < argc; i++ )
        cout << "argv[" << i << "]: " << get_argv(argv, i) << endl;

    return 0;
}
