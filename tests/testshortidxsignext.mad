#include <stdio.h>
#include <stdlib.h>

/* Regression test: short array indices must sign-extend to 64-bit.
 * When a short index is -1 (0xFFFF), the 16→64 sign extension must
 * produce 0xFFFFFFFFFFFFFFFF (-1), not 0x00000000FFFFFFFF (4 billion).
 * The latter reads way out of bounds instead of just one element back.
 */

typedef struct pc_data PC_DATA;
typedef struct char_data CHAR_DATA;

struct pc_data {
	int pad_before;
	short learned[16];
};

struct char_data {
	int pad0[56];
	PC_DATA *pcdata;
};

short gsn_test = -1;

int test_lookup(CHAR_DATA *ch)
{
	/* With a -1 index, learned[-1] reads into pad_before.
	 * This must NOT crash — the index must sign-extend properly. */
	if ( ch->pcdata->learned[gsn_test] )
		return 1;
	return 0;
}

int main()
{
	CHAR_DATA *ch = (CHAR_DATA *)calloc(1, sizeof(CHAR_DATA));
	PC_DATA *pc = (PC_DATA *)calloc(1, sizeof(PC_DATA));
	ch->pcdata = pc;
	pc->pad_before = 0;
	pc->learned[3] = 77;

	/* Positive index: should work */
	gsn_test = 3;
	printf("learned[3]=%d\n", test_lookup(ch));

	/* Negative index: must not crash (reads pad_before=0) */
	gsn_test = -1;
	printf("learned[-1]=%d\n", test_lookup(ch));

	free(pc);
	free(ch);
	return 0;
}
