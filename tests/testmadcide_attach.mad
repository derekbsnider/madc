// V6c-3c, split arc 1D: the ATTACH RELAY — an agent host's MCP client joins a
// session that is ALREADY RUNNING. This test IS the whole picture: it holds a
// live session with a real listener (the `--serve` side), spawns `madcide
// <file> --mcp --attach <addr>` as a child (the agent's side), and drives MCP
// down the child's stdio. Every answer must come from THIS process's session
// — its tool host (madc's tools and madcide's commands) — not a private one
// the child opened: that is the gatekeeper shape, and the thing a second
// session would silently break. Closing the child's stdin ends the RELAY;
// the session stands for everyone else.
#include "../tools/texteditor/editor_events.inc"
#include "../tools/madcide/madcide_core.inc"
#include "../tools/madcide/madcide_client.inc"
#include "../tools/madcide/madcide_api.inc"
#include "../tools/madcide/madcide_seat.inc"
#include "../tools/madcide/madcide_ws.inc"
#include "../tools/madcide/madcide_serve.inc"

void send(madc::channel &c, var &msg)
{
    var js = js::stringify(msg);
    var line = format("{}\n", js);
    c.write(line.c_str());
}

bool read_reply(var &out, madc::channel &c)
{
    var line;
    if ( !c.readline(line) )
	return false;
    return js::parse(out, line.c_str());
}

// One tools/call through the relay: the tool's result text, parsed.
void call_tool(var &out, madc::channel &relay, long id, const char *name, var &args)
{
    var params = { "name": name, "arguments": args };
    var req = { "jsonrpc": "2.0", "id": id, "method": "tools/call", "params": params };
    send(relay, req);
    var reply;
    read_reply(reply, relay);
    var text = reply["result"]["content"][0]["text"];
    js::parse(out, text.c_str());
}

int main()
{
    const char *path = "madc_ide_attach.mad";
    php::file_put_contents(path,
	"long twice(long a)\n{\n\treturn a + a;\n}\n\nint main()\n{\n\treturn twice(21);\n}\n");

    // ---- the RUNNING session, here in this process ----------------------
    IdeSession S;
    long doc = S.open(path, false);
    println("session: {}", doc > 0 ? 1 : 0);
    S.terminal(false);
    long w = S.world();

    madc::channel listener("listen://127.0.0.1:0");
    println("listening: {}", listener.ok() ? 1 : 0);
    var addr = listener.local_endpoint();

    // ---- the agent's side: a spawned relay -------------------------------
    var self = madc::compiler_path();
    var uri = format("exec://{} --no-config tools/madcide/madcide.mad {} --mcp --attach {}",
		     self, path, addr);
    madc::channel relay(uri.c_str());
    println("relay-open: {}", relay.ok() ? 1 : 0);

    scope
    {
	// Accept the relay's connection and serve it on its own task, exactly
	// as run_serve would — the seat is the same seat.
	listener.wait_readable();
	madc::channel client;
	long got = listener.accept(client);
	println("accepted: {}", got > 0 ? 1 : 0);
	long conn = client.detach();
	go serve_conn_task(&S, doc, conn);

	// The agent initializes THROUGH the relay: the session's tool host
	// answers.
	var init = { "jsonrpc": "2.0", "id": 1, "method": "initialize" };
	send(relay, init);
	var reply;
	read_reply(reply, relay);
	println("server: {}", reply["result"]["serverInfo"]["name"]);

	// A read that can only be answered from the SESSION's document — madc's
	// code graph over it. The child opened no document of its own.
	var none = {};
	var syms;
	call_tool(syms, relay, 2, "graph.symbols", none);
	println("symbol0-through-relay: {}", syms["nodes"][0]["name"]);

	// madcide's COMMANDS through the relay, onto the shared session.
	var line8 = { "args": "8" };
	var r;
	call_tool(r, relay, 3, "gotoline", line8);
	call_tool(r, relay, 4, "delline", none);
	println("command-through-relay: {}", r["ok"]);

	// THE POINT: the edit landed in THIS process's session, so the local
	// buffer has lost the line. A private session in the child would leave
	// this text untouched.
	var text;
	ui::text(text, w, S.active(doc));
	println("session-sees-relay-edit: {}",
		perl::index(text.c_str(), "return twice(21);") < 0 ? 1 : 0);

	// End of the agent: its stdin closes, the relay ends; the session must
	// still be standing — one client leaving never tears down a session.
	relay.close_write();
	var tail;
	while ( relay.readline(tail) )
	    ;
	relay.close();
	println("relay-exit-status: {}", relay.exit_status());
	listener.close();
    }

    var alive;
    ui::text(alive, w, S.active(doc));
    println("session-alive-after-relay-exit: {}", strlen(alive.c_str()) > 0 ? 1 : 0);
    S.close();
    php::unlink(path);
    return 0;
}
