// R5 gate: examples/vised — madc's example editor on its public surface —
// headless (vised_core.inc is the editor less its loop; the events are the
// values ui::event produces). The contracts lined's retirement leaves to
// it:
//   1. edits go through the ONE mutation path: the edit notification hears
//      every one, and the heading reads [modified];
//   2. ^Z is the document's undo: the text, the caret it carried, and the
//      saved state (back at the saved text, the heading is clean);
//   3. save through madc's colon mode: ^S is `:w` (vim's file message), the
//      file on disk is the text;
//   4. the caret is an anchor: another writer's insert above it moves it
//      with its text;
//   5. a colon command (`:1d`) edits through the same path and leaves the
//      caret on `.`, as vim leaves its cursor;
//   6. quit through madc's colon mode: ^Q (`:q`) is refused while the file
//      is modified (vim's E37), ^X (`:q!`) ends;
//   7. a read-only document refuses typing; the text unchanged.
// Oracle for 3, 5 and 6: vim on the same text (`:w`; `:1d` from line 2 puts
// the cursor on line 1; `:q` on a changed buffer refuses). The rest are the
// engine's contracts. The test removes what it creates.
#include "../examples/vised/vised_core.inc"

void ev_text(var &e, const char *t)
{
    e = { "event": "text", "event_code": ui::event_kind::text, "text": t };
}

void ev_key(var &e, const char *k)
{
    e = { "event": "key", "event_code": ui::event_kind::key, "key": k,
	  "key_code": ui::key_code(k) };
}

void show(vised &v, const char *label)
{
    var t;
    ui::text(t, v.w, v.doc);
    var tree;
    vised_tree(tree, v);
    var head = tree["children"][0]["content"];
    var edits;
    ui::get(edits, v.w, v.doc, "edits");
    println("{}: [{}] caret={} edits={} head={} msg={}", label,
	    php::str_replace("\n", "|", t), vised_caret(v), edits,
	    head.is_null() ? "clean" : head.c_str(), v.msg);
}

int main()
{
    const char *path = "tmp/testvised.txt";
    php::file_put_contents(path, "one\ntwo\n");
    vised v;
    println("open: {}", vised_open(v, path, false) ? 1 : 0);
    var e;
    ev_key(e, "down");
    vised_event(v, e);
    ev_text(e, "2");
    vised_event(v, e);			// 1. "one\n2two\n"
    show(v, "typed");
    ev_key(e, "^z");
    vised_event(v, e);			// 2. undone: the saved text again
    show(v, "undo");
    ev_text(e, "2");
    vised_event(v, e);
    ev_key(e, "^s");
    vised_event(v, e);			// 3. :w
    show(v, "saved");
    var disk;
    php::file_get_contents(disk, path);
    println("disk: {}", disk == "one\n2two\n" ? "ok" : "FAIL");
    ui::text_insert(v.w, v.doc, 0, ">> ");	// 4. another writer, above the caret
    show(v, "other");
    ev_key(e, "esc");
    vised_event(v, e);
    ev_text(e, "1d");
    vised_event(v, e);
    ev_key(e, "enter");
    vised_event(v, e);			// 5. :1d
    show(v, "ex-1d");
    ev_key(e, "^q");
    println("quit-dirty: cont={} msg={}", vised_event(v, e) ? 1 : 0, v.msg);	// 6.
    ev_key(e, "^x");
    println("discard: cont={}", vised_event(v, e) ? 1 : 0);
    vised_close(v);

    vised r;					// 7. read-only
    vised_open(r, path, true);
    ev_text(e, "z");
    vised_event(r, e);
    show(r, "readonly");
    vised_close(r);
    php::unlink(path);
    return 0;
}
