// Positive control for --no-sysroot-includes (tests/testnosysrootinc.mad): the
// SAME program without the flag. <zstd.h> is an add-on library header
// (libzstd-dev, a madc build dependency) that lives only in the sysroot's
// /usr/include (no embedded twin, not in the C++ stdlib dirs, in no pack), so
// it resolves here from disk and must NOT resolve under the flag.
// The always-available println intrinsic keeps the program include-free apart
// from the sysroot-only header.
#include <zstd.h>
int main()
{
	int ok = ZSTD_VERSION_MAJOR >= 1;
	println("sysroot header resolved: {}", ok);
	return 0;
}
