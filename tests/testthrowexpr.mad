// throw-EXPRESSION ([expr.throw]): `(throw X())` and `cond ? a : throw e`.
// libstdc++'s `_GLIBCXX_THROW_OR_ABORT(x)` expands to `(throw (x))`, used by the
// `__throw_*` helpers in the <memory> allocator chain (vector reallocation).
#include <iostream>
int main() {
  int a = 0, b = 0;
  try { (throw 5); } catch (...) { a = 1; }
  try { (void)(true ? (throw 42) : 0); } catch (int x) { b = x; }
  std::cout << "a=" << a << " b=" << b << "\n";
  return 0;
}
