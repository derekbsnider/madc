#!/../bin/madc
#include <stdio.h>

#define args(list) list

void log_line args( ( const char *msg, int level ) );

void log_line(const char *msg, int level)
{
    printf("%s %d\n", msg, level);
}

void show_list(bool list)
{
    if ( list )
        printf("1\n");
    else
        printf("0\n");
}

void print_argv(char * const argv[])
{
    if ( argv[0] != NULL )
        printf("argv\n");
}

int main()
{
    log_line("ok", 7);
    show_list(1);
    return 0;
}
