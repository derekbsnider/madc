#include <stdio.h>
#include <iostream>
using namespace std;

// Test struct initializer lists

struct Point {
    int x;
    int y;
};

struct Entry {
    char *name;
    int value;
};

struct Mixed {
    string label;
    int a;
    int b;
};

int main()
{
    // Scalars only
    struct Point p = { 10, 20 };
    printf("p = (%ld, %ld)\n", p.x, p.y);

    // Expressions as init values
    struct Point q = { 1 + 2, 3 * 4 };
    printf("q = (%ld, %ld)\n", q.x, q.y);

    // Partial init: remaining fields zero-filled
    struct Point z = { 99 };
    printf("z = (%ld, %ld)\n", z.x, z.y);       // 99 0

    // char* member with string literal (SMAUG tables.c pattern)
    struct Entry e = { "alice", 30 };
    printf("e = (%s, %ld)\n", e.name, e.value);

    // string member
    struct Mixed m = { "greetings", 100, 200 };
    cout << "m = (" << m.label << ", " << m.a << ", " << m.b << ")" << endl;

    // Array of structs (SMAUG tables.c pattern)
    struct Entry tab[] = {
        { "alice",   1 },
        { "bob",     2 },
        { "carol",   3 }
    };
    for ( int i = 0; i < 3; i++ )
        printf("tab[%ld] = (%s, %ld)\n", i, tab[i].name, tab[i].value);

    // Partial array of structs (remaining elements zero-filled)
    struct Entry padded[3] = { { "first", 100 } };
    if ( padded[1].name == 0 )
        printf("padded[1].name is null\n");
    printf("padded[0]=%s val=%ld; padded[2] val=%ld\n",
        padded[0].name, padded[0].value, padded[2].value);

    return 0;
}
