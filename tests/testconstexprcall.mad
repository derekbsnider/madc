#include <cstdio>

constexpr int inc(int a) { return a + 1; }

enum { E_CALL = inc(6) };
static_assert(inc(1) == 2, "constexpr call in static_assert");

template<int N> struct Tag { };
int want2(Tag<2>) { return 2; }

int main()
{
	Tag<inc(1)> t;
	printf("constexpr call: %d %d\n", (int)E_CALL, want2(t));
	return 0;
}
