// A parenthesized deref operand that is a CAST — `**(int**)bar`
// (c-testsuite 00103). The operand of every `*` is read by one owner,
// Program::parseCastExpression (the engine, bounded), whose `(` arm tells a
// cast head from a statement expression or a grouped expression — union
// heads included (`*(union U*)p`, a gap of the inline list an earlier
// per-arm reader carried). The g= line pins the star accounting: `***(q3)`
// dereferences all three times (an old N-star arm under-deref'd it by one —
// silent wrong answer, exit 0); `**x` is now the deref of `*x` by
// recursion, so there is no count left to get wrong.
// Oracle: gcc/clang print s=9 d=7 t=7 g=7.
union U { int a; };

int main()
{
    union U u;
    int x = 7;
    void *foo;
    void **bar;
    void ***baz;
    u.a = 9;
    foo = (void*)&x;
    bar = &foo;
    baz = &bar;
    int *q1 = &x;
    int **q2 = &q1;
    int ***q3 = &q2;
    printf("s=%d\n", (*(union U*)&u).a);
    printf("d=%d\n", **(int**)bar);
    printf("t=%d\n", ***(int***)baz);
    printf("g=%d\n", ***(q3));
    return 0;
}
