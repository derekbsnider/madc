#include <stdio.h>

// wchar_t is a keyword of the dialect (and of C++): redeclaring it with a
// typedef is ill-formed there (g++: "redeclaration of C++ built-in type").
wchar_t x[] = L"Ä";
const wchar_t ws[] = L"foo";

int main(void)
{
	printf("%d %d %d\n", x[0], x[1], ws[2]);
	printf("%d\n", L'Ä');
	return 0;
}
