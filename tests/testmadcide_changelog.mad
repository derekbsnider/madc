// V4 (change event log): the redo/replay + compaction gate (design doc S2.4).
// A scripted edit sequence journals through ed_text_insert / ed_text_erase
// (the ONE text-mutation owner); replay reconstructs the buffer at any seq
// (round-trip + historical), a checkpoint bounds replay, and compaction
// sheds old records while every surviving seq stays replayable and a
// trimmed seq clamps UP to the oldest checkpoint. Headless -- pure log
// logic, no frontend. Snapshots capture ACTUAL buffer text at each stage,
// so the gate is independent of any editor buffer convention.
#include "../tools/texteditor/lined_core.inc"
#include "../tools/texteditor/editor_events.inc"
#include "../tools/madcide/madcide_core.inc"

void okfail(const char *label, bool cond, var got, var want)
{
    if ( cond )
        println("{}: ok", label);
    else
        println("{}: FAIL got[{}] want[{}]", label, got, want);
}

long logline_count(long w, long le)
{
    var blob;
    ui::text(blob, w, le);
    var lines;
    php::explode(lines, "\n", blob.c_str());
    return php::count(lines);
}

int main()
{
    const char *path = "madc_ide_clog.mad";
    php::file_put_contents(path, "");

    long w = ui::world_new();
    long doc = setup_document(w, path, false);
    bind_lineed_verbs(w);
    long es = spawn_view_es(w, doc, path);
    long le = changelog_of(w, doc);

    // Build the text through splices; snapshot ACTUAL text + seq at stages.
    ed_text_insert(w, es, doc, 0, "alpha");        // seq 1
    ed_text_insert(w, es, doc, 5, " beta");        // seq 2
    long segB = es_int(w, le, "seq", 0);
    var snapB;
    ui::text(snapB, w, doc);
    ed_text_insert(w, es, doc, 10, " gamma");      // seq 3
    ed_text_erase(w, es, doc, 0, 6);               // seq 4 -- drop "alpha "
    long segD = es_int(w, le, "seq", 0);
    var snapD;
    ui::text(snapD, w, doc);
    ed_text_insert(w, es, doc, 0, "X");            // seq 5
    long segE = es_int(w, le, "seq", 0);
    var snapE;
    ui::text(snapE, w, doc);

    clog_checkpoint(w, doc);                        // seq 6 -- checkpoint snapE
    ed_text_insert(w, es, doc, 0, "Z");            // seq 7
    var cur;
    ui::text(cur, w, doc);

    // Replay: the whole log round-trips to the live buffer, and any past
    // seq reconstructs the snapshot taken then (checkpoint replay included).
    var rAll;
    clog_replay(rAll, w, doc, -1);
    okfail("V4 replay-all", rAll == cur, rAll, cur);
    var rE;
    clog_replay(rE, w, doc, segE);
    okfail("V4 replay@E", rE == snapE, rE, snapE);
    var rB;
    clog_replay(rB, w, doc, segB);
    okfail("V4 replay@B", rB == snapB, rB, snapB);
    var rD;
    clog_replay(rD, w, doc, segD);
    okfail("V4 replay@D", rD == snapD, rD, snapD);

    // event:N edit-history View: a View of the doc at a past revision
    // replays onto its own render buffer (before compaction, full history).
    long hv = make_history_view(w, es, doc, segE);
    var hvrow;
    view_row(hvrow, w, es, hv);
    var hvtext;
    ui::text(hvtext, w, hvrow["vbuf"].as_integer());
    okfail("V4 history-view@E", hvtext == snapE, hvtext, snapE);

    // Compaction: force it (limit 1 byte), keep the last 2 records. The log
    // shrinks, the live text still round-trips, and a seq below the fresh
    // checkpoint clamps up to it (the retention rule).
    long before = logline_count(w, le);
    clog_compact(w, doc, 1, 2);
    long after = logline_count(w, le);
    var rC;
    clog_replay(rC, w, doc, -1);
    okfail("V4 replay-after-compact", rC == cur, rC, cur);
    println("V4 compaction-shrank: {}", after < before ? "ok" : "FAIL");
    var rClamp;
    clog_replay(rClamp, w, doc, segB);             // segB now below the cut
    okfail("V4 replay-clamp", rClamp == snapE, rClamp, snapE);

    // Nexus L4c: ONE stream per session. A second document's splices ride the
    // same log; each document replays ONLY its own records; compaction writes
    // one checkpoint PER document at the cut; events_since(doc) filters and
    // events_since(0) answers everything.
    const char *pathB = "madc_ide_clog_b.mad";
    php::file_put_contents(pathB, "");
    long docB = setup_document(w, pathB, false);
    long esB = spawn_view_es(w, docB, pathB);
    ed_text_insert(w, esB, docB, 0, "one");        // seq 8
    ed_text_insert(w, es, doc, 0, "Y");            // seq 9 -- interleaved
    ed_text_insert(w, esB, docB, 3, " two");       // seq 10
    var curB;
    ui::text(curB, w, docB);
    var cur2;
    ui::text(cur2, w, doc);
    var rA;
    clog_replay(rA, w, doc, -1);
    okfail("L4c replay-doc-A", rA == cur2, rA, cur2);
    var rBB;
    clog_replay(rBB, w, docB, -1);
    okfail("L4c replay-doc-B", rBB == curB, rBB, curB);
    var evAll;
    events_since(evAll, w, 0, 0);
    var evB;
    events_since(evB, w, docB, 0);
    // all = the 3 survivors of the first compaction (checkpoint@5, 6, 7) + the
    // three splices above; docB = its two splices.
    println("L4c events-since: all={} docB={}", php::count(evAll), php::count(evB));
    clog_compact(w, doc, 1, 1);                    // cut = 9: both docs have records at or below it
    long cps = 0;
    var recs2;
    clog_records(recs2, w, le);
    for ( var rec : recs2 )
    {
	if ( clog_kind_of(rec) == ckCHECKPOINT )
	    cps = cps + 1;
    }
    println("L4c per-doc-checkpoints: {}", cps);
    var rA2;
    clog_replay(rA2, w, doc, -1);
    okfail("L4c replay-A-after-compact", rA2 == cur2, rA2, cur2);
    var rB2;
    clog_replay(rB2, w, docB, -1);
    okfail("L4c replay-B-after-compact", rB2 == curB, rB2, curB);

    // Persistence round-trip: a manifest makes .prj.events materialise;
    // persist, then restore into a FRESH world and replay -> the same text.
    // The restored records carry the WRITING session's doc ids; clog_restore
    // re-attaches the restoring document's by path, a later open adopts its own.
    ui::set(w, es, "projfile", "madc_ide_clog.prj.json");
    clog_persist(w, es, doc);
    long w2 = ui::world_new();
    long doc2 = setup_document(w2, path, false);
    long es2 = spawn_view_es(w2, doc2, path);
    ui::set(w2, es2, "projfile", "madc_ide_clog.prj.json");
    clog_restore(w2, es2, doc2);
    var rr;
    clog_replay(rr, w2, doc2, -1);
    okfail("V4 persist-restore", rr == cur2, rr, cur2);
    long docB2 = setup_document(w2, pathB, false);	// opened later: adopts its records by path
    clog_adopt(w2, docB2);
    var rrB;
    clog_replay(rrB, w2, docB2, -1);
    okfail("L4c persist-restore-B", rrB == curB, rrB, curB);
    php::unlink("madc_ide_clog.prj.events");

    // V6 seam: a TORN line (a crash mid-append) in the MIDDLE of the stream is
    // skipped by the ONE reader (clog_records); the records after it stand on
    // their own seq — the replication feed reaches the head and replay still
    // reconstructs the text. Before the seam events_since and the nexus folds
    // STOPPED at a torn line and lost every record after it, while replay
    // skipped it: two answers from one stream.
    long leT = clog_find(w);
    ui::text_insert(w, leT, ui::text_size(w, leT), "{\"seq\":0,\"kind\":\"spl\n");
    ed_text_insert(w, es, doc, 0, "Q");
    var evT;
    events_since(evT, w, 0, 0);
    long nT = php::count(evT);
    long lastT = nT > 0 ? evT[nT - 1]["seq"].as_integer() : -1;
    var rT;
    clog_replay(rT, w, doc, -1);
    var curT;
    ui::text(curT, w, doc);
    println("V6 torn-middle: feed-reaches-head={} replay={}",
	    lastT == clog_head(w, doc) ? 1 : 0, rT == curT ? "ok" : "FAIL");
    // The reader on a bare blob: the torn line is not a record; the ones
    // around it are.
    var tb = "{\"seq\":1,\"kind\":\"x\"}\n{\"seq\":2,\"ki\n{\"seq\":3,\"kind\":\"y\"}\n";
    var tr;
    clog_records_of(tr, tb);
    println("V6 torn-parse: records={} last={}", php::count(tr), tr[1]["seq"]);

    php::unlink(pathB);
    php::unlink(path);
    return 0;
}
