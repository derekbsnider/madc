// V4 (change event log), split arc 1D: madcide's change log IS the world's
// tool host's memory (ide_host: madc::tool_host — head / records / replay).
// A scripted edit sequence through ed_text_insert / ed_text_erase lands as
// the memory's records; replay reconstructs the buffer at any seq
// (round-trip + historical); the event:N history View is that replay on its
// own render buffer; a second document's records ride the same stream and
// replay apart; and the project's events file (proj_memory_bind, under the
// manifest's claim) takes the session's records when it is new and restores
// them into another session (the claim's record in the .env fixture's
// tmp/ sessions directory). Headless — no frontend. Snapshots capture the
// ACTUAL buffer text at each stage. The test removes what it creates.
#include "../tools/texteditor/editor_events.inc"
#include "../tools/madcide/madcide_core.inc"

void okfail(const char *label, bool cond, var got, var want)
{
    if ( cond )
        println("{}: ok", label);
    else
        println("{}: FAIL got[{}] want[{}]", label, got, want);
}

// The records of `doc` of one kind (clog_kind_of: the one reader).
long records_of(long w, long doc, long kind)
{
    var recs;
    ide_host(w)->records(recs, 0);
    long n = 0;
    for ( var r : recs )
    {
	var d;
	keyed_get(d, r, "doc");
	if ( !d.is_null() && d.as_integer() == doc && clog_kind_of(r) == kind )
	    n = n + 1;
    }
    return n;
}

int main()
{
    const char *path = "madc_ide_clog.mad";
    const char *pathB = "madc_ide_clog_b.mad";
    const char *manifest = "madc_ide_clog.prj.json";
    php::file_put_contents(path, "");
    php::file_put_contents(pathB, "b0\n");

    long w = ui::world_new();
    long doc = setup_document(w, path, false);
    long es = spawn_view_es(w, doc, path);
    madc::tool_host *host = ide_host(w);

    // Build the text through splices; snapshot ACTUAL text + seq at stages.
    ed_text_insert(w, es, doc, 0, "alpha");
    ed_text_insert(w, es, doc, 5, " beta");
    long segB = host->head();
    var snapB;
    ui::text(snapB, w, doc);
    ed_text_insert(w, es, doc, 10, " gamma");
    ed_text_erase(w, es, doc, 0, 6);			// drop "alpha "
    long segD = host->head();
    var snapD;
    ui::text(snapD, w, doc);
    ed_text_insert(w, es, doc, 0, "X");
    long segE = host->head();
    var snapE;
    ui::text(snapE, w, doc);
    ed_text_insert(w, es, doc, 0, "Z");
    var cur;
    ui::text(cur, w, doc);
    println("V4 splices: {}", records_of(w, doc, ckSPLICE));

    // Replay: the whole log round-trips to the live buffer, and any past
    // seq reconstructs the snapshot taken then.
    var rAll;
    host->replay(rAll, doc, 0);
    okfail("V4 replay-all", rAll == cur, rAll, cur);
    var rE;
    host->replay(rE, doc, segE);
    okfail("V4 replay@E", rE == snapE, rE, snapE);
    var rB;
    host->replay(rB, doc, segB);
    okfail("V4 replay@B", rB == snapB, rB, snapB);
    var rD;
    host->replay(rD, doc, segD);
    okfail("V4 replay@D", rD == snapD, rD, snapD);

    // event:N edit-history View: a View of the doc at a past revision
    // replays onto its own render buffer.
    long hv = make_history_view(w, es, doc, segE);
    var hvrow;
    view_row(hvrow, w, es, hv);
    var hvtext;
    ui::text(hvtext, w, hvrow["vbuf"].as_integer());
    okfail("V4 history-view@E", hvtext == snapE, hvtext, snapE);

    // ONE stream per session: a second document's records ride it, each
    // document's replay reads its own (the first edit records the baseline
    // checkpoint it starts from).
    long docB = setup_document(w, pathB, false);
    ed_text_insert(w, es, docB, 2, "-b1");
    ed_text_insert(w, es, docB, 0, ">");
    var curB;
    ui::text(curB, w, docB);
    var rBB;
    host->replay(rBB, docB, 0);
    okfail("L4c replay-doc-B", rBB == curB, rBB, curB);
    var rA;
    host->replay(rA, doc, 0);
    okfail("L4c replay-doc-A", rA == cur, rA, cur);
    println("L4c doc-B: splices={} checkpoints={}", records_of(w, docB, ckSPLICE),
	    records_of(w, docB, ckCHECKPOINT));

    // The project's events file: a manifest made mid-session takes the
    // session's records so far, then every new one.
    ui::set(w, es, "projfile", manifest);
    proj_memory_bind(w, es);
    ed_text_insert(w, es, doc, 0, "!");
    ui::text(cur, w, doc);
    var blob;
    php::file_get_contents(blob, "madc_ide_clog.prj.events");
    println("V4 persisted: {}", strlen(blob.c_str()) > 0 ? "ok" : "FAIL");

    // ... and another session restores from it: the records find their
    // documents by path, so its replay is this session's text.
    long w2 = ui::world_new();
    long doc2 = setup_document(w2, path, false);
    long es2 = spawn_view_es(w2, doc2, path);
    ui::set(w2, es2, "projfile", manifest);
    proj_memory_bind(w2, es2);
    var rr;
    ide_host(w2)->replay(rr, doc2, 0);
    okfail("V4 persist-restore", rr == cur, rr, cur);
    println("V4 restored-head: {}", ide_host(w2)->head() == host->head() ? "ok" : "FAIL");

    proj_claim->release();			// the manifest's claim: its record goes
    var dir;
    madc::session_dir(dir);
    php::rmdir(dir.c_str());
    php::unlink(path);
    php::unlink(pathB);
    php::unlink("madc_ide_clog.prj.events");
    return 0;
}
