// Nexus L4a: the git substrate's dialect face (git::*, the madcgit MODULE) over the repository
// the test runs in — every lane runs the suite from a checkout root, so the
// repository is always there; the assertions are SHAPE (never a sha or a count
// that history would move). Nothing here runs a guest program; stderr stays
// empty (.expect_quiet).
int main()
{
    long h = git::open(".");
    println("opened: {}", h > 0 ? 1 : 0);

    var hd;
    git::head(hd, h);
    println("head-sha-len: {}", strlen(hd["sha"].c_str()));
    println("head-has-branch-or-detached: {}",
	    strlen(hd["branch"].c_str()) > 0 || hd["detached"].as_boolean() ? 1 : 0);

    var rp;
    git::revparse(rp, h, "HEAD");
    var same = rp["sha"];
    println("revparse-head-matches: {}", same == hd["sha"] ? 1 : 0);

    var lg;
    git::log(lg, h, "VERSION", 5);
    println("log-rows-positive: {}", php::count(lg["rows"]) > 0 ? 1 : 0);
    var first = lg["rows"][0];
    println("log-row-shape: {}", strlen(first["sha"].c_str()) == 40
	    && strlen(first["summary"].c_str()) > 0 && first["when"].as_integer() > 0 ? 1 : 0);

    var sh;
    git::show(sh, h, "HEAD", "VERSION");
    var disk;
    php::file_get_contents(disk, "VERSION");
    var shown = sh["text"];
    println("show-matches-file: {}", shown == disk ? 1 : 0);

    var bl;
    git::blame(bl, h, "VERSION", 1, 1);
    println("blame-rows-positive: {}", php::count(bl["rows"]) > 0 ? 1 : 0);
    var b0 = bl["rows"][0];
    println("blame-row-shape: {}", b0["line"].as_integer() == 1
	    && strlen(b0["sha"].c_str()) == 40 ? 1 : 0);

    var dt;
    git::dirty(dt, h, "VERSION");
    println("dirty-is-bool: {}", dt["dirty"].is_boolean() ? 1 : 0);

    // L4b: the live-text blame and the canonical relative path
    var edited = format("{}an uncommitted line\n", disk);
    var bt;
    git::blame_text(bt, h, "VERSION", edited.c_str(), 1, 0);
    var last = bt["rows"][php::count(bt["rows"]) - 1];
    println("blame-text-rows-positive: {}", php::count(bt["rows"]) > 0 ? 1 : 0);
    println("blame-text-uncommitted-sha-empty: {}", strlen(last["sha"].c_str()) == 0 ? 1 : 0);
    var rp2;
    git::relpath(rp2, h, "tests/../tests/testgit.mad");
    var relp = rp2["path"];
    println("relpath: {}", relp == "tests/testgit.mad" ? 1 : 0);
    var rp3;
    git::relpath(rp3, h, "/");
    println("relpath-outside-error: {}", strlen(rp3["error"].c_str()) > 0 ? 1 : 0);

    // §7e: git status's rows (a file this test writes is untracked; the
    // state is a git::file_state code) and a file at HEAD against a text.
    php::file_put_contents("madc_testgit_probe.txt", "probe\n");
    var st;
    git::status(st, h);
    bool probe_untracked = false;
    for ( var r : st["rows"] )
	if ( r["path"] == "madc_testgit_probe.txt"
	     && r["worktree"] == git::file_state::untracked )
	    probe_untracked = true;
    php::unlink("madc_testgit_probe.txt");
    println("status-untracked-probe: {}", probe_untracked ? 1 : 0);
    println("status-workdir: {}", strlen(st["workdir"].c_str()) > 0 ? 1 : 0);
    var cm;
    git::commit(cm, h, "HEAD");
    var cmsha = cm["sha"];
    println("commit-head-matches: {}", cmsha == hd["sha"]
	    && strlen(cm["summary"].c_str()) > 0 ? 1 : 0);
    var df;
    git::diff(df, h, "HEAD", "VERSION", edited.c_str());
    var hk = df["hunks"][php::count(df["hunks"]) - 1];
    println("diff-adds-line: {}",
	    rust::contains(df["patch"].c_str(), "+an uncommitted line\n") != 0 ? 1 : 0);
    println("diff-hunk-shape: {}",
	    hk["new_lines"].as_integer() == hk["old_lines"].as_integer() + 1 ? 1 : 0);
    var unchanged;
    git::diff(unchanged, h, "HEAD", "VERSION", shown.c_str());
    println("diff-equal-empty: {}", strlen(unchanged["patch"].c_str()) == 0
	    && php::count(unchanged["hunks"]) == 0 ? 1 : 0);

    var bad;
    git::show(bad, h, "HEAD", "no/such/file.txt");
    println("missing-path-error: {}", strlen(bad["error"].c_str()) > 0 ? 1 : 0);
    var bad2;
    git::revparse(bad2, h, "no-such-ref-anywhere");
    println("bad-ref-error: {}", strlen(bad2["error"].c_str()) > 0 ? 1 : 0);

    println("closed: {}", git::close(h) ? 1 : 0);
    println("stale-after-close: {}", git::close(h) ? 0 : 1);
    var gone;
    git::head(gone, h);
    println("stale-handle-error: {}", strlen(gone["error"].c_str()) > 0 ? 1 : 0);
    println("nonrepo: {}", git::open("/") == 0 ? 1 : 0);
    return 0;
}
