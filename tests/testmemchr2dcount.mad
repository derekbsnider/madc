#!/usr/bin/env madc
#include <stdio.h>
#include <string.h>

static const char s4_2[2][4] = { "1234", "5678" };

int main()
{
	if (memchr(s4_2[1] + 3, 0, 1) == 0)
		printf("a\n");
	else
		printf("A\n");
	if (memchr(s4_2[1] + 3, 0, sizeof s4_2[1] - 3) == 0)
		printf("b\n");
	else
		printf("B\n");
	printf("%d\n", (int)(sizeof s4_2[1] - 3));
	return 0;
}
