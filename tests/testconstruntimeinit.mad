// A const object initialized at run time holds no parse-time value: reading it
// reads the object. madc folded every const-qualified variable read in a
// const-declared integer's initializer as a known constant — a variable
// carrying no value read as 0 — so `const int a = x; const int t = a;` gave
// t == 0 (also `a + 1`, `-a`, a cast of a). A const initialized from a
// constant still folds (K, L, M below — the whole constant expression, not
// only `+`/`-`); a sizeof of a VLA is a run-time value.
// Oracle: gcc 13.3 and clang 18.1 (-std=c11) print exactly the .expect lines.
#include <stdio.h>

static int chain(int x) { const int a = x; const int t = a; return t; }
static int sum(int x) { const int a = x; const int t = a + 1; return t; }
static int cparam(const int x) { const int t = x; return t; }
static int neg(int x) { const int a = x; const int t = -a; return t; }
static int cast(int x) { const int a = x; const long t = (long)a; return (int)t; }
static int g(void) { return 9; }

int main(void)
{
	const int G = g();
	const int H = G - 2;
	printf("runtime: %d %d %d %d %d %d\n", chain(3), sum(5), cparam(4), neg(7), cast(8), H);
	const int K = 4;
	const int L = K + 1;
	const int M = K * 3 - 1;
	int arr[L];
	printf("constant: %d %d %d\n", L, (int)sizeof(arr), M);
	int n = 5;
	int vla[n];
	const unsigned long s = sizeof(vla);
	const unsigned long st = sizeof(int[n + 1]);
	printf("vla: %lu %lu\n", s, st);
	return 0;
}
