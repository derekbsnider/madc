// Gate for the in-flight self-referential base-arg brand (task #71 chain):
// libc++'s allocator<T> derives from __non_trivial_if<..., allocator<T>>, so
// the base's arg is the enclosing instantiation itself. The pre-registration
// re-entry shell must read INCOMPLETE, not dependent — a dependent brand on
// the base outlived the instantiation and made every trait fold on
// allocator<int> refuse (is_trivially_destructible silently answered 0, which
// mis-selected __optional_destruct_base and killed optional/map under libc++).
// Oracle: clang++ -stdlib=libc++ prints "1 1".
#include <memory>
#include <type_traits>
#include <cstdio>

int main() {
  printf("%d %d\n",
    (int)std::is_trivially_destructible<int>::value,
    (int)std::is_trivially_destructible<std::allocator<int> >::value);
  return 0;
}
