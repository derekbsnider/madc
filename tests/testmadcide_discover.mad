// V6c-4, split arc 1D: SESSION DISCOVERY — the ADVERTISEMENT a client finds a
// running session by, so nobody has to be TOLD an address, on madc's
// discovery (madc::session_claim: a record held for the process's life under
// madcide's key `<root>#<pid>`). ⚠️ An advertisement, NOT a lock: madcide
// refuses no file; this publishes how to REACH a session and never excludes.
//
// This test holds a live session with a real listener — the `--serve` side —
// advertises it, and then spawns `madcide <file> --mcp --attach` with NO
// ADDRESS: the child must DISCOVER this session from the advertisement and
// drive it. Every answer must come from THIS process's session.
//
// The session directory is hermetic (testmadcide_discover.env pins
// MADC_SESSION_DIR), so the gate never writes into a developer's real state
// directory — and the spawned child inherits it, which is why it finds us.
#include "../tools/texteditor/editor_events.inc"
#include "../tools/madcide/madcide_core.inc"
#include "../tools/madcide/madcide_client.inc"
#include "../tools/madcide/madcide_api.inc"
#include "../tools/madcide/madcide_seat.inc"
#include "../tools/madcide/madcide_ws.inc"
#include "../tools/madcide/madcide_serve.inc"

void send(madc::channel &c, var &msg)
{
    var js = js::stringify(msg);
    var line = format("{}\n", js);
    c.write(line.c_str());
}

bool read_reply(var &out, madc::channel &c)
{
    var line;
    if ( !c.readline(line) )
	return false;
    return js::parse(out, line.c_str());
}

int main()
{
    const char *path = "madc_ide_disc.mad";
    php::file_put_contents(path,
	"long twice(long a)\n{\n\treturn a + a;\n}\n\nint main()\n{\n\treturn twice(21);\n}\n");

    // ---- the state directory the fixture pinned -------------------------
    var dir;
    madc::session_dir(dir);
    println("dir-hermetic: {}", perl::index(dir.c_str(), "madc_disc_sessions") >= 0 ? 1 : 0);

    // ---- the RUNNING session, listening and advertised ------------------
    IdeSession S;
    long doc = S.open(path, false);
    println("session: {}", doc > 0 ? 1 : 0);
    S.terminal(false);
    var endpoint;
    var why;
    long lh = serve_listen(S, doc, "127.0.0.1:0", endpoint, why);
    println("listening: {}", lh != 0 ? 1 : 0);

    var all;
    madc::session_scan(all);
    println("advertised: {}", all.size());
    var rec = all[0];
    var canon;
    madc::canonical_path(canon, path);
    var root;
    madc::canonical_path(root, ".");
    var key = format("{}#{}", root, madc::sys.pid);
    println("record-key: {}", rec["key"] == key ? 1 : 0);
    println("record-endpoint-is-bound: {}", rec["endpoint"] == endpoint ? 1 : 0);
    println("record-pid: {}", rec["pid"] == madc::sys.pid ? 1 : 0);
    println("record-documents: {}", rec["documents"][0] == canon ? 1 : 0);
    var url;
    session_url(url, endpoint);
    println("record-url: {}", rec["url"] == url ? 1 : 0);

    // ---- finding it ------------------------------------------------------
    var found;
    println("find-exact: {}", session_find_joinable(found, path) ? 1 : 0);
    println("find-exact-endpoint: {}", found["endpoint"] == endpoint ? 1 : 0);
    php::file_put_contents("madc_ide_disc_other.c", "\n");
    println("find-covered: {}", session_find_joinable(found, "madc_ide_disc_other.c") ? 1 : 0);
    php::unlink("madc_ide_disc_other.c");
    println("find-untitled: {}", session_find_joinable(found, "") ? 1 : 0);

    // ---- a client that was told NOTHING finds and drives this session -----
    var self = madc::compiler_path();
    var uri = format("exec://{} --no-config tools/madcide/madcide.mad {} --mcp --attach",
		     self, path);
    madc::channel relay(uri.c_str());
    println("relay-open: {}", relay.ok() ? 1 : 0);
    scope
    {
	madc::channel listener;
	listener.adopt(lh);
	listener.wait_readable();
	madc::channel client;
	listener.accept(client);
	long conn = client.detach();
	go serve_conn_task(&S, doc, conn);

	var init = { "jsonrpc": "2.0", "id": 1, "method": "initialize" };
	send(relay, init);
	var reply;
	read_reply(reply, relay);
	println("initialize: {}", reply["result"].is_null() ? 0 : 1);
	var none = {};
	var params = { "name": "graph.symbols", "arguments": none };
	var req = { "jsonrpc": "2.0", "id": 2, "method": "tools/call", "params": params };
	send(relay, req);
	read_reply(reply, relay);
	var syms;
	js::parse(syms, reply["result"]["content"][0]["text"].c_str());
	println("from-our-session: {}", syms["nodes"][0]["name"]);
	relay.close_write();
	var tail;
	while ( relay.readline(tail) )
	    ;
	relay.close();
	println("relay-exit-status: {}", relay.exit_status());
	listener.close();
    }

    // ---- withdrawn: nothing left to find ----------------------------------
    session_withdraw(S);
    madc::session_scan(all);
    println("scan-after: {}", all.size());
    S.close();
    php::unlink(path);
    php::rmdir(dir.c_str());
    println("done");
    return 0;
}
