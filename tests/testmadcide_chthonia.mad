// The chthonia profile (plan §41.11a step 1; plugins Stage A): the teaching
// bundle madcide ships, tools/madcide/plugins/chthonia — Thonny's keys,
// chthonia.layout (the editor, and below it the REPL as the visible panel's
// first tab with Problems beside it; the Variables view in the right
// sidebar), chthonia.menu (the
// beginner's subset of the command vocabulary) and chthonia.mad (its code,
// the Variables view). Pins:
//   1. `open(path, ro, "chthonia")` (the command line's --profile) loads the
//      shipped bundle: the runner's MADCIDE_CONFIG_DIR names no user
//      directory, so nothing overrides it;
//   2. its keys are Thonny's, and its layout shows the REPL, with no Outline,
//      Project or Terminal pane, and a sidebar;
//   3. the menu bar is File, Edit, Run, View, Tools, Help: Run's rows are
//      replrun (F5's), replstop and language, and there is no Build or
//      Window menu;
//   4. a REPL session is running at open, because the layout shows it;
//   5. the default profile, over the same file, starts none (its layout
//      keeps the REPL hidden) and keeps its own menu bar;
//   6. the toolbar (menu_place): chthonia.menu's `toolbar` rows are the
//      composed root's `toolbar` hint — New, Open, Save, a divider, Run (its
//      arrow dropping the Run menu down) and Stop, each with its picture and
//      command's code — and the default menu places none; Run's arrow
//      (`menushow Run`) lists the Run menu as a choice, an unknown menu is
//      said, and File ▸ New (`new`) opens the untitled buffer;
//   7. Tools ▸ Key bindings… (plan §41.11a step 3e): the six styles listed by
//      their @title names (JOE, Vim, Emacs, Pico, Thonny, VS Code) with the
//      current one, Thonny, marked; choosing VS Code rebinds and keeps it
//      for this bundle in settings.json (this test's configuration
//      directory, its .env), so the next chthonia session opens with it
//      while the default bundle keeps its own keys;
//   8. the Variables view (plan §41.11a step 6), its code activated from
//      source: after F5 on §34's program plus a global its rows read
//      `count int 3` and `square int (int)`; choosing `square` moves the
//      caret to its line; an entry `int y = 7;` adds its row; Stop empties
//      the view;
//   9. the same, its code activated from the library --build-plugin built
//      (a copy of the bundle in this test's configuration directory, which
//      the search path puts first).
//  10. View ▸ Outline and Tools ▸ Options (§7a Thonny parity): the View and
//      Tools menus list them; outline shows in the sidebar beside Variables
//      (the file's main) and toggles back; options opens and closes its pane.
//  11. Edit ▸ Clear shell (`replclear`, Thonny's Ctrl+L), in pins 8-9's
//      session: the transcript had text and is empty; the session is live
//      and the Variables rows stay.
#include "../tools/texteditor/lined_core.inc"
#include "../tools/texteditor/editor_events.inc"
#include "../tools/madcide/madcide_core.inc"

#include "madcide_repl_drive.inc"	// ev_*, settle, enter_line

// The menu bar's titles, space-separated, and the named menu's command ids.
void menu_bar(var &titles, var &ids, long w, long es, const char *menu)
{
    var md;
    ui::get(md, w, es, "menudef");
    titles = "";
    ids = "";
    for ( var m : md )
    {
	var t = m["title"];
	if ( m["place"].as_integer() != mpBAR )
	    continue;
	if ( strlen(titles.c_str()) == 0 )
	    titles = t;
	else
	    titles = format("{} {}", titles, t);
	if ( t == menu )
	    for ( var it : m["items"] )
	    {
		var id = it["id"];
		if ( strlen(ids.c_str()) == 0 )
		    ids = id;
		else
		    ids = format("{} {}", ids, id);
	    }
    }
}

// The composed root's toolbar hint: each row's label=action:icon (the
// icon's name, ui::icon_name) and >menu when its arrow drops a menu down, a
// divider as `|`, and whether every row's code is its action's (cmd_of);
// "none" without a toolbar.
void toolbar_rows(var &out, IdeSession &S, long doc)
{
    var root;
    S.compose_ide_tree(root, doc);
    var tb = root["hints"]["toolbar"];
    if ( tb.is_null() )
    {
	out = "none";
	return;
    }
    out = "";
    long ok = 1;
    for ( var r : tb )
    {
	if ( !r["sep"].is_null() )
	{
	    out = format("{}| ", out);
	    continue;
	}
	var ic = "";
	if ( !r["icon"].is_null() )
	    ic = format(":{}", ui::icon_name(r["icon"].as_integer()));
	var dr = "";
	if ( !r["drop"].is_null() )
	    dr = format(">{}", r["drop"]["arg"]);
	out = format("{}{}={}{}{} ", out, r["label"], r["action"], ic, dr);
	var a = r["action"];
	if ( r["code"].as_integer() != cmd_of_w(S.w, a.c_str()) )
	    ok = 0;
    }
    out = format("{}codes={}", out, ok);
}

// The Variables view's rows as its pane composes them, `|`-separated.
void variables_rows(var &out, IdeSession &S, long doc)
{
    var vn = "variables";
    long kind = view_of_w(S.w, vn);
    var cur;
    layout_get(cur, S.w, S.es);
    long tab = -1;
    long ci = chrome_hosting(cur, kind, tab);
    if ( ci < 0 )
    {
	out = "unhosted";
	return;
    }
    var pane;
    compose_chrome_pane(pane, S.w, S.es, doc, cur["chrome"][ci]);
    out = "";
    for ( var it : pane["children"][0]["children"] )
	out = format("{}{}|", out, it["content"]);
}

// Pins 8-9 over one session: F5, a row chosen, an entry, Stop.
void variables_gate(IdeSession &S, long doc, const char *label)
{
    long w = S.w;
    long es = S.es;
    ui::text_load(w, doc, "#include <stdio.h>\n"
	"int count = 3;\n"
	"int square(int n) { return n * n; }\n"
	"int main() { printf(\"%d\\n\", square(5)); }\n");
    var e;
    ev_action(e, "replrun", "f5");
    S.apply_ide_event(doc, e);
    settle(w, es, false);
    var got;
    variables_rows(got, S, doc);
    println("{}-f5: [{}]", label, got);
    var vn = "variables";
    long kind = view_of_w(w, vn);
    var rows;
    ui::get(rows, w, es, "chthonia.vars");
    long opt = 0;
    long i = 1;
    for ( var r : rows )
    {
	if ( rust::starts_with(r["content"].c_str(), "square ") != 0 )
	    opt = i;
	i = i + 1;
    }
    ui::set(w, es, "caret", 0);
    var ch = { "event": "choose", "event_code": ui::event_kind::choose,
	       "option": opt, "action": "", "action_code": view_row_cmd(kind) };
    S.apply_ide_event(doc, ch);
    println("{}-goto: square-line={}", label,
	    es_int(w, es, "caret", -1) == caret_to_line(w, doc, 3, 0) ? 1 : 0);
    enter_line(S, doc, w, es, "int y = 7;");
    variables_rows(got, S, doc);
    println("{}-entry: [{}]", label, got);
    // Edit ▸ Clear shell (`replclear`, §7a; Thonny's Ctrl+L): the transcript
    // empties, the session and its names stay.
    var tbefore;
    ui::text(tbefore, w, repl_doc_if_any(w, es));
    ev_action(e, "replclear", "primary+l");
    S.apply_ide_event(doc, e);
    var tafter;
    ui::text(tafter, w, repl_doc_if_any(w, es));
    variables_rows(got, S, doc);
    println("{}-clear: had-text={} empty={} live={} rows=[{}]", label,
	    strlen(tbefore.c_str()) > 0 ? 1 : 0, strlen(tafter.c_str()) == 0 ? 1 : 0,
	    es_int(w, es, "repllive", 0), got);
    ev_action(e, "replstop", "");
    S.apply_ide_event(doc, e);
    settle(w, es, false);
    variables_rows(got, S, doc);
    println("{}-stop: [{}]", label, got);
}

int main()
{
    const char *path = "madc_ide_chthonia.c";
    php::file_put_contents(path, "int main(void) { return 0; }\n");
    var cfg0;			// a run that stopped early left its choice
    madcide_config_dir(cfg0);
    php::unlink(format("{}/settings.json", cfg0));

    // 1-4. The chthonia profile.
    IdeSession S;
    long doc = S.open(path, false, "chthonia");
    var b;
    ui::get(b, S.w, S.es, "bundle");
    var k;
    ui::get(k, S.w, S.es, "profile");
    println("chthonia-open: doc={} bundle={} keys={}", doc > 0 ? 1 : 0, b, k);
    println("chthonia-views: repl={} problems-tab={} outline={} project={} terminal={} sidebar={}",
	    view_shown(S.w, S.es, repl_view(S.w)) ? 1 : 0,
	    view_shown(S.w, S.es, viewPROBLEMS) ? 1 : 0,
	    view_shown(S.w, S.es, viewOUTLINE) ? 1 : 0,
	    view_shown(S.w, S.es, viewPROJECT) ? 1 : 0,
	    view_shown(S.w, S.es, viewTERMINAL) ? 1 : 0,
	    slot_shown(S.w, S.es, slotSIDEBAR) != viewNONE ? 1 : 0);
    var titles;
    var ids;
    menu_bar(titles, ids, S.w, S.es, "Run");
    println("chthonia-menu: [{}] run=[{}]", titles, ids);
    long h = es_int(S.w, S.es, "replh", 0);
    println("chthonia-repl: live={} running={}", es_int(S.w, S.es, "repllive", 0),
	    h != 0 && madc::session_running(h) ? 1 : 0);
    // View ▸ Outline and Tools ▸ Options (§7a Thonny parity): the View menu
    // lists outline and Tools lists options; `outline` shows the outline in
    // the sidebar beside Variables (the file's main), again hides it and the
    // sidebar shows Variables again; `options` opens the Options pane.
    var vtitles;
    var vids;
    menu_bar(vtitles, vids, S.w, S.es, "View");
    var ttitles;
    var tids;
    menu_bar(ttitles, tids, S.w, S.es, "Tools");
    bool oc = true;
    S.command(doc, cmdOUTLINE, "", oc);
    long side1 = slot_shown(S.w, S.es, slotSIDEBAR);
    var orows;
    ui::get(orows, S.w, S.es, "outline");
    var onames = "";
    for ( var orow : orows )
	onames = format("{}[{}]", onames, orow["name"]);
    S.command(doc, cmdOUTLINE, "", oc);
    long side2 = slot_shown(S.w, S.es, slotSIDEBAR);
    S.command(doc, cmdOPTIONS, "", oc);
    long optshown = cur_pane(S.w, S.es) == paneOPTIONS ? 1 : 0;
    S.command(doc, cmdOPTIONS, "", oc);
    println("chthonia-outline: view=[{}] tools=[{}] shown={} rows={} hidden={} sidebar-back={} options={} closed={}",
	    vids, tids, side1 == viewOUTLINE ? 1 : 0, onames,
	    view_shown(S.w, S.es, viewOUTLINE) ? 0 : 1,
	    side2 != viewNONE && side2 != viewOUTLINE ? 1 : 0,
	    optshown, cur_pane(S.w, S.es) == paneNONE ? 1 : 0);
    var tbr;
    toolbar_rows(tbr, S, doc);
    println("chthonia-toolbar: {}", tbr);
    // Run's arrow (`menushow Run`): the Run menu's items as a choice list;
    // an unknown menu is said. File ▸ New: the untitled buffer.
    bool mc = true;
    S.command(doc, cmdMENUSHOW, "Run", mc);
    var mrows;
    ui::get(mrows, S.w, S.es, "choicerows");
    var mtitles = "";
    for ( var mr : mrows )
	mtitles = format("{}[{}]", mtitles, mr["title"]);
    var mlabel;
    ui::get(mlabel, S.w, S.es, "choicelabel");
    println("chthonia-dropdown: pane={} label={} rows={}", pane_name(cur_pane(S.w, S.es)),
	    mlabel, mtitles);
    set_pane(S.w, S.es, paneNONE);
    S.command(doc, cmdMENUSHOW, "Debug", mc);
    var mmsg;
    ui::get(mmsg, S.w, S.es, "msg");
    println("chthonia-dropdown-unknown: {}", mmsg);
    S.command(doc, cmdNEW, "", mc);
    long nd = S.active(0);
    println("chthonia-new: untitled={} differs={}", doc_untitled(S.w, nd) ? 1 : 0, nd != doc ? 1 : 0);
    switch_buffer(S.w, S.es, nd, 0);	// back to the launch file for the pins below

    // 7. Tools ▸ Key bindings….
    menu_bar(titles, ids, S.w, S.es, "Tools");
    bool lc = true;
    S.command(doc, cmdKEYSTYLE, "", lc);
    var ktree;
    S.compose_ide_tree(ktree, doc);
    var ktext;
    ui::render_tree(ktext, S.w, ktree);
    const char *kt = ktext.c_str();
    println("keystyle-list: tools=[{}] listed={} marked={}", ids,
	    rust::contains(kt, "Key bindings") != 0 && rust::contains(kt, "Emacs") != 0
	    && rust::contains(kt, "JOE") != 0 && rust::contains(kt, "Vim") != 0
	    && rust::contains(kt, "Pico") != 0 && rust::contains(kt, "Chthonia") != 0
	    && rust::contains(kt, "VS Code") != 0,
	    rust::contains(kt, "Chthonia  (current)") != 0);
    var kch = { "event": "choose", "event_code": ui::event_kind::choose,
		"option": 6, "action": "", "action_code": cmdCHOICE };
    S.apply_ide_event(doc, kch);
    var msg;
    ui::get(msg, S.w, S.es, "msg");
    ui::get(k, S.w, S.es, "profile");
    var cfg;
    madcide_config_dir(cfg);
    var spath = format("{}/settings.json", cfg);
    var kept;
    var why;
    json_object_read(kept, why, spath);
    println("keystyle-choose: keys={} msg={} kept={}", k, msg, kept["keys"]["chthonia"]);

    // 8. The Variables view, its code from source.
    println("variables-code: transport-source={}",
	    plugin_active_transport(S.w, "chthonia") == ptSOURCE ? 1 : 0);
    variables_gate(S, doc, "variables");
    S.close();

    IdeSession S2;
    S2.open(path, false, "chthonia");
    ui::get(k, S2.w, S2.es, "profile");
    println("keystyle-reopen: keys={}", k);
    S2.close();

    // 5. The default profile over the same file.
    IdeSession D;
    D.open(path, false);
    ui::get(b, D.w, D.es, "bundle");
    menu_bar(titles, ids, D.w, D.es, "Run");
    println("default-open: bundle={} repl-shown={} live={} replh={}", b,
	    view_shown(D.w, D.es, repl_view(D.w)) ? 1 : 0, es_int(D.w, D.es, "repllive", 0),
	    es_int(D.w, D.es, "replh", 0));
    println("default-menu: [{}]", titles);
    toolbar_rows(tbr, D, D.active(0));
    println("default-toolbar: {}", tbr);
    ui::get(k, D.w, D.es, "profile");
    println("keystyle-default: keys={}", k);
    D.close();

    // 9. The same from the library --build-plugin built, in a copy of the
    // bundle that the search path finds first.
    var pdir = format("{}/plugins", cfg);
    var bdir = format("{}/chthonia", pdir);
    php::mkdir(pdir.c_str());
    php::mkdir(bdir.c_str());
    var shipped;
    plugin_find(shipped, "chthonia");
    var parts = { "chthonia.plugin", "chthonia.layout", "chthonia.menu", "chthonia.mad" };
    for ( var f : parts )
    {
	var text;
	php::file_get_contents(text, format("{}/{}", shipped, f));
	php::file_put_contents(format("{}/{}", bdir, f), text.c_str());
    }
    var bwhy;
    var brows;
    bool built = plugin_build(bwhy, brows, bdir.c_str());
    IdeSession L;
    long ldoc = L.open(path, false, "chthonia");
    if ( built )
	bwhy = "";		// the library's path: its suffix is the platform's
    println("variables-lib: built={}{} transport-library={}", built ? 1 : 0, bwhy,
	    plugin_active_transport(L.w, "chthonia") == ptLIBRARY ? 1 : 0);
    variables_gate(L, ldoc, "variables-lib");
    L.close();
    for ( var f : parts )
	php::unlink(format("{}/{}", bdir, f));
    var lib;
    var vb = bdir;
    plugin_library_path(lib, vb, "chthonia");
    php::unlink(lib.c_str());
    php::rmdir(bdir.c_str());
    php::rmdir(pdir.c_str());

    php::unlink(spath.c_str());
    php::rmdir(cfg.c_str());
    php::unlink(path);
    return 0;
}
