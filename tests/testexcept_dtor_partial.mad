#!/usr/bin/env madc
#include <stdio.h>

class Foo
{
	int x;

	Foo(int v)
	{
		x = v;
		printf("Foo(%d)\n", x);
	}
	~Foo()
	{
		printf("~Foo(%d)\n", x);
	}
};

void thrower()
{
	throw 42;
}

int main()
{
	try {
		Foo a(1);
		Foo b(2);
		thrower();
		Foo c(3);
	}
	catch ( int e ) {
		printf("caught: %d\n", e);
	}
	printf("done\n");
	return 0;
}
