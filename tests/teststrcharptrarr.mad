#include <iostream>
using namespace std;
// Storing a string literal into a `char *` array element used to
// write the std::string object's address into the slot instead of
// its c_str() pointer. TokenAssign's ttSubscript path compiled the
// RHS without applying the same dtSTRING → char* coercion that the
// plain `char *p = "literal";` path already does.

#include <stdio.h>
#include <string.h>

int main()
{
    char *names[3];
    names[0] = "alice";
    names[1] = "bob";
    names[2] = "charlie";

    int i;
    for (i = 0; i < 3; i++)
	printf("%d: %s\n", i, names[i]);

    // find one via strcmp (also exercises the strcmp return sign-extend)
    int idx = -1;
    for (i = 0; i < 3; i++)
    {
	if (strcmp(names[i], "bob") == 0) { idx = i; break; }
    }
    printf("idx=%d\n", idx);

    return 0;
}
