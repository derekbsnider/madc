#include <string>
#include <ns_madc>
#include <stdio.h>
#include <stdlib.h>

int main(int argc, char **argv)
{
    const char *madc_bin = getenv("MADC_BIN");
    const char *child_source = argc > 1 ? argv[1] : "tests/testexecchild.mad";
    if ( !madc_bin || !*madc_bin )
        madc_bin = "bin/madc";
    char child_uri[1024];
    snprintf(child_uri, sizeof(child_uri), "exec://%s --no-config %s",
             madc_bin, child_source);

    // The lane's own madc is the child: always present, locale-free, and the
    // same artifact in hosted, packed, JIT, EXE, and OBJ runs.
    madc::channel child(child_uri);
    if ( !child.ok() )
    {
        printf("open failed: %s\n", child.last_error());
        return 1;
    }
    child.write("pear\n");
    string fruit = "apple\nmango\n";
    child.write(fruit);
    child.close_write();

    string line;
    while ( child.readline(line) )
        printf("received: %s\n", line.c_str());
    child.close();

    // A spawn that cannot succeed fails loudly, not silently.
    madc::channel missing("exec:///nonexistent/no-such-tool");
    if ( !missing.ok() )
        printf("missing: refused\n");

    printf("done\n");
    return 0;
}
