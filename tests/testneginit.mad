// `TokenNeg::compile()` computed `-rhs` into a temp register when the
// caller's destination was Mem, then forgot to mirror the result back
// — so `int a = -2;` left `a` at 0. Separately, `parseExpression`'s
// conditional-end-at-`)` shortcut returned without flushing the
// operator stack, so `-(2)` lost the pending unary `-` on the way out.

#include <stdio.h>

int main()
{
    int a = -2;
    int b = -1;
    int c = -100;
    printf("a=%d b=%d c=%d\n", a, b, c);

    int d;
    d = -7;
    printf("d=%d\n", d);

    int e = -(2);
    int f = -(3 + 4);
    printf("e=%d f=%d\n", e, f);

    int g = 0 - 2;
    int h = -0;
    printf("g=%d h=%d\n", g, h);

    // narrow signed types go through the same safemov(Mem, Gp) path —
    // make sure the mirror honours the narrow stack slot size.
    short int sv = -1;
    int branch = 0;
    if (sv < 0) { branch = 1; sv = sv + 1; }
    printf("sv=%d branch=%d\n", (int)sv, branch);

    signed char cv = -5;
    printf("cv=%d\n", (int)cv);

    return 0;
}
