#!/usr/bin/env madc
#include <stdio.h>

class Foo
{
	int x;

	Foo(int v)
	{
		x = v;
		printf("Foo(%d)\n", x);
	}
	~Foo()
	{
		printf("~Foo(%d)\n", x);
	}
};

int main()
{
	try {
		Foo a(1);
		try {
			Foo b(2);
			throw 42;
		}
		catch ( int e ) {
			printf("inner caught: %d\n", e);
		}
		printf("after inner\n");
	}
	catch ( int e ) {
		printf("outer caught: %d\n", e);
	}
	printf("done\n");
	return 0;
}
