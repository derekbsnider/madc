#include <iostream>
#include <sstream>

int main()
{
    std::cout << std::hex << 255 << std::dec << " " << 255 << std::oct << " " << 64 << std::endl;
    std::cout << std::fixed << 1.5 << std::endl;
    std::ostringstream os;
    os << std::hex << 48879;
    std::cout << os.str() << std::endl;
    return 0;
}
