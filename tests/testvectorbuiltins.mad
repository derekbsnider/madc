/* The vector builtins c2mir implements: __builtin_convertvector(v, T) (gcc
   9+, clang) converts lane by lane to the vector type T;
   __builtin_shufflevector(a, b, i...) (clang, gcc 12+) picks lanes of a and b
   by constant index into a vector of one lane per index; __builtin_shuffle(a[,
   b], mask) (gcc only) picks them by a mask vector. madc refused all three:
   the type-name operand of convertvector was read as an expression ("use of
   undeclared identifier 'v4ui'").
   Oracle: gcc 13.3 (-std=gnu11) prints the .expect lines; clang 18.1 prints
   all but the shuffle line (it has no __builtin_shuffle). */
#include <stdio.h>

typedef int v4si __attribute__ ((vector_size (16)));
typedef unsigned int v4ui __attribute__ ((vector_size (16)));
typedef float v4sf __attribute__ ((vector_size (16)));
typedef double v2df __attribute__ ((vector_size (16)));
typedef long long v2di __attribute__ ((vector_size (16)));
typedef int v2si __attribute__ ((vector_size (8)));
typedef int v8si __attribute__ ((vector_size (32)));

int main(void)
{
	v4si neg = { -1, 0, 1, 2 };
	v4si a = { 1, 2, 3, 4 };
	v4si b = { 10, 20, 30, 40 };
	v4sf half = { 1.5f, -2.5f, 3.75f, 0.25f };
	v2di li = { -3, 4 };
	v4ui uc = __builtin_convertvector (neg, v4ui);
	v4sf vf = __builtin_convertvector (neg, v4sf);
	v4si back = __builtin_convertvector (half, v4si);
	v2df d = __builtin_convertvector (li, v2df);
	v4si sv = __builtin_shufflevector (a, b, 0, 5, 2, 7);
	v2si small = __builtin_shufflevector (a, b, 3, 4);
	v8si wide = __builtin_shufflevector (a, b, 0, 4, 1, 5, 2, 6, 3, 7);
	printf("convert: %u %u %g %g %d %d %g %g\n", uc[0], uc[3], vf[0], vf[3],
	       back[1], back[2], d[0], d[1]);
	printf("shufflevector: %d %d %d %d | %d %d | %d %d %d %d\n", sv[0], sv[1],
	       sv[2], sv[3], small[0], small[1], wide[0], wide[1], wide[6], wide[7]);
	printf("size: %d %d\n", (int)sizeof (__builtin_shufflevector (a, b, 3, 4)),
	       (int)sizeof wide);
#ifndef __clang__
	{
		v4si m1 = { 3, 2, 1, 0 };
		v4si m2 = { 0, 5, 2, 7 };
		v4si s1 = __builtin_shuffle (a, m1);
		v4si s2 = __builtin_shuffle (a, b, m2);
		printf("shuffle: %d %d %d %d | %d %d %d %d\n", s1[0], s1[1], s1[2],
		       s1[3], s2[0], s2[1], s2[2], s2[3]);
	}
#endif
	return 0;
}
