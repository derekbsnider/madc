/* gcc -std=c99 and clang -std=c99 print a:6 b:7 c:3 d:12 sz:12
 *
 * A K&R parameter declaration (`int f(a, b) int a[2][3]; int (*b)(int); {`)
 * is a parameter-declaration: its declarator adjusts per C11 6.7.6.3p7/p8 —
 * `int a[2][3]` is `int (*)[3]` (ONE pointer level, the trailing extent
 * kept: sizeof(a[1]) is 12), `int d(int)` a pointer to function. One
 * reader — Program::parse_declarator, Parameter mode; the K&R copy skipped
 * each `[N]` with a hand-rolled depth counter and made EVERY dimension a
 * pointer level, so a[1][2] read through `int **` was garbage.
 */
extern int printf(const char *, ...);
extern unsigned long strlen(const char *);

int add1(int v) { return v + 1; }

int f(a, b, c, d)
    int a[2][3];
    int (*b)(int);
    char *c[];
    int d(int);
{
    printf("a:%d b:%d c:%d d:%d sz:%d\n", a[1][2], b(6), (int)strlen(c[1]), d(11),
	   (int)sizeof(a[1]));
    return 0;
}

int main()
{
    int m[2][3] = {{1, 2, 3}, {4, 5, 6}};
    char *words[2] = {"x", "abc"};
    return f(m, add1, words, add1);
}
