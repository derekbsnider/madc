#!/../bin/madc
// php::print_r over madc AGGREGATES — structs, classes, unions, arrays.
// (docs/plans/2026-08-17-php-print-r-var-dump-plan.md, slice "the type walk")
//
// The dumper is a PROJECTION of DataDefSTRUCT — the one aggregate-layout owner.
// It never computes an offset, a size or an alignment: members are read as
// `obj.member` through the emitted struct, so bitfields, anonymous aggregates
// and base-flattened members all resolve through the SAME lowering the rest of
// the compiler uses.
//
// ORACLE — php-cli 8.3.6 on tmp/or_pr3.php, whose classes carry the same
// property names and values, prints EXACTLY the Point / Outer / Arr / Foo /
// Derived / Array blocks below (verified line for line, including the 8-space
// step of a nested "(", the blank line that follows a nested block, PHP's
// "[prot:protected]" and "[priv:Foo:private]" spellings, and base-first
// ordering for an inherited member).
//
// The last three cases are C shapes PHP cannot express, so they follow the same
// PHP rules over the C truth:
//   - a bit-field prints its VALUE (the width belongs in var_dump's type word);
//   - an anonymous union's members are named directly, as C names them;
//   - a union prints EVERY member's interpretation of the same storage, since C
//     offers no active-member truth (0x41424344 little-endian reads as "DCBA");
//   - a char array is TEXT, bounded by its extent — what a PHP developer
//     expects of a string, and what C guarantees is safe to read.
#include <iostream>
#include <ns_php>

struct Point { int x; int y; };
struct Outer { Point p; int n; };
struct Arr   { int v[3]; char name[8]; };

class Foo {
public:
	int pub;
	int s;
protected:
	int prot;
private:
	int priv;
public:
	void fill() { pub = 1; s = 2; prot = 3; priv = 4; }
};

class Base {
public:
	int bx;
protected:
	int bprot;
};

class Derived : public Base {
public:
	int dy;
	void fill() { bx = 1; bprot = 2; dy = 3; }
};

struct Bits {
	unsigned int a : 3;
	unsigned int b : 5;
	int c;
};

struct Anon {
	int tag;
	union {
		int i;
		unsigned int u;
	};
};

union U {
	int i;
	char c[4];
};

int main()
{
	Point pt;
	pt.x = 1;
	pt.y = 2;
	php::print_r(pt);
	std::cout << "===" << std::endl;

	Outer o;
	o.p.x = 7;
	o.p.y = 8;
	o.n = 5;
	php::print_r(o);
	std::cout << "===" << std::endl;

	Arr ar;
	ar.v[0] = 10;
	ar.v[1] = 20;
	ar.v[2] = 30;
	ar.name[0] = 'h';
	ar.name[1] = 'i';
	ar.name[2] = 0;
	php::print_r(ar);
	std::cout << "===" << std::endl;

	Foo f;
	f.fill();
	php::print_r(f);
	std::cout << "===" << std::endl;

	Derived d;
	d.fill();
	php::print_r(d);
	std::cout << "===" << std::endl;

	int raw[3];
	raw[0] = 1;
	raw[1] = 4;
	raw[2] = 9;
	php::print_r(raw);
	std::cout << "===" << std::endl;

	Bits bt;
	bt.a = 5;
	bt.b = 17;
	bt.c = -3;
	php::print_r(bt);
	std::cout << "===" << std::endl;

	Anon an;
	an.tag = 1;
	an.i = 42;
	php::print_r(an);
	std::cout << "===" << std::endl;

	U u;
	u.i = 0x41424344;
	php::print_r(u);
	std::cout << "===" << std::endl;
	return 0;
}
