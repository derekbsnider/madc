// --no-posix-compat suppresses the Win64 supplement while leaving the real
// platform header available.
#include <stdio.h>
#include <string.h>

#if __has_include(<posix/string.h>)
#error compiler-internal POSIX supplement key is publicly includable
#endif

#ifdef _WIN32
#ifndef _INC_STRING
#error disabling POSIX compatibility also hid the real MinGW string.h
#endif
#endif

int main()
{
#ifdef __MADC_POSIX_STRING_H
	printf("supplement\n");
#else
	printf("native\n");
#endif
	return 0;
}
