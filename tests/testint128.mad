// Real 16-byte __int128 / unsigned __int128 (P0 wide-integer work).
// Output verified against gcc -O0 (tmp/int128.c oracle shape).
#include <stdio.h>

static unsigned __int128 add1(unsigned __int128 x) { return x + 1; }

int main()
{
    __int128 a = 1;
    a <<= 100;
    __int128 b = a + 5;
    unsigned __int128 u = (unsigned __int128)0 - 1;
    printf("sizeof=%d %d\n", (int)sizeof(__int128), (int)sizeof(unsigned __int128));
    printf("hi=%llu lo=%llu\n", (unsigned long long)(b >> 64), (unsigned long long)b);
    printf("uhi=%llu ulo=%llu\n", (unsigned long long)(u >> 64), (unsigned long long)u);
    __int128 neg = -1;
    printf("neg_hi=%llx neg_lo=%llx\n", (unsigned long long)((unsigned __int128)neg >> 64), (unsigned long long)neg);
    __int128 m = (__int128)1234567890123456789LL * 97;
    printf("m_hi=%llu m_lo=%llu\n", (unsigned long long)((unsigned __int128)m >> 64), (unsigned long long)m);
    __int128 d = m / 97;
    printf("d=%lld\n", (long long)d);
    if (u > (unsigned __int128)a)
        printf("cmp_ok\n");
    // params/returns, inc/dec, compound, truthiness, float conversions
    unsigned __int128 r = add1((unsigned __int128)41);
    ++r;
    r *= 3;
    if (r)
        printf("r=%llu\n", (unsigned long long)r);
    double fd = (double)a;
    __int128 back = (__int128)fd;
    printf("fd_ok=%d\n", (int)(back == a));
    // overflow builtins at 128 bits
    unsigned __int128 ov;
    int flag = __builtin_mul_overflow((unsigned char)4, -16, &ov);
    printf("ov_lo=%lld flag_is_int=%d\n", (long long)ov, flag == 0 || flag == 1);
    // switch on __int128 with 64-bit case labels
    switch (d) {
    case 1234567890123456789LL: printf("switch_ok\n"); break;
    default: printf("switch_bad\n"); break;
    }
    // case labels beyond 64 bits (P0 slice 3: the constant fold runs at
    // 128-bit precision; output verified against gcc AND clang -O0,
    // tmp/wide_case.c oracle)
    switch (b) {
    case (((__int128)1 << 100) + 5): printf("wide_switch_ok\n"); break;
    case ((__int128)1 << 99): printf("wide_switch_99\n"); break;
    default: printf("wide_switch_bad\n"); break;
    }
    // negative wide case label
    switch (-b) {
    case -(((__int128)1 << 100) + 5): printf("wide_neg_ok\n"); break;
    default: printf("wide_neg_bad\n"); break;
    }
    // unsigned wide: (unsigned __int128)-1 == 2^128-1
    switch (u) {
    case (unsigned __int128)-1: printf("wide_u_ok\n"); break;
    default: printf("wide_u_bad\n"); break;
    }
    // __int128_t / __uint128_t: GCC/clang predefine these typedefs (no
    // header) for (unsigned) __int128. Regression: previously rejected as
    // an unknown type BOTH as a struct member ("Expecting type in struct
    // definition, got '__int128_t'") and as a local ("use of undeclared
    // identifier"). Values verified against gcc -O0.
    struct W128 { __int128_t s; __uint128_t u; };
    struct W128 w;
    w.s = (__int128_t)1 << 100;
    w.u = (__uint128_t)-1;
    printf("t_shi=%llu t_slo=%llu\n", (unsigned long long)(w.s >> 64), (unsigned long long)w.s);
    printf("t_uhi=%llu t_ulo=%llu\n", (unsigned long long)(w.u >> 64), (unsigned long long)w.u);
    __int128_t tl = w.s + w.s;
    printf("t_dbl_hi=%llu\n", (unsigned long long)((unsigned __int128)tl >> 64));
    return 0;
}
