// __TIMESTAMP__ is the date and time of the last modification of the
// CURRENT source file, in local time, spelled as asctime spells it
// ("Ddd Mmm dd hh:mm:ss yyyy", the day space-padded). The program checks it
// against its own source file's stat(2) mtime through asctime(localtime()).
// Oracles: gcc 13 and clang 18, -std=gnu17, compiled and run from the same
// directory: the lines below. madc before the fix: "use of undeclared
// identifier '__TIMESTAMP__'".
#include <stdio.h>
#include <string.h>
#include <time.h>
#include <sys/stat.h>

int main(void)
{
	static const char stamp[] = __TIMESTAMP__;
	struct stat st;
	char want[32] = "";
	if ( stat(__FILE__, &st) == 0 )
	{
		strncpy(want, asctime(localtime(&st.st_mtime)), sizeof want - 1);
		want[strcspn(want, "\n")] = '\0';
	}
	printf("size: %d\n", (int)sizeof stamp);
	if ( strcmp(stamp, want) == 0 )
		printf("source mtime: match\n");
	else
		printf("source mtime: [%s] vs [%s]\n", stamp, want);
#ifdef __TIMESTAMP__
	printf("defined: 1\n");
#else
	printf("defined: 0\n");
#endif
	return 0;
}
