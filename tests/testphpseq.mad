#!/../bin/madc
// php::print_r / php::var_dump over POSITIONAL CONTAINERS — the owner's own two
// examples: "a std::vector<int> would display its contents the same way in php a
// print_r() of an array of integers would display, and a std::string would
// display a string".
//
// Both fall out of ONE structural test — the type-checked size()+operator[]
// predicate the range-for shares — plus the element type: a sequence whose
// element is a character type is TEXT, anything else is an ARRAY. No method is
// matched by name (no c_str, no length): a name match is exactly the weakness
// that made `for (int v : map)` SIGSEGV.
//
// ORACLE — php-cli 8.3.6 on tmp/or_seq.php. Every print_r block below is
// IDENTICAL to PHP's for the corresponding PHP value:
//   print_r([1,4,9])        -> Array ( [0] => 1 [1] => 4 [2] => 9 )
//   print_r("hi")           -> hi
//   print_r(Person)         -> Person Object ( [name] => alice [age] => 30 )
//   print_r(["bob","carol"])-> Array ( [0] => bob [1] => carol )
// var_dump keeps PHP's frame — array(3) { [0]=> int(1) ... }, string(2) "hi" —
// and names the REAL type instead: std::string(2) "hi",
// std::vector<int>(3) { ... }, std::vector<std::string>(2) { ... }.
//
// Both halves of those words are derived, not pattern-matched. "std::string" is
// the SOURCE'S OWN NAME for the type, found by inverting the datatype maps by
// type IDENTITY (<string>'s `typedef basic_string<char> string;` binds the
// spelling to the very DataDef being dumped). The element in
// "std::vector<std::string>" is operator[]'s return type — the same one the walk
// dumps — and the defaulted allocator/traits arguments are dropped because they
// are implementation detail, not information. Nothing here matches
// `basic_string` or `vector` as a string, which is why the fixture can pin these
// lines in full and stay stable across standard-library flavors: an ALIAS is the
// same under libstdc++ and libc++, while the canonical spelling is not
// (std::__cxx11:: vs std::__1::).
#include <iostream>
#include <string>
#include <vector>
#include <ns_php>
using namespace std;

struct Person {
	string name;
	int age;
};

int main()
{
	vector<int> v;
	v.push_back(1);
	v.push_back(4);
	v.push_back(9);
	php::print_r(v);
	cout << "===" << endl;
	php::var_dump(v);
	cout << "===" << endl;

	// A string is text, not an array of small integers.
	string s = "hi";
	php::print_r(s);
	cout << "|" << endl;
	php::var_dump(s);
	cout << "===" << endl;

	// A string MEMBER inside a struct takes the same path.
	Person p;
	p.name = "alice";
	p.age = 30;
	php::print_r(p);
	cout << "===" << endl;
	php::var_dump(p);
	cout << "===" << endl;

	// A sequence OF sequences: each element is itself text.
	vector<string> names;
	names.push_back("bob");
	names.push_back("carol");
	php::print_r(names);
	cout << "===" << endl;
	php::var_dump(names);
	return 0;
}
