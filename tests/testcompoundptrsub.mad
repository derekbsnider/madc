#!/../bin/madc
// Compound-assign on a raw-pointer subscript lvalue: `int *p; p[i] += N;`.
// The TokenSubscript branch of resolveCompoundLHS used to handle only
// fixed-array bases; pointer subscript bases fell through to the
// "<op> on unsupported subscript lval" throw. SMAUG's act_info.c
// `prgnShow[iShow] += obj->count` triggered it.

#include <stdio.h>
#include <stdlib.h>

int main()
{
    int *p = (int *)malloc(sizeof(int) * 4);
    p[0] = 10;
    p[1] = 20;
    p[2] = 100;
    p[3] = 0;

    // Plain compound-assigns through a pointer subscript.
    p[0] += 5;        // 15
    p[1] -= 3;        // 17
    p[2] *= 2;        // 200
    p[3] |= 0xF;      // 15
    printf("1: %d %d %d %d\n", p[0], p[1], p[2], p[3]);

    // Dynamic index variant.
    int i = 2;
    p[i] /= 4;        // 50
    p[i] %= 7;        // 50 % 7 = 1
    printf("2: %d\n", p[i]);

    // Bitwise compound-assigns.
    p[0] = 0xFF;
    p[0] &= 0x0F;     // 0x0F
    p[0] ^= 0x55;     // 0x5A
    p[0] <<= 1;       // 0xB4
    p[0] >>= 2;       // 0x2D
    printf("3: %x\n", p[0]);

    free(p);
    return 0;
}
