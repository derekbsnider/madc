// Bundles (plugins Stage A; docs/plans/2026-09-30-madcide-plugins.md
// §5.1-5.2, plan §41.11a step 1): a profile is a BUNDLE, a <name>/<name>.plugin
// manifest (JSON) naming the keys, layout, menu, theme and status a session
// loads, and its settings' defaults. Pins:
//   1. the configuration directory's order (config_dir_of):
//      MADCIDE_CONFIG_DIR, $XDG_CONFIG_HOME/madcide, %APPDATA%/madcide on
//      Windows only, ~/.config/madcide, else none;
//   2. the shipped default.plugin reads as the built-in default bundle;
//   3. a manifest's words are checked at load: an unknown field, an unknown
//      contribution, a name that is not its directory's, an API this madcide
//      does not serve, a data word that is a path and a non-object
//      "contributes" are each refused with the file and the word;
//   4. no settings and no --profile: the default bundle (joe keys, the
//      default layout and theme), as before bundles;
//   5. settings.json's "profile" selects a user bundle: its own directory
//      holds its layout, its keys word (pico) is the shared profiles' file,
//      the word it leaves unset (theme) is the default bundle's, and its
//      settings' default seeds the session's standard ("std");
//   6. the command line's profile beats settings.json's;
//   7. a user setting beats the bundle's default;
//   8. a user bundle overrides a shipped one by name (a user default/ with
//      emacs keys);
//   9. the fallbacks say so: a bundle naming a missing keys file runs the
//      default keys; a refused manifest, an unknown profile and a name that is
//      a path leave the default profile in use, the reason on the status line;
//  10. the program's own name (madc::sys.argv[0], its basename without the
//      extension) selects the bundle of that name with no flag — a link
//      /usr/local/bin/chthonia, a chthonia.exe — ahead of settings.json's
//      "profile"; the command line still beats it, and a name no bundle has
//      falls through to settings.json.
//  11. MADCIDE_PLUGIN_PATH (plugin_path_dirs): its directories in order, split
//      at ':' (';' on Windows, where "C:\x" keeps its drive), empty entries
//      skipped; the search path is the configuration directory, then those
//      directories, then the shipped plugins — a bundle only there is found,
//      a user bundle of the same name still wins, and the shipped default is
//      still found.
// The configuration directory is this test's fixture (MADCIDE_CONFIG_DIR in
// the .env); the runner points every other test at none.
#include "../tools/texteditor/lined_core.inc"
#include "../tools/texteditor/editor_events.inc"
#include "../tools/madcide/madcide_core.inc"

// Every directory up to and including `dir` (one level per php::mkdir).
void mkdirs(var &made, const char *dir0)
{
    var dir = dir0;
    array parts;
    php::explode(parts, "/", dir.c_str());
    var grown = "";
    for ( var seg : parts )
    {
	if ( strlen(grown.c_str()) == 0 )
	    grown = seg;
	else
	    grown = format("{}/{}", grown, seg);
	if ( !php::file_exists(grown) )
	{
	    php::mkdir(grown.c_str());
	    made.push(grown);
	}
    }
}

void put(var &files, var &path, const char *text)
{
    php::file_put_contents(path.c_str(), text);
    files.push(path);
}

// One session under `profile`; its bag's answers for the pins.
void probe(var &out, const char *path, const char *profile)
{
    IdeSession S;
    long doc = S.open(path, false, profile);
    var r = { "doc": doc };
    if ( doc > 0 )
    {
	var b;
	ui::get(b, S.w, S.es, "bundle");
	var k;
	ui::get(k, S.w, S.es, "profile");
	var lo;
	ui::get(lo, S.w, S.es, "layout");
	var sc;
	ui::get(sc, S.w, S.es, "scheme");
	var rs = madc::file_kind_name(lang_session(S.w));
	var bd;
	ui::get(bd, S.w, S.es, "bundledir");
	var msg;
	ui::get(msg, S.w, S.es, "msg");
	r = { "doc": doc, "bundle": b, "keys": k, "window": lo["window"],
	      "scheme": sc, "std": rs, "dir": bd, "msg": msg };
	S.close();
    }
    out = r;
}

int main()
{
    var files = {};
    var made = {};
    const char *path = "madc_ide_bundles.mad";
    php::file_put_contents(path, "int main() { return 0; }\n");

    // 1. The configuration directory's order.
    var c;
    config_dir_of(c, "madcide", "/o", "/x", "/a", "/h", true);
    println("bundles-cfg-override: {}", c);
    config_dir_of(c, "madcide", "", "/x", "/a", "/h", true);
    println("bundles-cfg-xdg: {}", c);
    config_dir_of(c, "madcide", NULL, NULL, "/a", "/h", true);
    println("bundles-cfg-appdata: {}", c);
    config_dir_of(c, "madcide", NULL, NULL, "/a", "/h", false);
    println("bundles-cfg-home: {}", c);
    config_dir_of(c, "madcide", NULL, NULL, NULL, NULL, false);
    println("bundles-cfg-none: [{}]", c);

    var cfg;
    madcide_config_dir(cfg);
    var plugins = format("{}/plugins", cfg);
    mkdirs(made, plugins.c_str());

    // 2. The shipped default.plugin is the built-in default bundle.
    var ddir;
    bool found = plugin_find(ddir, "default");	// no user default/ yet
    var shipped;
    var why;
    bool sok = plugin_manifest_read(shipped, why, ddir, "default");
    var baked;
    js::parse(baked, default_bundle_text());
    var st = js::stringify(shipped, 0);
    var bt = js::stringify(baked, 0);
    println("bundles-default-pin: found={} read={} same={}", found ? 1 : 0, sok ? 1 : 0, st == bt ? 1 : 0);

    // 3. The manifest's words, each refused with its reason.
    var bad = format("{}/bad", plugins);
    mkdirs(made, bad.c_str());
    var bp = format("{}/bad.plugin", bad);
    var m;
    put(files, bp, "{ \"name\": \"bad\", \"api\": 3, \"colour\": \"red\" }");
    plugin_manifest_read(m, why, bad, "bad");
    println("bundles-refuse-field: {}", php::str_replace(cfg.c_str(), "CFG", why.c_str()));
    php::file_put_contents(bp.c_str(), "{ \"name\": \"bad\", \"api\": 3, \"contributes\": { \"commands\": {} } }");
    plugin_manifest_read(m, why, bad, "bad");
    println("bundles-refuse-kind: {}", php::str_replace(cfg.c_str(), "CFG", why.c_str()));
    php::file_put_contents(bp.c_str(), "{ \"name\": \"other\", \"api\": 3 }");
    plugin_manifest_read(m, why, bad, "bad");
    println("bundles-refuse-name: {}", php::str_replace(cfg.c_str(), "CFG", why.c_str()));
    php::file_put_contents(bp.c_str(), "{ \"name\": \"bad\", \"api\": 4 }");
    plugin_manifest_read(m, why, bad, "bad");
    println("bundles-refuse-api: {}", php::str_replace(cfg.c_str(), "CFG", why.c_str()));
    php::file_put_contents(bp.c_str(), "{ \"name\": \"bad\", \"api\": 3, \"contributes\": { \"keys\": \"../joe\" } }");
    plugin_manifest_read(m, why, bad, "bad");
    println("bundles-refuse-path: {}", php::str_replace(cfg.c_str(), "CFG", why.c_str()));
    php::file_put_contents(bp.c_str(), "{ \"name\": \"bad\", \"api\": 3, \"contributes\": \"joe\" }");
    plugin_manifest_read(m, why, bad, "bad");
    println("bundles-refuse-contributes: {}", php::str_replace(cfg.c_str(), "CFG", why.c_str()));
    php::file_put_contents(bp.c_str(), "{ \"name\": \"bad\", ");
    plugin_manifest_read(m, why, bad, "bad");
    println("bundles-refuse-json: {}", php::str_replace(cfg.c_str(), "CFG", why.c_str()));

    // 4. Nothing selects a bundle: the default one, as before bundles.
    var r;
    probe(r, path, "");
    println("bundles-none: bundle={} keys={} window={} scheme={} shipped-dir={}",
	    r["bundle"], r["keys"], r["window"], r["scheme"], r["dir"] == ddir ? 1 : 0);

    // 5. settings.json selects a user bundle.
    var mine = format("{}/mine", plugins);
    mkdirs(made, mine.c_str());
    var mp = format("{}/mine.plugin", mine);
    put(files, mp, "{ \"name\": \"mine\", \"title\": \"Mine\", \"api\": 3,"
		   " \"contributes\": { \"keys\": \"pico\", \"layout\": \"mine\","
		   " \"settings\": { \"std\": \"c11\" } } }");
    var ml = format("{}/mine.layout", mine);
    put(files, ml, "@window mine\npane editor tabs views source focus\npane panel bottom 30% tabs views problems repl\n");
    var sp = format("{}/settings.json", cfg);
    put(files, sp, "{ \"profile\": \"mine\" }");
    probe(r, path, "");
    println("bundles-settings: bundle={} keys={} window={} scheme={} std={} user-dir={}",
	    r["bundle"], r["keys"], r["window"], r["scheme"], r["std"], r["dir"] == mine ? 1 : 0);

    // 6. The command line beats settings.json.
    probe(r, path, "default");
    println("bundles-cli: bundle={} keys={} window={}", r["bundle"], r["keys"], r["window"]);

    // 10. The program's own name (settings.json still says "mine").
    var a0 = madc::sys.argv[0];
    madc::sys.argv[0] = "/usr/local/bin/chthonia";
    probe(r, path, "");
    var pl = r["bundle"];
    madc::sys.argv[0] = "chthonia.exe";
    probe(r, path, "");
    var pe = r["bundle"];
    probe(r, path, "default");
    var pc = r["bundle"];
    madc::sys.argv[0] = "/opt/renamed-ide";
    probe(r, path, "");
    var pu = r["bundle"];
    madc::sys.argv[0] = a0;
    println("bundles-progname: link={} exe={} cli={} unknown={}", pl, pe, pc, pu);

    // 7. A user setting beats the bundle's default.
    php::file_put_contents(sp.c_str(), "{ \"profile\": \"mine\", \"std\": \"c17\" }");
    probe(r, path, "");
    println("bundles-user-setting: std={}", r["std"]);
    php::file_put_contents(sp.c_str(), "{ }");

    // 8. A user bundle overrides a shipped one by name.
    var ud = format("{}/default", plugins);
    mkdirs(made, ud.c_str());
    var up = format("{}/default.plugin", ud);
    put(files, up, "{ \"name\": \"default\", \"api\": 3, \"contributes\": { \"keys\": \"emacs\","
		   " \"status\": \"joe\", \"theme\": \"default\", \"menu\": \"default\", \"layout\": \"default\" } }");
    probe(r, path, "");
    println("bundles-override: bundle={} keys={} user-dir={}", r["bundle"], r["keys"], r["dir"] == ud ? 1 : 0);
    php::unlink(up.c_str());

    // 9. The fallbacks, each said on the status line.
    var nk = format("{}/nokeys", plugins);
    mkdirs(made, nk.c_str());
    var np = format("{}/nokeys.plugin", nk);
    put(files, np, "{ \"name\": \"nokeys\", \"api\": 3, \"contributes\": { \"keys\": \"nosuch\" } }");
    probe(r, path, "nokeys");
    println("bundles-nokeys: bundle={} keys={} msg={}", r["bundle"], r["keys"], r["msg"]);
    php::file_put_contents(bp.c_str(), "{ \"name\": \"bad\", \"api\": 3, \"colour\": \"red\" }");
    probe(r, path, "bad");
    var said = php::str_replace(cfg.c_str(), "CFG", r["msg"].c_str());
    println("bundles-refused: bundle={} keys={} msg={}", r["bundle"], r["keys"], said);
    probe(r, path, "nosuch");
    println("bundles-unknown: bundle={} msg={}", r["bundle"], r["msg"]);
    probe(r, path, "../mine");
    println("bundles-path: bundle={} msg={}", r["bundle"], r["msg"]);

    // 11. The plugin path: its split, then the search order (this test's
    //     .env names one directory).
    array pd;
    plugin_path_dirs(pd, "a::b:", false);
    plugin_path_dirs(pd, "C:\\x;;D:\\y", true);
    plugin_path_dirs(pd, NULL, false);
    println("bundles-plugpath-split: {}", php::implode(" ", pd));
    var envdir = getenv("MADCIDE_PLUGIN_PATH");
    var ex = format("{}/extra", envdir);
    mkdirs(made, ex.c_str());
    var exp = format("{}/extra.plugin", ex);
    put(files, exp, "{ \"name\": \"extra\", \"api\": 3 }");
    var em = format("{}/mine", envdir);
    mkdirs(made, em.c_str());
    var emp = format("{}/mine.plugin", em);
    put(files, emp, "{ \"name\": \"mine\", \"api\": 3 }");
    array sd;
    plugin_dirs(sd);
    var fx;
    bool fe = plugin_find(fx, "extra");
    var fm;
    plugin_find(fm, "mine");
    var fd;
    plugin_find(fd, "default");
    println("bundles-plugpath-search: dirs={} second={} extra={} mine-user={} default-shipped={}",
	    php::count(sd), sd[1] == envdir ? 1 : 0, fe && fx == ex ? 1 : 0, fm == mine ? 1 : 0,
	    fd == ddir ? 1 : 0);

    // Remove every file, then every directory this test made.
    long nf = php::count(files);
    for ( long i = 0; i < nf; i = i + 1 )
    {
	var f = files[i];
	php::unlink(f.c_str());
    }
    long nd = php::count(made);
    for ( long i = nd - 1; i >= 0; i = i - 1 )
    {
	var d = made[i];
	php::rmdir(d.c_str());
    }
    php::unlink(path);
    return 0;
}
