#!/../bin/madc

#include <stdio.h>

unsigned int foo(unsigned char *p)
{
    return ((unsigned int)p[0] << 24)
	| (p[1] << 16)
	| (p[2] << 8)
	| p[3];
}

unsigned int bar(unsigned char *p)
{
    return ((unsigned int)p[3] << 24)
	| (p[2] << 16)
	| (p[1] << 8)
	| p[0];
}

struct S {
    unsigned int a;
    unsigned char b[5];
};

int main(void)
{
    struct S s = { 1, { 2, 3, 4, 5, 6 } };
    printf("0x%08x\n", foo(&s.b[1]));
    printf("0x%08x\n", bar(&s.b[1]));
    return 0;
}
