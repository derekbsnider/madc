// Slice 3 Task 5: the status bar as discrete items. compose_joe_statusline
// attaches the SAME expanded halves (left/right) to the status node's hints
// while keeping the combined `content` string for the TUI. testmadcide
// still pins the combined string (status-fn / Row Col); this pins the items.
#include "../tools/texteditor/lined_core.inc"
#include "../tools/texteditor/editor_events.inc"
#include "../tools/madcide/madcide_core.inc"

int main()
{
    const char *path = "madc_ide_status.mad";
    php::file_put_contents(path, "long id(long x) { return x; }\n");
    long w = ui::world_new();
    long doc = setup_editor(w, path, false);
    long es = ui::entity_by_name(w, "editor-state");
    ui::set(w, es, "profile_dir", "tools/madcide/profiles");
    ui::set(w, es, "profile", "joe");
    load_status(w, es, "joe");
    IdeSession S;
    S.attach(w, es);

    var tree;
    S.compose_ide_tree(tree, doc);
    var st = tree["children"][0];
    // The combined content string still names the file (the TUI's view).
    var content = st["content"];
    println("content-has-name={}", content.index("madc_ide_status.mad") >= 0 ? 1 : 0);
    // The items ride the hints: left carries the name seat, right the Row/Col.
    println("items-present={}", st["hints"]["items"].is_null() ? 0 : 1);
    var left = st["hints"]["items"]["left"];
    var right = st["hints"]["items"]["right"];
    println("left-has-name={} right-has-row={}",
	    left.index("madc_ide_status.mad") >= 0 ? 1 : 0,
	    right.index("Row") >= 0 ? 1 : 0);
    return 0;
}
