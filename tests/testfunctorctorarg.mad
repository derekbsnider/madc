// Regression: a functional construction of a TEMPLATE TYPE PARAMETER used as
// the first argument of an enclosing call -- `cmp(KOV()(v), w)` -- must not be
// misparsed as a `(Type)cast` that steals the call's argument list and drops
// the trailing argument. After class-template instantiation the parameter is
// substituted in as a type token, so the enclosing call's `(` is immediately
// followed by a type; the parser must still treat it as the call's argument
// list (the first argument being a functional construction), not a cast.
//
// Mirrors std::_Rb_tree::_M_insert_'s
//   _M_impl._M_key_compare(_KeyOfValue()(__v), _S_key(__p))
// (_KeyOfValue == std::_Identity for std::set), which previously failed with
// "Incorrect number of parameters: expected 3 got 2".
#include <cstdio>

template<typename T> struct Ident { T operator()(T x) const { return x; } };
template<typename T> struct Less  { bool operator()(T a, T b) const { return a < b; } };

template<typename T, typename KOV = Ident<T> >
struct Tree {
	Less<T> cmp;
	bool less_keyed(T v, T w) { return cmp(KOV()(v), w); }
};

int main()
{
	Tree<int> t;
	printf("%d\n", t.less_keyed(3, 5) ? 1 : 0);   // 3 < 5  -> 1
	printf("%d\n", t.less_keyed(5, 3) ? 1 : 0);   // 5 < 3  -> 0
	return 0;
}
