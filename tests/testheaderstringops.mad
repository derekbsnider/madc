#include <stdio.h>
#include <string>

// The portable spelling — std::__cxx11 is libstdc++'s ABI inline namespace
// and does not exist under libc++ (clang++ -stdlib=libc++ rejects it too);
// std::basic_string<...> names the same type in both flavors.
typedef std::basic_string<char, std::char_traits<char>, std::allocator<char> > mystr;

int main() {
	mystr a("hello");
	mystr b("hello");
	mystr c("world");
	mystr d = a + c;

	printf("eq=%d\n", a == b);
	printf("ne=%d\n", a != c);
	printf("cat=%s\n", d.c_str());
	return 0;
}
