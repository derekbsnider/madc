// A pointer to an array of unknown bound (`char (*c)[]`, C11 6.7.6.2p4: an
// incomplete array type) is emitted with `[]`. madc rendered the unwritten
// bound as a zero-length `[0]` — a different, complete type — and c2mir
// warned "incompatible types in assignment to a pointer" on
// `char (*c)[] = &"Hello"` and `int (*pa)[] = &arr`.
// gcc 13.3 and clang 18.1 (-std=c11 -Wall -Wextra) print the .expect line
// with no diagnostic.
#include <stdio.h>
typedef int (*row_ptr)[];
struct holder {
	int (*rows)[];
};
char (*c)[] = &"Hello";
static int first(int (*p)[])
{
	return (*p)[0];
}
int main(void)
{
	int arr[4] = { 7, 8, 9, 10 };
	int (*pa)[] = &arr;
	row_ptr rp = &arr;
	struct holder h = { &arr };
	printf("unbounded: %s %d %d %d %d\n", *c, (*pa)[1], (*rp)[2],
	       (*h.rows)[3], first(&arr));
	return 0;
}
