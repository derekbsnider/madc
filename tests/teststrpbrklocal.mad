extern int printf(const char *, ...);

char *strpbrk(const char *s1, const char *s2)
{
	const char *p;
	while (*s1)
	{
		for (p = s2; *p; p++)
			if (*s1 == *p)
				return (char *)s1;
		s1++;
	}
	return 0;
}

int main(void)
{
	const char *const foo[] = { "hello world", "bye bye world" };
	const char *const *bar = foo;
	printf("%s\n", *bar);
	bar = foo + 1;
	const char *old = *bar--;
	printf("%s\n", old);
	printf("%s\n", *bar);
	bar = foo + 1;
	printf("%s\n", strpbrk("hello world", "lrooo"));
	printf("%s\n", strpbrk(foo[0], "w"));
	printf("%d\n", strpbrk(foo[0], "") == 0);
	printf("%d\n", strpbrk(*bar--, "") == 0);
	printf("%s\n", strpbrk(*bar, "h"));
	return 0;
}
