#include <iostream>
using namespace std;
// Test [&] lambda capture by reference

int main()
{
    // Basic capture: modify outer variable
    int counter = 0;
    auto increment = [&]() {
        counter = counter + 1;
    };
    increment();
    increment();
    cout << counter << endl;   // 2

    // Capture with parameter
    int total = 0;
    auto add = [&](int n) {
        total = total + n;
    };
    add(10);
    add(5);
    cout << total << endl;     // 15

    // Capture string
    string msg = "hello";
    auto greet = [&]() {
        cout << msg << endl;
    };
    greet();                   // hello

    // Capture a reference variable by reference: the closure modifies the
    // referent through the captured reference; the change is visible via the
    // underlying object.
    int base = 100;
    int &ref = base;
    auto bump = [&]() {
        ref = ref + 5;
    };
    bump();
    bump();
    cout << base << endl;      // 110

    return 0;
}
