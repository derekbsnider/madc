// GCC/clang inline the `__atomic_*` builtins; c2mir cannot, so madc lowers
// __atomic_thread_fence / __atomic_signal_fence / __atomic_fetch_add to real
// gcc-compiled runtime wrappers (__madc_atomic_*). libstdc++'s <ext/atomicity.h>
// refcount path (the memory barriers + __exchange_and_add) reaches them through
// <memory>, the vector reallocation chain.
#include <iostream>
int main() {
  int x = 5;
  __atomic_thread_fence(5);          // __ATOMIC_SEQ_CST
  __atomic_signal_fence(5);
  int old = __atomic_fetch_add(&x, 3, 5);
  std::cout << "old=" << old << " x=" << x << "\n";   // old=5 x=8
  return 0;
}
