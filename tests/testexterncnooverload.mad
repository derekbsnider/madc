// C++ SYMBOL MANGLING phase 1, design §4.5: extern "C" functions cannot
// overload — two C-linkage declarations of one name with different parameter
// lists are an error (g++ -std=c++20: "conflicting declaration of C function
// 'cfn'"), in C++ and madc mode alike. Before the feature the second silently
// reconciled into the first by position.
extern "C" void cfn(int v);
extern "C" void cfn(double d) { }
int main() { cfn(1); return 0; }
