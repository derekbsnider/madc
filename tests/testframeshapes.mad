/* Frame shapes: every frame-pointer-relative reference a function makes --
 * varargs (va_start), arguments past the fourth, small structs passed by
 * value, spill slots (more than 240 bytes of them), callee-saved integer and
 * vector registers, and a variable-length array -- in functions whose frames
 * hold them. On Windows the frame register sits at most 240 bytes above the
 * frame's bottom (the x64 unwind rules; mingw gcc and clang), so a larger
 * frame's references are addressed from below its top.
 * Oracle: gcc 13 and clang 18 (Linux, -std=c17) and mingw-w64 gcc 13: the
 * lines below. */
#include <stdio.h>
#include <stdarg.h>
#include <string.h>

struct pair { int a, b; };

static double vsum(int n, ...)
{
	va_list ap;
	double s = 0;
	int i;

	va_start(ap, n);
	for (i = 0; i < n; i++)
		s += va_arg(ap, double);
	va_end(ap);
	return s;
}

static long long many_args(long long a, long long b, long long c, long long d,
			   long long e, long long f, struct pair g, struct pair h)
{
	return a + b * 2 + c * 3 + d * 4 + e * 5 + f * 6 + g.a * 7 + g.b * 8
	       + h.a * 9 + h.b * 10;
}

static unsigned long long int_pressure(unsigned long long x, int a, int b, int c,
				       int d, int e)
{
	x += (unsigned long long) (a + b + c + d + e);
	unsigned long long v0 = x * 3 + 0;
	unsigned long long v1 = x * 4 + 7;
	unsigned long long v2 = x * 5 + 14;
	unsigned long long v3 = x * 6 + 21;
	unsigned long long v4 = x * 7 + 28;
	unsigned long long v5 = x * 8 + 35;
	unsigned long long v6 = x * 9 + 42;
	unsigned long long v7 = x * 10 + 49;
	unsigned long long v8 = x * 11 + 56;
	unsigned long long v9 = x * 12 + 63;
	unsigned long long v10 = x * 13 + 70;
	unsigned long long v11 = x * 14 + 77;
	unsigned long long v12 = x * 15 + 84;
	unsigned long long v13 = x * 16 + 91;
	unsigned long long v14 = x * 17 + 98;
	unsigned long long v15 = x * 18 + 105;
	unsigned long long v16 = x * 19 + 112;
	unsigned long long v17 = x * 20 + 119;
	unsigned long long v18 = x * 21 + 126;
	unsigned long long v19 = x * 22 + 133;
	unsigned long long v20 = x * 23 + 140;
	unsigned long long v21 = x * 24 + 147;
	unsigned long long v22 = x * 25 + 154;
	unsigned long long v23 = x * 26 + 161;
	unsigned long long v24 = x * 27 + 168;
	unsigned long long v25 = x * 28 + 175;
	unsigned long long v26 = x * 29 + 182;
	unsigned long long v27 = x * 30 + 189;
	unsigned long long v28 = x * 31 + 196;
	unsigned long long v29 = x * 32 + 203;
	unsigned long long v30 = x * 33 + 210;
	unsigned long long v31 = x * 34 + 217;
	unsigned long long v32 = x * 35 + 224;
	unsigned long long v33 = x * 36 + 231;
	unsigned long long v34 = x * 37 + 238;
	unsigned long long v35 = x * 38 + 245;
	unsigned long long v36 = x * 39 + 252;
	unsigned long long v37 = x * 40 + 259;
	unsigned long long v38 = x * 41 + 266;
	unsigned long long v39 = x * 42 + 273;
	unsigned long long v40 = x * 43 + 280;
	unsigned long long v41 = x * 44 + 287;
	unsigned long long v42 = x * 45 + 294;
	unsigned long long v43 = x * 46 + 301;
	unsigned long long v44 = x * 47 + 308;
	unsigned long long v45 = x * 48 + 315;
	unsigned long long v46 = x * 49 + 322;
	unsigned long long v47 = x * 50 + 329;
	unsigned long long s = 0;
	s = s * 3 + v47;
	s = s * 3 + v46;
	s = s * 3 + v45;
	s = s * 3 + v44;
	s = s * 3 + v43;
	s = s * 3 + v42;
	s = s * 3 + v41;
	s = s * 3 + v40;
	s = s * 3 + v39;
	s = s * 3 + v38;
	s = s * 3 + v37;
	s = s * 3 + v36;
	s = s * 3 + v35;
	s = s * 3 + v34;
	s = s * 3 + v33;
	s = s * 3 + v32;
	s = s * 3 + v31;
	s = s * 3 + v30;
	s = s * 3 + v29;
	s = s * 3 + v28;
	s = s * 3 + v27;
	s = s * 3 + v26;
	s = s * 3 + v25;
	s = s * 3 + v24;
	s = s * 3 + v23;
	s = s * 3 + v22;
	s = s * 3 + v21;
	s = s * 3 + v20;
	s = s * 3 + v19;
	s = s * 3 + v18;
	s = s * 3 + v17;
	s = s * 3 + v16;
	s = s * 3 + v15;
	s = s * 3 + v14;
	s = s * 3 + v13;
	s = s * 3 + v12;
	s = s * 3 + v11;
	s = s * 3 + v10;
	s = s * 3 + v9;
	s = s * 3 + v8;
	s = s * 3 + v7;
	s = s * 3 + v6;
	s = s * 3 + v5;
	s = s * 3 + v4;
	s = s * 3 + v3;
	s = s * 3 + v2;
	s = s * 3 + v1;
	s = s * 3 + v0;
	s ^= v0 << (0 % 13);
	s ^= v1 << (1 % 13);
	s ^= v2 << (2 % 13);
	s ^= v3 << (3 % 13);
	s ^= v4 << (4 % 13);
	s ^= v5 << (5 % 13);
	s ^= v6 << (6 % 13);
	s ^= v7 << (7 % 13);
	s ^= v8 << (8 % 13);
	s ^= v9 << (9 % 13);
	s ^= v10 << (10 % 13);
	s ^= v11 << (11 % 13);
	s ^= v12 << (12 % 13);
	s ^= v13 << (13 % 13);
	s ^= v14 << (14 % 13);
	s ^= v15 << (15 % 13);
	s ^= v16 << (16 % 13);
	s ^= v17 << (17 % 13);
	s ^= v18 << (18 % 13);
	s ^= v19 << (19 % 13);
	s ^= v20 << (20 % 13);
	s ^= v21 << (21 % 13);
	s ^= v22 << (22 % 13);
	s ^= v23 << (23 % 13);
	s ^= v24 << (24 % 13);
	s ^= v25 << (25 % 13);
	s ^= v26 << (26 % 13);
	s ^= v27 << (27 % 13);
	s ^= v28 << (28 % 13);
	s ^= v29 << (29 % 13);
	s ^= v30 << (30 % 13);
	s ^= v31 << (31 % 13);
	s ^= v32 << (32 % 13);
	s ^= v33 << (33 % 13);
	s ^= v34 << (34 % 13);
	s ^= v35 << (35 % 13);
	s ^= v36 << (36 % 13);
	s ^= v37 << (37 % 13);
	s ^= v38 << (38 % 13);
	s ^= v39 << (39 % 13);
	s ^= v40 << (40 % 13);
	s ^= v41 << (41 % 13);
	s ^= v42 << (42 % 13);
	s ^= v43 << (43 % 13);
	s ^= v44 << (44 % 13);
	s ^= v45 << (45 % 13);
	s ^= v46 << (46 % 13);
	s ^= v47 << (47 % 13);
	return s;
}

static double fp_pressure(double x, double a, double b, double c, double d,
			  double e)
{
	x += a + b + c + d + e;
	double d0 = x * 1.5 + 0.25;
	double d1 = x * 2.5 + 1.25;
	double d2 = x * 3.5 + 2.25;
	double d3 = x * 4.5 + 3.25;
	double d4 = x * 5.5 + 4.25;
	double d5 = x * 6.5 + 5.25;
	double d6 = x * 7.5 + 6.25;
	double d7 = x * 8.5 + 7.25;
	double d8 = x * 9.5 + 8.25;
	double d9 = x * 10.5 + 9.25;
	double d10 = x * 11.5 + 10.25;
	double d11 = x * 12.5 + 11.25;
	double d12 = x * 13.5 + 12.25;
	double d13 = x * 14.5 + 13.25;
	double d14 = x * 15.5 + 14.25;
	double d15 = x * 16.5 + 15.25;
	double d16 = x * 17.5 + 16.25;
	double d17 = x * 18.5 + 17.25;
	double d18 = x * 19.5 + 18.25;
	double d19 = x * 20.5 + 19.25;
	double d20 = x * 21.5 + 20.25;
	double d21 = x * 22.5 + 21.25;
	double d22 = x * 23.5 + 22.25;
	double d23 = x * 24.5 + 23.25;
	double s = 0;
	s = s * 0.5 + d23;
	s = s * 0.5 + d22;
	s = s * 0.5 + d21;
	s = s * 0.5 + d20;
	s = s * 0.5 + d19;
	s = s * 0.5 + d18;
	s = s * 0.5 + d17;
	s = s * 0.5 + d16;
	s = s * 0.5 + d15;
	s = s * 0.5 + d14;
	s = s * 0.5 + d13;
	s = s * 0.5 + d12;
	s = s * 0.5 + d11;
	s = s * 0.5 + d10;
	s = s * 0.5 + d9;
	s = s * 0.5 + d8;
	s = s * 0.5 + d7;
	s = s * 0.5 + d6;
	s = s * 0.5 + d5;
	s = s * 0.5 + d4;
	s = s * 0.5 + d3;
	s = s * 0.5 + d2;
	s = s * 0.5 + d1;
	s = s * 0.5 + d0;
	s += d0 * 0;
	s += d1 * 1;
	s += d2 * 2;
	s += d3 * 3;
	s += d4 * 4;
	s += d5 * 0;
	s += d6 * 1;
	s += d7 * 2;
	s += d8 * 3;
	s += d9 * 4;
	s += d10 * 0;
	s += d11 * 1;
	s += d12 * 2;
	s += d13 * 3;
	s += d14 * 4;
	s += d15 * 0;
	s += d16 * 1;
	s += d17 * 2;
	s += d18 * 3;
	s += d19 * 4;
	s += d20 * 0;
	s += d21 * 1;
	s += d22 * 2;
	s += d23 * 3;
	return s;
}

static unsigned long long variable(int n, unsigned long long k)
{
	char buf[n];
	unsigned long long s = 0;
	int i;

	memset(buf, (int) (k & 0x7f), (size_t) n);
	for (i = 0; i < n; i += 97)
		s += buf[i] * (i + 1);
	return s + int_pressure(k, 0, 0, 0, 0, 0) % 1000;
}

int main(int argc, char **argv)
{
	struct pair p = { 3, 4 }, q = { 5, 6 };

	(void) argv;
	printf("vsum %.2f\n", vsum(4, 1.5, 2.25, 3.0, 4.75));
	printf("many %lld\n", many_args(1, 2, 3, 4, 5, 6, p, q));
	printf("int %llu\n", int_pressure(argc + 1, 0, 0, 0, 0, 0));
	printf("fp %.3f\n", fp_pressure(argc + 0.5, 0, 0, 0, 0, 0));
	printf("variable %llu\n", variable(5000 + argc, 9));
	return 0;
}
