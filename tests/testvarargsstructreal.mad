#include <stdarg.h>

typedef struct { double x, y; } point;

point pts[] = {{1.0, 2.0}, {3.0, 4.0}};
int fails;

void check(int nargs, ...)
{
	va_list args;
	int i;
	point pi;

	va_start(args, nargs);
	for (i = 0; i < nargs; i = i + 1)
	{
		pi = va_arg(args, point);
		if (pts[i].x != pi.x || pts[i].y != pi.y)
			fails = fails + 1;
	}
	va_end(args);
}

int main()
{
	check(2, pts[0], pts[1]);
	puti(fails);
	puts("\n");
	return 0;
}
