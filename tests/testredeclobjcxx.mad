// C++: the object redeclarations [basic.def]/[basic.def.odr] ALLOW stay legal
// once Program::declare_object owns the redeclaration rules — an `extern`
// declaration then its definition (an array of unknown bound completed, a
// named-namespace member), an `extern "C"` single declaration then its
// definition ([dcl.link]/7), an unnamed-namespace object, a variable template
// instantiated twice (its products are re-minted from the checked pattern) and
// repeated block-scope `extern`. testredecltentativecxx is the refused twin.
// Oracle: g++ -std=c++17 and clang++ -std=c++17 print testredeclobjcxx.expect.
#include <stdio.h>
extern int a[];
int a[3] = { 1, 2, 3 };
extern int e;
int e = 4;
namespace { int y = 2; }
namespace N { extern int z; int z = 3; }
template <class T> T pi = T(3);
extern "C" int c_x;
int c_x = 6;
int main()
{
	extern int e;
	extern int e;
	printf("%d %d %d %d %d %d\n", a[2], e, y, N::z, pi<int> + pi<int>, c_x);
	return 0;
}
