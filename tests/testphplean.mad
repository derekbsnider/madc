// php:: lean primaries (Leg 0b, dialect-lean.md): every public that used
// to exist only in std::string shape has a value/char* PRIMARY usable in
// a pure dialect TU — zero includes, PHP-parity semantics (returns a NEW
// string; the subject is never mutated). Ring-lifetime returns print or
// capture immediately.
int main()
{
	var vs = "  hello  ";
	println("{}", php::trim(vs));
	println("{}", php::trim("  x  "));
	println("[{}]", php::ltrim(vs));
	println("[{}]", php::rtrim(vs));
	println("{}", php::chop("abc  "));
	println("{}", php::lcfirst("Hello"));
	println("{}", php::str_repeat("ab", 3));
	println("{}", php::str_replace("l", "L", "hello"));
	var hay = "hello";
	println("{}", php::str_replace("l", "L", hay));
	println("{}", php::str_pad("7", 3, "0"));
	println("{}", php::str_word_count("one two  three"));
	var words = "a b c d";
	println("{}", php::str_word_count(words));
	println("{}", php::nl2br("a\nb"));
	println("{}", php::str_rot13("abc"));
	println("{}", php::chunk_split("abcdef", 2, "-"));
	println("{}", php::number_format(1234567, ","));
	println("{}", php::wordwrap("aaa bbb ccc", 7, "|"));

	array a;
	php::array_push(a, "x");
	php::array_push(a, "y");
	php::array_push(a, 42);
	println("{}", php::implode(",", a));

	var got;
	php::array_get(got, a, 1);
	println("got={}", got);
	var popped;
	php::array_pop(popped, a);
	println("popped={} count={}", popped, php::count(a));
	var first;
	php::array_shift(first, a);
	println("first={} count={}", first, php::count(a));

	// PHP parity: the subject was never mutated.
	println("[{}]", vs);
	println("[{}]", hay);
	return 0;
}
