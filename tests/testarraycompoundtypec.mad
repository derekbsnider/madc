#include <stdio.h>

int main(void)
{
	int *p = (int[3]){4, 5, 6};
	int (*q)[3] = &(int[3]){7, 8, 9};
	printf("%zu %zu %zu %zu %zu %d %d\n",
	       sizeof((int[]){7, 8}), sizeof((int[3]){0}),
	       sizeof((int[5]){[4] = 9}), sizeof((int[]){[4] = 9}),
	       sizeof *&(int[3]){1, 2, 3}, p[2], (*q)[2]);
	return 0;
}
