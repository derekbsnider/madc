// Regression: braced NSDMI (`size_t __size_{0};` — [class.mem]
// brace-or-equal-init, direct-list-init) was deliberately unconsumed by
// capture_member_default_init pending the brace slice, so any class carrying
// one died with "Expecting ';' after class member" — libc++'s
// __format/buffer.h __output_buffer (via <format>/<ostream>/<iostream>)
// demanded the slice. {expr} applies the expression; {} value-inits (0 for
// scalars). Non-template, class-template, and dependent-type member forms.
// Multi-element lists ({a, b}) remain a loud error.
// Oracle: g++ -std=c++20 and clang++ -std=c++20 accept; output "7 0 9 5 ok".
#include <cstdio>

struct Plain {
	unsigned long n{7};
	int z{};
};

template <class T>
struct Box {
	T v{9};
	long m{5};
};

int main()
{
	Plain p;
	Box<int> b;
	printf("%lu %d %d %ld ok\n", p.n, p.z, b.v, b.m);
	return 0;
}
