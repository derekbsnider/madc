// A file-scope declaration WITH an initializer is a DEFINITION even when it
// also says `extern` (C17 6.9.2p1; the same in C++). c2mir emitted an import
// for such a declaration and dropped the initializer (upstream vnmakarov/mir
// #472): the object was defined nowhere ("import of undefined item"), or,
// with a definition in another unit, its initializer was silently ignored.
// Oracle: gcc and g++ define the objects (both warn "initialized and declared
// 'extern'") and print 30 / 9 11 / 7.
extern int printf(const char *, ...);
extern const int a[] = { 1, 2, 3 };
extern int       b[] = { 4, 5, 6 };
extern int       c    = 7;
const int        d[] = { 8, 9 };
extern const int e[];
const int        e[] = { 10, 11 };
int use(void) { return a[0] + b[0] + c + d[0] + e[0]; }
int main(void)
{
	printf("%d\n", use());
	printf("%d %d\n", d[1], e[1]);
	b[0] = c;
	printf("%d\n", b[0]);
	return 0;
}
