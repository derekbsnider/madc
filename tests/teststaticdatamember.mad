// Static DATA members that have real STORAGE — the twin of
// teststaticconstmember.mad, which covers the in-class-constant kind.
//
// `int counter::hits = 5;` is what declares the storage, and `counter::hits`
// must read and write it. Both were broken and neither was loud about it: the
// resolver folded every non-class-typed static to its (absent) in-class
// constant, so a read produced a silent 0 whatever the definition said, and a
// write reported "lvalue required as left operand of assignment".
//
// Also covers `Class::member` as a CAST operand. The postfix/cast operand path
// knew only namespace and scoped-enum-tag qualifiers, so `(int)counter::hits`
// reported "undeclared identifier 'counter'" while a bare `counter::hits` on
// the same line parsed fine — and a cast is the usual spelling for trait use.
// The namespace form is kept here as a regression guard, since that arm is
// right next to the one this exercises.
//
// Matches g++ -std=c++11 and clang++ -std=c++11.
#include <stdio.h>

struct counter {
	static int hits;		// storage; defined below
	static const int limit = 7;	// in-class constant; folds
	enum { tag = 3 };		// class-scope enumerator
};

int counter::hits = 5;

namespace N { const int scoped = 11; }

int main()
{
	printf("read=%d cast=%d\n", counter::hits, (int)counter::hits);
	counter::hits = 9;
	printf("write=%d bump=%d\n", counter::hits, counter::hits + 1);
	printf("konst=%d castkonst=%d\n", counter::limit, (int)counter::limit);
	printf("enumtag=%d ns=%d\n", (int)counter::tag, (int)N::scoped);
	return 0;
}
