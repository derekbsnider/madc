// The build OUTPUT panel (client-server arc V2: the layout's chrome). A
// build's stream shows in the panel pane's Output tab — show_output unhides
// the panel (it is a fixed-slot chrome pane of the layout, hidden by
// default), the composer docks it as a region:panel group whose active tab's
// content is the [build] buffer, and it STAYS until hidden (VS Code's Output
// shape; the terminal composes it too — the ruling). This drives the state
// directly (no async pump): show_output + the buildlive flag + seeded text.
#include "../tools/texteditor/lined_core.inc"
#include "../tools/texteditor/editor_events.inc"
#include "../tools/madcide/madcide_core.inc"

long find_panel(var &tree)
{
    long i = 0;
    for ( var k : tree["children"] )
    {
	if ( !k["hints"].is_null() && k["hints"]["region"] == "panel" )
	    return i;
	i = i + 1;
    }
    return -1;
}

// The panel group's active-tab content (its one child), "" when no panel.
void panel_output(var &out, var &tree)
{
    out = "";
    long pi = find_panel(tree);
    if ( pi < 0 )
	return;
    var panel = tree["children"][pi];
    if ( php::count(panel["children"]) > 0 )
	out = panel["children"][0]["content"];
}

int main()
{
    const char *path = "madc_ide_panel.mad";
    php::file_put_contents(path, "long id(long x) { return x; }\n");
    long w = ui::world_new();
    long doc = setup_editor(w, path, false);
    long es = ui::entity_by_name(w, "editor-state");
    ui::set(w, es, "profile_dir", "tools/madcide/profiles");
    ui::set(w, es, "profile", "joe");
    load_status(w, es, "joe");
    IdeSession S;
    S.attach(w, es);

    // Nothing shown: the panel pane of the layout is hidden — no panel node.
    var t0;
    S.compose_ide_tree(t0, doc);
    println("no-build: panel-index={}", find_panel(t0));

    // A live build: seed the [build] buffer + the flag, then SHOW the output
    // View (what start_build does) — the panel docks with the stream.
    long bdoc = build_doc(w, es);
    append_build_line(w, es, bdoc, "=== echo hello ===");
    append_build_line(w, es, bdoc, "hello from the build");
    ui::set(w, es, "buildlive", 1);
    show_output(w, es);
    var t1;
    S.compose_ide_tree(t1, doc);
    println("build-live: panel-present={} shown={}", find_panel(t1) >= 0 ? 1 : 0,
	    view_name(slot_shown(w, es, slotPANEL)));
    var pc;
    panel_output(pc, t1);
    println("panel-has-output={}", pc.index("hello from the build") >= 0 ? 1 : 0);

    // The build drains but the Output panel stays (VS Code shape) until hidden.
    ui::set(w, es, "buildlive", 0);
    var t2;
    S.compose_ide_tree(t2, doc);
    println("drained: panel-present={}", find_panel(t2) >= 0 ? 1 : 0);

    // Toggle the panel off: gone.
    toggle_slot(w, es, slotPANEL);
    var t3;
    S.compose_ide_tree(t3, doc);
    println("hidden: panel-index={}", find_panel(t3));
    return 0;
}
