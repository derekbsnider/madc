#!/usr/bin/env madc
#include <stdio.h>
#include <string.h>

volatile int v0 = 0;
static const char s4_2[2][4] = { "1234", "5678" };

int main()
{
	printf("%d %d\n", (int)sizeof(s4_2), (int)sizeof(s4_2[1]));
	printf("%d %d %d %d\n",
		memchr(s4_2[1], 0, sizeof s4_2[1]) == 0,
		memchr(s4_2[1] + 2, 0, sizeof s4_2[1] - 2) == 0,
		memchr(s4_2[1] + 3, 0, sizeof s4_2[1] - 3) == 0,
		memchr(s4_2[v0], 0, sizeof s4_2[v0]) == 0);
	return 0;
}
