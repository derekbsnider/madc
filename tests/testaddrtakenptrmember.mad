// Regression: `&ptr->member` returned garbage when `ptr` was
// address-taken elsewhere in the same function (vfADDRTAKEN →
// stack-backed). `voperand` returned the Mem slot holding the
// pointer *value*; `TokenMember::operand` then treated that Mem as
// if it were the struct itself and `addOffset`'d into the pointer's
// own storage rather than the struct the pointer points at. Result:
// an address inside the local stack frame, not the struct member.
//
// Fix: in TokenMember::operand, when `_obj.isMem()` AND
// `object.type->is_pointer()`, load the pointer value from the Mem
// into a fresh Gp first, then compute `[gp + offset]` the same way
// the existing reg-pointer branch does.
//
// Surfaced while writing tests/testaddrclass.mad; reproduced with a
// plain variable name so the `class` fix wasn't involved.

#include <iostream>
using namespace std;

struct X { int v; };
struct Y { struct X ext; int tail; };

int main()
{
    struct Y y;
    y.ext.v = 7;
    y.tail = 99;
    struct Y *p = &y;

    // Address-take p to mark it vfADDRTAKEN → stack-backed.
    struct Y **pp = &p;

    // Now `&p->ext` must still produce the real address of y.ext,
    // not the address of p's stack slot.
    struct X *ex = &p->ext;
    cout << ex->v << endl;          // 7

    // Reading a scalar member through p also works.
    cout << p->ext.v << endl;       // 7
    cout << p->tail << endl;        // 99

    // Writing through the address works too.
    ex->v = 42;
    cout << y.ext.v << endl;        // 42 — confirms ex really points into y

    // Prove pp was actually used (so the optimizer can't drop
    // the address-take).
    if ( *pp == p ) cout << "pp-ok" << endl;

    return 0;
}
