/* The implicit (or defaulted) copy/move constructor copies each base and
   member with ITS constructor ([class.copy.ctor]/14): an rvalue source moves
   them, an lvalue copies them. madc bit-copied the object and re-ran only
   the members' copy constructors:
     - a base with a user move constructor was never run, so `D b(std::move(a))`
       left `a` still owning its pointer (std::unique_ptr's move: a double
       free), and D, E and F refused to compile at all;
     - the "copy constructor" it re-ran was whichever same-class constructor
       came first, so copying an H whose member declares its move constructor
       first MOVED from the source.
   Oracle: g++ and clang++ -std=c++17 print both lines below. */
#include <cstdio>
#include <utility>

struct I { int *p; I(int *q) : p(q) {} I(I &&u) : p(u.p) { u.p = 0; } };
struct D : I { using I::I; D(D &&) = default; };
struct E : I { E(int *q) : I(q) {} E(E &&) = default; };
struct F : I { F(int *q) : I(q) {} };
struct U { D d; U(int *q) : d(q) {} U(U &&) = default; };

struct CM {
	int v, moved;
	CM(int x) : v(x), moved(0) {}
	CM(CM &&o) : v(o.v), moved(1) { o.v = -1; }
	CM(const CM &o) : v(o.v), moved(0) {}
};
struct H { CM c; H(int x) : c(x) {} };

int main()
{
	int x = 1;
	D a(&x); D b(std::move(a));
	E c(&x); E d(std::move(c));
	F e(&x); F f(std::move(e));
	U u1(&x); U u2(std::move(u1));
	printf("moved %d%d %d%d %d%d %d%d\n", a.p != 0, b.p != 0, c.p != 0,
	       d.p != 0, e.p != 0, f.p != 0, u1.d.p != 0, u2.d.p != 0);
	H h1(4);
	H h2(h1);
	H h3(std::move(h1));
	printf("copy %d %d %d %d %d\n", h2.c.v, h2.c.moved, h1.c.v, h3.c.v,
	       h3.c.moved);
	return 0;
}
