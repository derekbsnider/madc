#!/../bin/madc

#include <stdio.h>

unsigned int foo(unsigned int x)
{
    return (x >> 24)
	| ((x >> 8) & 0xff00)
	| ((x << 8) & 0xff0000)
	| (x << 24);
}

int main(void)
{
    unsigned long long value =
	foo(0xfeedbea8U) | ((unsigned long long)foo(0xdeadbeefU) << 32);
    printf("0x%016llx\n", value);
    return 0;
}
