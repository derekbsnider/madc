#!/usr/bin/env madc
// Test pointer type declarations and -> operator
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int main()
{
	// basic pointer declarations
	int *p = NULL;
	char *name = NULL;
	void *data = NULL;

	printf("int *p = %ld\n", p);
	printf("char *name = %ld\n", name);
	printf("void *data = %ld\n", data);

	// sizeof pointer types
	printf("sizeof(int *) = %ld\n", sizeof(int *));
	printf("sizeof(char *) = %ld\n", sizeof(char *));
	printf("sizeof(void *) = %ld\n", sizeof(void *));

	// pointer in struct
	struct Node {
		int value;
		int *next;
	};

	printf("sizeof(struct Node) = %ld\n", sizeof(struct Node));

	// double pointer
	char **argv = NULL;
	printf("char **argv = %ld\n", argv);

	// -> operator: allocate struct via calloc and access via pointer
	struct Point {
		int x;
		int y;
	};

	struct Point *pt = calloc(1, sizeof(struct Point));
	pt->x = 42;
	pt->y = 99;
	printf("pt->x = %ld\n", pt->x);
	printf("pt->y = %ld\n", pt->y);
	free(pt);

	printf("All pointer tests passed!\n");
	return 0;
}
