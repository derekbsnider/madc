#include <stdio.h>

int main()
{
    int i = 0;
    int sum = 0;

    for ( ; i < 4; i++ )
        sum += i;

    printf("%d\n", sum);

    for ( i = 0; ; i++ )
    {
        if ( i == 3 )
            break;
    }

    printf("%d\n", i);

    for ( i = 0; i < 3; )
        i++;

    printf("%d\n", i);

    return 0;
}
