// Task #36 slice 2: user-class diamond accessed through base-typed views.
// A shared virtual base lives at the end of the MOST-DERIVED object, so any
// adjust through a less-derived view (A* / B* pointing into a D) must read
// the offset from the vtable's vbase-offset slot — madc-emitted vtables
// carry the slots (class_vtable_def prologue). Oracle: g++ -O0 prints the
// same four lines.
#include <cstdio>

struct V {
	int v;
	virtual int tag() { return v; }
	virtual ~V() {}
};
struct A : virtual V {
	int a;
	virtual int atag() { return a; }
};
struct B : virtual V {
	int b;
	virtual int btag() { return b; }
};
struct D : A, B {
	int d;
};

int take_v(V &r) { return r.v; }

D &get(D &r) { return r; }
B &getb(D &r) { return r; }

int main()
{
	D obj;
	obj.v = 7; obj.a = 1; obj.b = 2; obj.d = 3;
	A *ap = &obj;
	B *bp = &obj;
	printf("call %d %d\n", ap->tag(), bp->tag());
	V *vpa = ap;
	V *vpb = bp;
	printf("upcast %d %d\n", vpa->v, vpb->v);
	printf("bind %d %d\n", take_v(*ap), take_v(*bp));
	V &vr = *bp;
	printf("vcall %d\n", vr.tag());
	printf("refmem %d\n", vr.v);
	// Task #47: direct member access through the less-derived views — the
	// member is hosted in the virtual base, so the read/write must take the
	// dynamic (vtable-slot) adjust, not A's/B's static flattened offset.
	printf("member %d %d\n", ap->v, bp->v);
	ap->v = 9;
	printf("write %d %d\n", obj.v, bp->v);
	// Task #47 residue: a V& bound to a ref-RETURNING call (D& / B&) or
	// re-bound from a ref variable takes the same dynamic vbase adjust —
	// the operand's class hides behind a DataDefREF, not a class datadef.
	V &rc = get(obj);
	V &rb = getb(obj);
	B &br = obj;
	V &rr = br;
	printf("refcall %d %d %d\n", rc.v, rb.v, rr.v);
	// ...and the ref-RETURN upcast itself (`return r;` converting D& to B&
	// inside getb) must adjust to the B subobject — pair the member read
	// with the vcall (slot-prefix luck hides a wrong receiver otherwise).
	B &bu = getb(obj);
	printf("retup %d %d\n", bu.b, bu.btag());
	return 0;
}
