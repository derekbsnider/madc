#!/../bin/madc
// Compound-assign operators (`&=`, `|=`, `^=`, `+=`, etc.) on
// expression-base subscripts — e.g. `obj.bits[i] &= ~mask;`,
// `p->arr[j] += n;`. `resolveCompoundLHS` used to throw
// `<op> on unsupported subscript lval` because its ttSubscript
// branch only recognized `TokenSubscript` with a fixed-array
// variable base; `TokenSubscriptExpr` (subscript whose base is any
// expression — a struct member, a pointer-deref, a call result)
// fell through to the error.
//
// SMAUG's xREMOVE_BIT / xSET_BIT macros expand to
// `(var).bits[(bit) >> RSV] &= ~(1 << ((bit) & XBM))` — the canonical
// form. Closes that MadSMAUG compile front edge.

#include <stdio.h>

struct V { int bits[4]; };

int main()
{
    // 1. Direct struct-contained int[N] compound-assign.
    struct V v;
    v.bits[0] = 0xFF;
    v.bits[1] = 0x0F;
    v.bits[2] = 0;
    v.bits[3] = 0;

    v.bits[0] &= 0x0F;       // 0x0F
    v.bits[1] |= 0xF0;       // 0xFF
    v.bits[2] ^= 0xAA;       // 0xAA (was 0)
    v.bits[3] += 7;          // 7
    printf("1: %x %x %x %d\n", v.bits[0], v.bits[1], v.bits[2], v.bits[3]);

    // 2. Same, but through a pointer.
    struct V *p = &v;
    p->bits[0] |= 0x10;       // 0x1F
    p->bits[1] &= 0x0F;       // 0x0F
    printf("2: %x %x\n", p->bits[0], p->bits[1]);

    // 3. Dynamic index.
    int i = 2;
    p->bits[i] &= 0x0F;       // 0x0A (was 0xAA)
    printf("3: %x\n", p->bits[i]);

    return 0;
}
