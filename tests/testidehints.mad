// Slice 3 (madcide GUI): the composer stamps ADDITIVE layout hints —
// `region` on the editor and status nodes, `popup` on a floating pane —
// that the TUI ignores (tui_model reads only caret/sel/focus/list/
// tabwidth/spans) and web_model lays into the workbench. The gate is that
// the ROLES and text are unchanged (testmadcide pins the terminal
// composition byte-identical); this reducer pins the new hints. Oracle:
// the design's role->region table (docs/plans/2026-09-06-ui-web-target-
// and-madcide-gui.md §3.4). Runs with the madcide session, no compiler.
#include "../tools/texteditor/lined_core.inc"
#include "../tools/texteditor/editor_events.inc"
#include "../tools/madcide/madcide_core.inc"

int main()
{
    const char *path = "madc_ide_hints.mad";
    php::file_put_contents(path, "long id(long x) { return x; }\n");

    long w = ui::world_new();
    long doc = setup_editor(w, path, false);
    long es = ui::entity_by_name(w, "editor-state");
    ui::set(w, es, "profile_dir", "tools/madcide/profiles");
    ui::set(w, es, "profile", "joe");
    load_status(w, es, "joe");
    IdeSession S;
    S.attach(w, es);
    // The buffer table row 0 (what IdeSession::open seeds): the split
    // composes inactive windows from their buffer rows.
    push_buffer_row(w, es, doc, path);
    ui::set(w, es, "bufidx", 0);

    // Base tree: status at children[0], the edit node at children[1] (the
    // order testmadcide pins). The regions place them in the workbench.
    var tree;
    S.compose_ide_tree(tree, doc);
    var st = tree["children"][0];
    var ed = tree["children"][1];
    println("roles: status={} edit={}", st["role"], ed["role"]);
    println("region: status={} editor={}",
	    st["hints"]["region"], ed["hints"]["region"]);
    // One buffer open -> no tab strip yet.
    println("tabs: {}", ed["hints"]["tabs"].is_null() ? "none" : "yes");

    // A floating pane (help needs no compiler data): the box carries popup.
    ui::set(w, es, "pane", "help");
    var t2;
    S.compose_ide_tree(t2, doc);
    var kids = t2["children"];
    var box = kids[php::count(kids) - 1];
    println("pane: role={} popup={}", box["role"],
	    box["hints"]["popup"].is_null() ? "none" : "yes");

    // Additive-only: the grid model still reads the edit node's own hints
    // (caret) unchanged beside the new region key.
    println("caret-hint: {}", ed["hints"]["caret"]);

    // IDE-9e windows in the workbench (S5): with two-plus windows EVERY
    // window's status line and edit node docks into the editor slot — a
    // window's status line is its header there, stacked in tree order (the
    // JOE shape; the terminal reads none of it, testmadcide pins its
    // shape). No node is left without a slot: an unplaced node would fall
    // into the grid's empty rail cell. Back to one window the status
    // returns to the status bar.
    ui::set(w, es, "pane", "");
    split_window(w, es, doc);
    var t3;
    S.compose_ide_tree(t3, doc);
    var k3 = t3["children"];
    println("split: kids={} regions={}/{}/{}/{} rows-hint={}",
	    php::count(k3),
	    k3[0]["hints"]["region"], k3[1]["hints"]["region"],
	    k3[2]["hints"]["region"], k3[3]["hints"]["region"],
	    k3[3]["hints"]["rows"].is_null() ? "none" : "yes");
    // The message row (the split's "2 windows.") is the LAST child and is
    // unplaced: the page flows it to the foot — its region stays absent.
    var last3 = k3[php::count(k3) - 1];
    println("split-msg: role={} region={}", last3["role"],
	    last3["hints"]["region"].is_null() ? "none" : "set");
    kill_window(w, es, doc, true);
    var t4;
    S.compose_ide_tree(t4, doc);
    println("one-window: status={} editor={}",
	    t4["children"][0]["hints"]["region"],
	    t4["children"][1]["hints"]["region"]);
    return 0;
}
