// A static-const member initializer reading a decltype-qualified static member
// (`static const bool value = decltype(__test<_Tp>(0))::value;` — the libc++
// detection idiom) folds at INSTANTIATION with the substituted operand:
//  - the runtime-access pre-gate must not veto the unevaluated decltype operand
//  - fold_constant_qualified_member resolves the decltype-specifier as the scope
// KNOWN-OPEN sibling (tmp/hascat1.cpp): the SFINAE FALSE branch — a candidate
// whose param type fails substitution ([temp.deduct]/8, has_cat<int>) is not
// yet rejected; this gate covers the TRUE branch fold only.
// Oracle: g++ -std=c++11 and clang++-18 -std=c++11 print "1".
#include <cstdio>

struct TT { static const bool value = true; };
struct FT { static const bool value = false; };

struct traits { typedef int cat; };

template <class _Tp>
struct has_cat {
private:
	template <class _Up> static FT __test(...);
	template <class _Up> static TT __test(typename _Up::cat * = 0);

public:
	static const bool value = decltype(__test<_Tp>(0))::value;
};

int main()
{
	printf("%d\n", (int)has_cat<traits>::value);
	return 0;
}
