// An aggregate's trailing member of a ctor-less CLASS type is copy-initialized
// from `{}` ([dcl.init.aggr]/5) — value-initialized, so its scalars read 0. The
// stack is dirtied first so a skipped zero-fill reads 0xA5 bytes.
// Oracle: g++ 13 and clang++ 18 print the lines below.
#include <cstdio>
struct In { int q; };
struct PI : In { PI() : In{ 1 } { } };		// In becomes a ctor-less class
struct NI { int n = 7; int z; };
struct PN : NI { PN() : NI{ 8 } { } };		// so does NI
struct Out { int a; In in; NI ni; };
struct PO : Out { PO() : Out{ 1 } { } };
__attribute__((noinline)) void dirty()
{
	volatile unsigned char junk[4096];
	for (int k = 0; k < 4096; k++) junk[k] = 0xA5;
}
__attribute__((noinline)) void decl()
{
	Out o{ 2 };
	Out t = Out{ 3 };
	std::printf("decl: %d %d %d %d | %d %d %d %d\n", o.a, o.in.q, o.ni.n, o.ni.z,
		t.a, t.in.q, t.ni.n, t.ni.z);
}
__attribute__((noinline)) void meminit()
{
	PO po;
	std::printf("meminit: %d %d %d %d\n", po.a, po.in.q, po.ni.n, po.ni.z);
}
int main()
{
	dirty(); decl();
	dirty(); meminit();
	return 0;
}
