// adventure pilot verb body: inventory (intransitive).
// Eval-context bindings: w/actor/target = int64, arg/verb = const char*.
var held;
ui::contents(held, w, actor);
long n = held.count();
if ( n == 0 )
    return "You are carrying nothing.";
var acc = "You are carrying ";
long i = 0;
for ( value hn : held )
{
    if ( i > 0 )
    {
        if ( i + 1 == n )
            acc = format("{} and ", acc);
        else
            acc = format("{}, ", acc);
    }
    long e = ui::entity_by_name(w, hn.c_str());
    var s;
    ui::get(s, w, e, "short");
    if ( s.is_null() )
        ui::name_of(s, w, e);
    acc = format("{}{}", acc, s);
    i = i + 1;
}
acc = format("{}.", acc);
long ws = ui::entity_by_name(w, "world-state");
if ( ws )
{
    var tt;
    ui::get(tt, w, ws, "turn");
    long tn = tt.is_null() ? 0 : tt.as_integer();
    ui::set(w, ws, "turn", tn + 1);
}
long lamp = ui::entity_by_name(w, "brass-lantern");
if ( lamp )
{
    var lit;
    ui::get(lit, w, lamp, "lit");
    if ( !lit.is_null() && lit.as_boolean() )
    {
        var f;
        ui::get(f, w, lamp, "fuel");
        long fn = f.is_null() ? 0 : f.as_integer();
        ui::set(w, lamp, "fuel", fn - 1);
        if ( fn - 1 <= 0 )
            ui::set(w, lamp, "lit", false);
    }
}
return format("{}", acc);
