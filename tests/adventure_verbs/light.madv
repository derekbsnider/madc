// adventure pilot verb body: light <thing>.
// Eval-context bindings: w/actor/target = int64, arg/verb = const char*.
long t = ui::resolve(w, actor, arg, "noun");
if ( t == 0 )
    return "Light what?";
var s;
ui::get(s, w, t, "short");
if ( s.is_null() )
    ui::name_of(s, w, t);
var f;
ui::get(f, w, t, "fuel");
long fu = f.is_null() ? 0 : f.as_integer();
if ( fu <= 0 )
    return format("{} is out of fuel.", php::ucfirst(s));
ui::set(w, t, "lit", true);
long ws = ui::entity_by_name(w, "world-state");
if ( ws )
{
    var tt;
    ui::get(tt, w, ws, "turn");
    long tn = tt.is_null() ? 0 : tt.as_integer();
    ui::set(w, ws, "turn", tn + 1);
}
long lamp = ui::entity_by_name(w, "brass-lantern");
if ( lamp )
{
    var lit;
    ui::get(lit, w, lamp, "lit");
    if ( !lit.is_null() && lit.as_boolean() )
    {
        var lf;
        ui::get(lf, w, lamp, "fuel");
        long fn = lf.is_null() ? 0 : lf.as_integer();
        ui::set(w, lamp, "fuel", fn - 1);
        if ( fn - 1 <= 0 )
            ui::set(w, lamp, "lit", false);
    }
}
return format("{} glows warmly.", php::ucfirst(s));
