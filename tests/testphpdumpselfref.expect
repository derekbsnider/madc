--- the same type twice, no cycle: both must print
Twice Object
(
    [a] => Pt Object
        (
            [x] => 1
            [y] => 2
        )
    [b] => Pt Object
        (
            [x] => 3
            [y] => 4
        )
)
--- self-referential container: members, not 4 GB
Node Object
(
    [v] => 1
)
struct Node(1) {
  ["v"]=>
  int(1)
}
--- self-referential TEMPLATE container: the word path
Box_int32_t Object
(
    [v] => 7
)
struct Box_int32_t(1) {
  ["v"]=>
  int(7)
}
