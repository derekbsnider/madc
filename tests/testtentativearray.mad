// A file-scope tentative definition whose array type is still incomplete at
// the end of the translation unit has ONE element, zero-initialized (C11
// 6.9.2p2, the example of p5): `int i[];` behaves as `int i[1] = { 0 };`.
// madc emitted `[0]` — no storage — and `c[0][1]` read the next object.
// gcc 13.3 and clang 18.1 (-std=c11) print the .expect line.
#include <stdio.h>
#include <stdint.h>
struct {
	uint8_t a;
} b[], e;
uint8_t c[][8];
int32_t d = 5;
int i[];
int main(void)
{
	c[0][7] = 3;
	i[0] = 9;
	printf("tentative: %d %d %d %d %d %d\n", c[0][1], c[0][7], b[0].a, e.a, d, i[0]);
	return 0;
}
