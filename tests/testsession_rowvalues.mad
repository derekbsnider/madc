// A binding row's value (plan §7f, the Symbols view and %whos): the row's
// own column names the type, so the value spells none — gdb's `info locals`
// is the oracle, the listing whose type is likewise elsewhere (gdb 15 on
// tmp/rowvalues_oracle.c: `s = 0x555555556004 "Test"`, `p = 0x1 <error:
// Cannot access memory at address 0x1>`, `ip = 0x10`, `pt = {x = 1, name =
// 0x1 <error: …>}`, `arr = {1, 2, 3}`, `f = B`). A character pointer shows
// its address and then its text, read through a fault-safe copy: a wild
// pointer shows `<unreadable>` (the row's width keeps gdb's sentence out)
// and never ends the backend. madc keeps its re-enterable spellings where
// gdb has none to offer: a null pointer is `NULL`, an enum value naming no
// enumerator is its number. Text longer than a row is cut (`…`); a read that
// stops inside a UTF-8 character keeps whole characters.

// The next reply, passing over running notices.
long next_reply(var &r, long h)
{
    var cases;
    cases[0] = madc::session_readable(h);
    for ( ;; )
    {
	long got = madc::session_poll(r, h);
	var o;
	madc::session_output(o, h);
	if ( got != 0 && r["kind"] == madc::session_reply::running )
	    continue;
	if ( got != 0 )
	    return got;
	var fired;
	madc::chan_select(fired, cases);
    }
}

// A row's value after its address (`0x… "Test"` -> `"Test"`): the address
// differs run to run.
var after_address(var v)
{
    long n = v.length();
    for ( long i = 0; i < n; i++ )
    {
	var c = v.substr(i, 1);
	if ( c == " " )
	    return v.substr(i + 1, n - i - 1);
    }
    return "";
}

int main()
{
    long h = madc::session_open("c17");
    var r;
    var entries = {
	"const char *s = \"Test\";",
	"char *p = (char *)1;",
	"char *z = 0;",
	"int *ip = (int *)16;",
	"struct P { int x; const char *name; };",
	"struct P pt = { 1, (const char *)1 };",
	"int arr[3] = { 1, 2, 3 };",
	"enum E { A, B };",
	"enum E e = (enum E)7;",
	"enum E f = B;",
	"const char *lng = \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\";",
	"const char *u = \"ééééééééééééééééééééééééééééééééééééééééé\";"
    };
    for ( var e : entries )
    {
	madc::session_offer(h, e.c_str(), true);
	next_reply(r, h);
    }

    madc::session_bindings(h);
    next_reply(r, h);
    for ( var row : r["rows"] )
    {
	var v = row["value"];
	if ( row["name"] == "s" || row["name"] == "u" )
	    println("{}: address={} text={}", row["name"], v.substr(0, 2),
		    after_address(v));
	else if ( row["name"] == "lng" )
	    println("lng: address={} cut={}", v.substr(0, 2),
		    v.substr(v.length() - 3, 3));
	else
	    println("{} = {}", row["name"], v);
    }
    println("running: {}", madc::session_running(h));
    madc::session_close(h);
    return 0;
}
