[foo   bar baz\n] @3 -> [foobar baz\n]
[foo   bar baz\n] @4 -> [foo bar baz\n]
[foo   bar baz\n] @0 -> [   bar baz\n]
[foo   bar baz\n] @1 -> [f   bar baz\n]
[a += b\n] @2 -> [a = b\n]
[a+=b\n] @1 -> [a=b\n]
[foo\nbar\n] @3 -> [foobar\n]
[foo  \nbar\n] @3 -> [foobar\n]
[\tx = 1;\n] @0 -> [x = 1;\n]
[foo\n  bar\n] @3 -> [foobar\n]
[a  \t b\n] @1 -> [ab\n]
[x;  y\n] @1 -> [x  y\n]
[end] @3 -> [end]
[naïve rest\n] @0 -> [ rest\n]
