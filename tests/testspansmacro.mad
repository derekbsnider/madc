// parse_spans coordinate truth under macro expansion (the fight.c
// strip_grapple "everything turns blue" defect): expansion tokens carry
// the INVOCATION line with columns marching through the expansion text,
// so their spans smeared onto the lines below, and real tokens after an
// invocation on the same physical line inherited the inflated column.
// Contract: every span names real source bytes — (column + length) fits
// its physical line; expansion tokens (tfSYNTHPOS) emit no spans at all.
// The oracle is the source text itself.
int main()
{
    var src = "#define DISPOSE(p) do { if (!(p)) bug(\"Freeing null pointer %s, line %d.\", __FILE__, __LINE__); else free(p); (p) = NULL; } while(0)\nvoid f(char *x)\n{\n    DISPOSE( x ); long tail = 42;\n}\n";
    long h = madc::parse_open(src.c_str(), "spans.mad");
    println("handle: {}", h > 0 ? 1 : 0);

    array lines;
    php::explode(lines, "\n", src.c_str());
    var sp;
    madc::parse_spans(sp, h);

    long overruns = 0;
    long inv_strings = 0;
    long inv_numbers = 0;
    long inv_number_col = -1;
    long inv_number_len = 0;
    for ( var r : sp )
    {
	long ln = r["line"].as_integer();
	long c = r["column"].as_integer();
	long len = r["length"].as_integer();
	var lv = lines[ln - 1];
	long width = lv.length();
	if ( c + len > width )
	{
	    overruns = overruns + 1;
	    println("  OVERRUN {} {}:{} +{} (line width {})", r["class"],
		    ln, c, len, width);
	}
	if ( ln == 4 && r["class"] == "string" )
	    inv_strings = inv_strings + 1;
	if ( ln == 4 && r["class"] == "number" )
	{
	    inv_numbers = inv_numbers + 1;
	    inv_number_col = c;
	    inv_number_len = len;
	}
    }
    println("overruns: {}", overruns);
    // The expansion's message string / __FILE__ / __LINE__ literals must
    // not paint the invocation line (they are not source bytes there).
    println("invocation-line strings: {}", inv_strings);
    // The REAL literal after the invocation on the same physical line
    // keeps its source-true position: "42" where the text puts it.
    var l4 = lines[3];
    long want = l4.index("42");
    println("invocation-line numbers: {} at {} len {}", inv_numbers,
	    want, inv_number_len);
    println("column matches: {}", inv_number_col == want ? 1 : 0);
    madc::parse_close(h);
    return 0;
}
