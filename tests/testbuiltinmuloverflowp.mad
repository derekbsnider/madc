#!/../bin/madc

#include <stdio.h>

int foo(int x)
{
    return __builtin_mul_overflow_p(x, 35, 0);
}

int bar(long x)
{
    return __builtin_mul_overflow_p(x, 35L, 0L);
}

int main(void)
{
    printf("%d\n", foo(0));
    printf("%d\n", foo(__INT_MAX__ / 35));
    printf("%d\n", foo(__INT_MAX__ / 35 + 1));
    printf("%d\n", bar(0));
    printf("%d\n", bar(__LONG_MAX__ / 35));
    printf("%d\n", bar(__LONG_MAX__ / 35 + 1));
    return 0;
}
