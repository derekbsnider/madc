// A multi-dimensional array's element is its ROW: `int m[2][3]` makes `*m`
// an int[3], `m + 1` a pointer to a row, `*pa[1]` (int *pa[2][2]) an int *.
// madc stores arrays flattened — a node's type is the SCALAR, the extents
// live beside it — and four sites re-derived the element from the scalar:
// `sizeof(*(m + 1))` measured 4 (gcc 12), `sizeof(*pa[1])` 4 (gcc 8),
// `sizeof(*c3[1])` 4 (gcc 16) — all silent — and `*s.g[1]`, `**(m + 1)`,
// `**pa[1]`, `**s.pg[1]`, `q.in->x`, `ps[1]->x` were refused. ONE owner
// now: Program::array_operand_element_type (deref, decay, member access).
// Oracle: gcc and clang, -std=c17.
#include <stdio.h>
#include <string.h>

struct S { int g[2][3]; int *pg[2][2]; int c[2][3][4]; };
struct P { int x; };
struct Q { struct P in[2]; };

int main(void)
{
    int m[2][3] = { { 1, 2, 3 }, { 4, 5, 6 } };
    int v = 7;
    int *pa[2][2] = { { &v, &v }, { &v, &v } };
    int c3[2][3][4] = { { { 0 } } };
    struct S s = { { { 1, 2, 3 }, { 4, 5, 6 } }, { { &v, &v }, { &v, &v } },
		   { { { 0 } } } };
    struct S *sp = &s;
    char names[2][4];
    struct P ps[2][2] = { { { 1 }, { 2 } }, { { 3 }, { 4 } } };
    struct Q q = { { { 7 }, { 8 } } };

    c3[1][0][3] = 9;
    s.c[1][0][2] = 8;
    printf("rows: %d %d %d\n", *s.g[1], *(s.g[1] + 2), **(m + 1));
    printf("member rows: %d %d\n", **(s.g + 1), (*(s.g + 1))[2]);
    printf("pointer rows: %d %d %d\n", **pa[1], **s.pg[1], **sp->pg[1]);
    printf("sizeof: %d %d %d %d\n", (int)sizeof(*(m + 1)), (int)sizeof(*pa[1]),
	   (int)sizeof(*s.pg[1]), (int)sizeof(*m));
    printf("sizeof 3d: %d %d %d\n", (int)sizeof(*c3[1]), (int)sizeof(*s.c[1]),
	   (int)sizeof(**c3));
    printf("3d: %d %d\n", (*c3[1])[3], (*s.c[1])[2]);
    printf("arrow: %d %d %d %d\n", q.in->x, (*ps)->x, ps[1]->x, (ps[1] + 1)->x);
    strcpy(names[0], "ab");
    strcpy(*(names + 1), "cde");
    printf("names: %s %s %d\n", names[0], names[1], (int)((names + 1) - names));
    return 0;
}
