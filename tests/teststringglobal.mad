#include <iostream>
using namespace std;

// File-scope std::string globals: a real `struct string` object constructed
// before main runs (C++ static init; madc injects the ctor at main entry).
// NB: the default-ctor global is NOT named `empty` — with `using namespace std`
// that bare name is ambiguous against the C++17 free function std::empty (from
// <bits/range_access.h>), which both g++ and clang++ reject. Same for `size`,
// `data`, etc.
string greeting = "Hello, global!";   // const char* ctor
string blank;                         // default ctor

int main()
{
    cout << greeting << endl;         // basic_string operator<<
    printstr(greeting);               // char* coercion: string_cstr(&greeting)
    cout << "len=" << greeting.size() << endl;
    cout << "[" << blank << "]" << endl;
    return 0;
}
