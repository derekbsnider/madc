// Contributed commands, views and event handlers (plugins Stage B1, plan
// §41.11a step 2; plugin design §5.3, G4): a module registers a command with
// its handler, and the command runs through every input boundary a built-in
// does; it registers a view by its name, title and bag key, and the view
// composes, lays out and navigates as a built-in list view does; it
// subscribes a handler to the REPL pane's reply events. Here the module
// is this test, the `builtin` transport (a handler compiled in, its address
// kept by the registry). Pins:
//   1. registration interns a code above the built-in range; a taken name
//      (a built-in's or an earlier contribution's), a name that is not a
//      plugin name and a missing handler are refused;
//   2. the world's converters know it (cmd_of_w / cmd_name_w); the built-in
//      table alone does not;
//   3. it runs through the one dispatcher: IdeSession::command hands it its
//      argument (no prompt between), and an action posted by NAME converts
//      at the session's entry;
//   4. a key profile line binds it when parsed against the world, and is
//      refused without it (an unknown action);
//   5. the seat (api_run) runs it by name, gated at the editor tier (the
//      core cannot see what a handler does); the MCP tool list and the LSP
//      server's executeCommand ids offer it;
//   6. a view registers above the built-in kinds; a taken name, a key that is
//      not the plugin's own (`plugin.name`) and a show command that is not a
//      contributed one are refused;
//   7. a layout line names it when parsed against the world, and is refused
//      without it; the layout writer spells it back (a round trip);
//   8. its show command brings its pane up; the pane composes the key's rows
//      as a choice, each row carrying the view's row verb, and its tab the
//      show command; no rows compose as "(empty)";
//   9. a choose on a row goes to the row's line through the one navigation
//      owner; a row that names no line goes nowhere;
//  10. a handler subscribed to a repl_event kind hears the pane's replies of
//      that kind, with the reply, and no other; a kind outside repl_event
//      and a missing handler are refused.
#include "../tools/texteditor/lined_core.inc"
#include "../tools/texteditor/editor_events.inc"
#include "../tools/madcide/madcide_core.inc"
#include "../tools/madcide/madcide_api.inc"
#include "../tools/madcide/madcide_mcp.inc"
#include "../tools/madcide/madcide_discover.inc"
#include "../tools/madcide/madcide_client.inc"
#include "../tools/madcide/madcide_lsp.inc"

// The module's handler: it says hello to its argument.
bool greet(long w, long es, long doc, const char *arg)
{
    ui::set(w, es, "msg", format("Hello, {}.", arg));
    return true;
}

// The module's event handler: it logs each event's kind and the reply's
// exit status (the stopped reply carries one) on a bag key of its own.
void heard(long w, long es, long doc, var &event)
{
    var h;
    ui::get(h, w, es, "test.heard");
    var s = "";
    if ( !h.is_null() )
	s = h;
    var rep = event["reply"];
    var st;
    keyed_get(st, rep, "exit_status");
    if ( st.is_null() )
	ui::set(w, es, "test.heard", format("{}|{}", s, event["kind"]));
    else
	ui::set(w, es, "test.heard", format("{}|{}:{}", s, event["kind"], st));
}

// The module's view command: it shows the module's view.
bool show_vars(long w, long es, long doc, const char *arg)
{
    var vn = "variables";
    show_view(w, es, view_of_w(w, vn));
    return true;
}

int main()
{
    const char *path = "madc_ide_contrib.c";
    php::file_put_contents(path,
	"int a = 1;\nint b = 2;\nint c = 3;\nint main(void) { return 0; }\n");
    IdeSession S;
    long doc = S.open(path, false);
    long w = S.world();

    // 1. Registration.
    long code = plugin_command(w, "greet", "Greet", (long)&greet);
    println("contrib-register: above-base={} again={} builtin-name={} bad-name={} no-handler={}",
	    code >= cmd_contrib_base() ? 1 : 0,
	    plugin_command(w, "greet", "Greet", (long)&greet),
	    plugin_command(w, "save", "Save", (long)&greet),
	    plugin_command(w, "two words", "x", (long)&greet),
	    plugin_command(w, "other", "x", 0));

    // 2. The converters.
    var nm;
    cmd_name_w(nm, w, code);
    println("contrib-names: of={} name={} builtin-table={}",
	    cmd_of_w(w, "greet") == code ? 1 : 0, nm, cmd_of("greet") == cmdNONE ? "none" : "set");

    // 3. The dispatcher: with its argument, then posted by name.
    bool cont = true;
    S.command(doc, code, "world", cont);
    var m;
    ui::get(m, w, S.es, "msg");
    println("contrib-command: cont={} msg={}", cont ? 1 : 0, m);
    var ev = { "event": "action", "event_code": ui::event_kind::action,
	       "action": "greet", "arg": "by name", "seq": "" };
    S.apply_ide_event(doc, ev);
    ui::get(m, w, S.es, "msg");
    println("contrib-byname: msg={}", m);

    // 4. A key profile line.
    var table;
    var scopes;
    var err;
    bool bound = parse_keys(table, scopes, "^g greet\n", err, w);
    var t2;
    var s2;
    var err2;
    bool unbound = parse_keys(t2, s2, "^g greet\n", err2);
    println("contrib-keys: with-world={} without={} why={}", bound ? 1 : 0, unbound ? 1 : 0, err2);

    // 5. The seat and the MCP tool list.
    var reply;
    api_run(reply, S, doc, -1, "greet", "seat");
    ui::get(m, w, S.es, "msg");
    println("contrib-seat: ok={} msg={} tier={}", reply["ok"].as_boolean() ? 1 : 0, m,
	    tier_name(cmd_min_tier_w(w, code)));
    var tools;
    mcp_tools(tools, w);
    long listed = 0;
    for ( var t : tools )
	if ( t["name"] == "greet" )
	    listed = 1;
    var ids;
    lsp_command_ids(ids, w);
    var want = format("{}greet", lsp_command_prefix());
    long offered = 0;
    for ( var id : ids )
	if ( id == want )
	    offered = 1;
    println("contrib-mcp: listed={} lsp={}", listed, offered);

    // 6. A view's registration.
    long show = plugin_command(w, "variables", "Variables", (long)&show_vars);
    long kind = plugin_view(w, "variables", "Variables", "test.vars", show);
    println("contrib-view-register: above-base={} again={} builtin-name={} bad-key={} bad-show={}",
	    view_contributed(kind) ? 1 : 0,
	    plugin_view(w, "variables", "V", "test.v", show),
	    plugin_view(w, "problems", "P", "test.p", cmdNONE),
	    plugin_view(w, "other", "O", "vars", cmdNONE),
	    plugin_view(w, "other", "O", "test.o", cmdSAVE));

    // 7. A layout line.
    const char *ltxt = "@window main\npane editor tabs views source focus\n"
		       "pane panel bottom 30% tabs views problems variables hidden\n";
    var lo;
    var lerr;
    bool laid = parse_layout(lo, ltxt, lerr, w);
    var lo2;
    var lerr2;
    bool unlaid = parse_layout(lo2, ltxt, lerr2);
    var back;
    layout_to_text(back, lo, w);
    var lo3;
    var lerr3;
    parse_layout(lo3, back.c_str(), lerr3, w);
    var back2;
    layout_to_text(back2, lo3, w);
    println("contrib-view-layout: with-world={} without={} why={} round-trip={}",
	    laid ? 1 : 0, unlaid ? 1 : 0, lerr2, back == back2 ? "same" : "differs");

    // 8. The show command, the pane, its rows.
    ui::set(w, S.es, "layout", lo);
    S.command(doc, show, "", cont);
    var cur;
    layout_get(cur, w, S.es);
    long tab = -1;
    long ci = chrome_hosting(cur, kind, tab);
    var pane;
    compose_chrome_pane(pane, w, S.es, doc, cur["chrome"][ci]);
    var none_row = pane["children"][0]["children"][0]["content"];
    var rows = {};
    rows[] = { "content": "a = 1", "line": 1 };
    rows[] = { "content": "b = 2", "line": 2 };
    rows[] = { "content": "(no line)" };
    ui::set(w, S.es, "test.vars", rows);
    compose_chrome_pane(pane, w, S.es, doc, cur["chrome"][ci]);
    var choice = pane["children"][0];
    var shown = "";
    long verbs = 0;
    for ( var it : choice["children"] )
    {
	shown = format("{}{}|", shown, it["content"]);
	if ( it["hints"]["code"].as_integer() == view_row_cmd(kind) )
	    verbs = verbs + 1;
    }
    var tabact = "";
    for ( var tb : pane["hints"]["tabs"] )
	if ( tb["title"] == "Variables" )
	    tabact = tb["action"];
    println("contrib-view-compose: shown={} label={} rows={} verbs={} tab={} empty={}",
	    view_shown(w, S.es, kind) ? 1 : 0, choice["label"], shown, verbs, tabact,
	    none_row);

    // 9. A choose on a row: to its line, and nowhere for a row with none.
    var ch = { "event": "choose", "event_code": ui::event_kind::choose,
	       "option": 2, "action": "", "action_code": view_row_cmd(kind) };
    S.apply_ide_event(doc, ch);
    long at = es_int(w, S.es, "caret", -1);
    var ch3 = { "event": "choose", "event_code": ui::event_kind::choose,
		"option": 3, "action": "", "action_code": view_row_cmd(kind) };
    S.apply_ide_event(doc, ch3);
    long at3 = es_int(w, S.es, "caret", -1);
    println("contrib-view-goto: line2={} no-line={}",
	    at == caret_to_line(w, doc, 2, 0) ? 1 : 0, at3 == at ? "stays" : "moved");

    // 10. The REPL pane's reply events: an entry taken, a run returned (no
    // subscriber), the session stopped.
    bool sub1 = plugin_event(w, reTAKEN, (long)&heard);
    bool sub2 = plugin_event(w, reSTOPPED, (long)&heard);
    bool badk = plugin_event(w, reLAST, (long)&heard);
    bool noh = plugin_event(w, reRAN, 0);
    ui::set(w, S.es, "replbusy", 7);
    var taken = { "kind": madc::session_reply::offer, "seq": 7,
		  "state": madc::offer_state::taken, "shown": "", "rendered": "" };
    repl_reply(w, S.es, taken);
    ui::set(w, S.es, "replrunseq", 9);
    var ran = { "kind": madc::session_reply::run, "seq": 9, "rendered": "" };
    repl_reply(w, S.es, ran);
    var stopped = { "kind": madc::session_reply::stopped, "seq": 0, "exit_status": 3 };
    repl_reply(w, S.es, stopped);
    var log;
    ui::get(log, w, S.es, "test.heard");
    long kt = reTAKEN;		// a long: format spells an unsigned-char enum as
    long ks = reSTOPPED;	// a byte (BUGS.md B93)
    var expected = format("|{}|{}:3", kt, ks);
    var verdict = log;
    if ( log == expected )
	verdict = "taken,stopped";
    println("contrib-events: subscribed={} bad-kind={} no-handler={} heard={}",
	    sub1 && sub2 ? 1 : 0, badk ? 1 : 0, noh ? 1 : 0, verdict);

    S.close();
    php::unlink(path);
    return 0;
}
