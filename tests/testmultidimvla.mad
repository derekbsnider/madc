int len;

int main()
{
	len = 4;
	int M1[len][len];
	int M2[len][len];
	int data[64];
	int i;
	int j;

	for (i = 0; i < len; i++)
		for (j = 0; j < len; j++)
			M1[i][j] = M2[i][j] = i * len + j;

	M2[1][0] = M2[0][1];

	for (i = 0; i < len - 1; i++)
		for (j = 0; j < len; j++)
			if (M1[i + 1][j] > M1[i][j])
				data[M2[i][j]] = i;

	printf("%d\n", data[M2[0][1]]);
	return 0;
}
