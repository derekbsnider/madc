#include <stdio.h>

static const char a[2][3] = { "1", "12" };
static const char b[2][3][9] = {
	{ "1", "1\0002" },
	{ "12\0003", "123\0004" }
};

int main(void)
{
	printf("%d %d %d %d %d %d\n",
		a[0][0], a[0][1], a[0][2],
		a[1][0], a[1][1], a[1][2]);
	printf("%d %d %d %d %d %d\n",
		b[0][1][0], b[0][1][1], b[0][1][2],
		b[1][0][0], b[1][0][1], b[1][0][2]);
	printf("%d %d %d %d\n",
		b[1][0][3], b[1][0][4],
		b[1][1][3], b[1][1][4]);
	return 0;
}
