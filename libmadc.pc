prefix=/usr/local
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: libmadc
Description: Mad-C embeddable JIT scripting engine
URL: https://github.com/derekbsnider/madc
Version: 0.34.0
Cflags: -I${includedir}
Libs: -L${libdir} -lmadc
Libs.private: -ldl -lz -lm -lpthread  -lzstd
