#!/usr/bin/env madc
// Colossal Cave Adventure — the 430-point Adventure 2.5, in madc.
//
// Data + observable behavior come from open-adventure (BSD-2, Will
// Crowther & Don Woods 1977-1995, revived by Eric S. Raymond 2017);
// the dungeon rides examples/adventure/adventure.world through the
// madc data hub (ui::). The implementation is madc's own: data-
// oriented ECS over the hub, systems + a transcript view, MUD-shaped
// seams (the player is an actor entity, never a singleton).
// Plan: docs/plans/2026-08-20-adventure-430-plan.md.
//
// ZERO includes, zero `using`, zero qualification — this is madc:
// print/println/format/getline are always-available intrinsics, and
// the auto-include scan resolves php:: / ui:: / madc:: / cin on first
// use, inside these modules too.

#include "adv_state.inc"
#include "adv_rng.inc"
#include "adv_io.inc"
#include "adv_vocab.inc"
#include "adv_describe.inc"
#include "adv_score.inc"
#include "adv_dwarves.inc"
#include "adv_travel.inc"
#include "adv_actions.inc"
#include "adv_loop.inc"

int main()
{
	if ( !world_boot() )
	{
		println(stderr, "advent: cannot open adventure.world");
		return 1;
	}
	init_game();
	// The command bag starts CLEARED: an untouched keyed slot is
	// null-kind, and the dispatch compares against "" (strict kinds).
	clear_command();
	// Deterministic default; transcripts re-seed with `seed N`.
	rng_seed(0);
	if ( ask_yes_no("WELCOME_YOU", "CAVE_NEARBY", "NO_MESSAGE") )
	{
		NOVICE = true;
		LIMIT = 1000;
	}
	for (;;)
	{
		if ( !do_move_step() )
			continue;
		if ( !do_command_once() )
			break;
	}
	// EOF: score and exit (the reference's terminate(quitgame)).
	terminate_game(M_QUIT);
	return 0;
}
