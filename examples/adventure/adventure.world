  turn_thresholds = [{"message":"Tsk!  A wizard wouldn't have to take 350 turns.  This is going to cost\nyou a couple of points.","point_loss":2,"threshold":350},{"message":"500 turns?  That's another few points you've lost.","point_loss":3,"threshold":500},{"message":"Are you still at it?  Five points off for exceeding 1000 turns!","point_loss":5,"threshold":1000},{"message":"Good grief, don't you *EVER* give up?  Do you realize you've spent\nover 2500 turns at this?  That's another ten points off, a total of\ntwenty points lost for taking so long.","point_loss":10,"threshold":2500}]
