  travel = [{"action":["goto","LOC_PLOVER"],"cond":null,"verbs":["SOUTH","PLOVER","OUTSIDE"]}]
%entity LOC_ARCHED
  conditions = {"DEEP":true}
  long = "You are in an arched hall.  A coral passage once continued up and east\nfrom here, but is now blocked by debris.  The air smells of sea water."
  short = You're in arched hall.
  travel = [{"action":["goto","LOC_SHELLROOM"],"cond":null,"verbs":["DOWN","SHELLROOM","OUTSIDE"]}]
%entity LOC_SHELLROOM
  conditions = {"DEEP":true}
  long = "You're in a large room carved out of sedimentary rock.  The floor and\nwalls are littered with bits of shells embedded in the stone.  A\nshallow passage proceeds downward, and a somewhat steeper one leads\nup.  A low hands and knees passage enters from the south."
  short = You're in Shell Room.
  travel = [{"action":["goto","LOC_ARCHED"],"cond":null,"verbs":["UP","MOT_38"]},{"action":["goto","LOC_SLOPING1"],"cond":null,"verbs":["DOWN"]},{"action":["speak","CLAM_BLOCKER"],"cond":["carry","CLAM"],"verbs":["SOUTH"]},{"action":["speak","OYSTER_BLOCKER"],"cond":["carry","OYSTER"],"verbs":["SOUTH"]},{"action":["goto","LOC_COMPLEX"],"cond":null,"verbs":["SOUTH"]}]
%entity LOC_SLOPING1
  conditions = {"DEEP":true}
  long = You are in a long sloping corridor with ragged sharp walls.
  maptag = Sloping corridor
  travel = [{"action":["goto","LOC_SHELLROOM"],"cond":null,"verbs":["UP","SHELLROOM"]},{"action":["goto","LOC_CULDESAC"],"cond":null,"verbs":["DOWN"]}]
%entity LOC_CULDESAC
  conditions = {"DEEP":true}
  long = You are in a cul-de-sac about eight feet across.
  maptag = Cul-de-sac.
  travel = [{"action":["goto","LOC_SLOPING1"],"cond":null,"verbs":["UP","OUTSIDE"]},{"action":["goto","LOC_SHELLROOM"],"cond":null,"verbs":["SHELLROOM"]}]
%entity LOC_ANTEROOM
  conditions = {"DEEP":true}
  long = "You are in an anteroom leading to a large passage to the east.  Small\npassages go west and up.  The remnants of recent digging are evident.\nA sign in midair here says \"Cave under construction beyond this point.\nProceed at own risk.  [Witt Construction Company]\""
  short = You're in anteroom.
  travel = [{"action":["goto","LOC_COMPLEX"],"cond":null,"verbs":["UP"]},{"action":["goto","LOC_BEDQUILT"],"cond":null,"verbs":["WEST"]},{"action":["goto","LOC_WITTSEND"],"cond":null,"verbs":["EAST"]}]
%entity LOC_DIFFERENT1
  conditions = {"ALLDIFFERENT":true,"DEEP":true,"NOBACK":true}
  long = You are in a maze of twisty little passages, all different.
  maptag = Maze all different
  travel = [{"action":["goto","LOC_DIFFERENT3"],"cond":null,"verbs":["SOUTH"]},{"action":["goto","LOC_DIFFERENT4"],"cond":null,"verbs":["SW"]},{"action":["goto","LOC_DIFFERENT5"],"cond":null,"verbs":["NE"]},{"action":["goto","LOC_DIFFERENT6"],"cond":null,"verbs":["SE"]},{"action":["goto","LOC_DIFFERENT7"],"cond":null,"verbs":["UP"]},{"action":["goto","LOC_DIFFERENT8"],"cond":null,"verbs":["NW"]},{"action":["goto","LOC_DIFFERENT9"],"cond":null,"verbs":["EAST"]},{"action":["goto","LOC_DIFFERENT10"],"cond":null,"verbs":["WEST"]},{"action":["goto","LOC_DIFFERENT11"],"cond":null,"verbs":["NORTH"]},{"action":["goto","LOC_LONGWEST"],"cond":null,"verbs":["DOWN"]}]
%entity LOC_WITTSEND
  conditions = {"DEEP":true,"NOBACK":true}
  hints = ["WITT"]
  long = You are at Witt's End.  Passages lead off in *ALL* directions.
  short = You're at Witt's End.
  travel = [{"action":["speak","FUTILE_CRAWL"],"cond":["pct",95],"verbs":["EAST","NORTH","SOUTH","NE","SE","SW","NW","UP","DOWN"]},{"action":["goto","LOC_ANTEROOM"],"cond":null,"verbs":["EAST"]},{"action":["speak","WAY_BLOCKED"],"cond":null,"verbs":["WEST"]}]
%entity LOC_MIRRORCANYON
  conditions = {"DEEP":true}
  hints = ["JADE"]
  long = "You are in a north/south canyon about 25 feet across.  The floor is\ncovered by white mist seeping in from the north.  The walls extend\nupward for well over 100 feet.  Suspended from some unseen point far\nabove you, an enormous two-sided mirror is hanging parallel to and\nmidway between the canyon walls.  (The mirror is obviously provided\nfor the use of the dwarves who, as you know, are extremely vain.)  A\nsmall window can be seen in either wall, some fifty feet up."
  short = You're in Mirror Canyon.
  sound = WIND_WHISTLES
  travel = [{"action":["goto","LOC_SECRET1"],"cond":null,"verbs":["SOUTH"]},{"action":["goto","LOC_RESERVOIR"],"cond":null,"verbs":["NORTH","RESERVOIR"]}]
%entity LOC_WINDOW2
  conditions = {"DEEP":true}
  long = "You're at a low window overlooking a huge pit, which extends up out of\nsight.  A floor is indistinctly visible over 50 feet below.  Traces of\nwhite mist cover the floor of the pit, becoming thicker to the left.\nMarks in the dust around the window would seem to indicate that\nsomeone has been here recently.  Directly across the pit from you and\n25 feet away there is a similar window looking into a lighted room.  A\nshadowy figure can be seen there peering back at you."
  short = You're at window on pit.
  travel = [{"action":["goto","LOC_THREEJUNCTION"],"cond":null,"verbs":["WEST"]},{"action":["goto","LOC_NECKBROKE"],"cond":null,"verbs":["MOT_39"]}]
%entity LOC_TOPSTALACTITE
  conditions = {"ALLALIKE":true,"DEEP":true}
  long = "A large stalactite extends from the roof and almost reaches the floor\nbelow.  You could climb down it, and jump from it to the floor, but\nhaving done so you would be unable to reach it to climb back up."
  short = You're at top of stalactite.
  travel = [{"action":["goto","LOC_SECRET2"],"cond":null,"verbs":["NORTH"]},{"action":["goto","LOC_ALIKE6"],"cond":["pct",40],"verbs":["DOWN","MOT_39","MOT_56"]},{"action":["goto","LOC_ALIKE9"],"cond":["pct",50],"verbs":["DOWN"]},{"action":["goto","LOC_ALIKE4"],"cond":null,"verbs":["DOWN"]}]
%entity LOC_DIFFERENT2
  conditions = {"ALLDIFFERENT":true,"DEEP":true,"NOBACK":true}
  long = You are in a little maze of twisting passages, all different.
  maptag = Maze all different
  travel = [{"action":["goto","LOC_DIFFERENT3"],"cond":null,"verbs":["SW"]},{"action":["goto","LOC_DIFFERENT4"],"cond":null,"verbs":["NORTH"]},{"action":["goto","LOC_DIFFERENT5"],"cond":null,"verbs":["EAST"]},{"action":["goto","LOC_DIFFERENT6"],"cond":null,"verbs":["NW"]},{"action":["goto","LOC_DIFFERENT7"],"cond":null,"verbs":["SE"]},{"action":["goto","LOC_DIFFERENT8"],"cond":null,"verbs":["NE"]},{"action":["goto","LOC_DIFFERENT9"],"cond":null,"verbs":["WEST"]},{"action":["goto","LOC_DIFFERENT10"],"cond":null,"verbs":["DOWN"]},{"action":["goto","LOC_DIFFERENT11"],"cond":null,"verbs":["UP"]},{"action":["goto","LOC_DEADEND13"],"cond":null,"verbs":["SOUTH"]}]
%entity LOC_RESERVOIR
  conditions = {"DEEP":true,"FLUID":true}
  long = "You are at the edge of a large underground reservoir.  An opaque cloud\nof white mist fills the room and rises rapidly upward.  The lake is\nfed by a stream, which tumbles out of a hole in the wall about 10 feet\noverhead and splashes noisily into the water somewhere within the\nmist.  There is a passage going back toward the south."
  short = You're at reservoir.
  sound = STREAM_SPLASHES
  travel = [{"action":["goto","LOC_MIRRORCANYON"],"cond":null,"verbs":["SOUTH","OUTSIDE"]},{"action":["speak","BAD_DIRECTION"],"cond":["not","RESER","WATERS_PARTED"],"verbs":["NORTH","MOT_42","CROSS"]},{"action":["goto","LOC_RESBOTTOM"],"cond":null,"verbs":["NORTH"]}]
%entity LOC_MAZEEND12
  conditions = {"ALLALIKE":true,"DEEP":true}
  long = Dead end
  travel = [{"action":["goto","LOC_ALIKE13"],"cond":null,"verbs":["SE"]}]
%entity LOC_NE
  conditions = {"DEEP":true,"LIT":true}
  long = "You are at the northeast end of an immense room, even larger than the\nGiant Room.  It appears to be a repository for the \"Adventure\"\nprogram.  Massive torches far overhead bathe the room with smoky\nyellow light.  Scattered about you can be seen a pile of bottles (all\nof them empty), a nursery of young beanstalks murmuring quietly, a bed\nof oysters, a bundle of black rods with rusty stars on their ends, and\na collection of brass lanterns.  Off to one side a great many dwarves\nare sleeping on the floor, snoring loudly.  A notice nearby reads: \"Do\nnot disturb the dwarves!\"  An immense mirror is hanging against one\nwall, and stretches to the other end of the room, where various other\nsundry objects can be glimpsed dimly in the distance."
  maptag = Repository ne end
  short = You're at ne end.
  sound = MURMURING_SNORING
  travel = [{"action":["goto","LOC_SW"],"cond":null,"verbs":["SW"]}]
%entity LOC_SW
  conditions = {"DEEP":true,"LIT":true}
  long = "You are at the southwest end of the repository.  To one side is a pit\nfull of fierce green snakes.  On the other side is a row of small\nwicker cages, each of which contains a little sulking bird.  In one\ncorner is a bundle of black rods with rusty marks on their ends.  A\nlarge number of velvet pillows are scattered about on the floor.  A\nvast mirror stretches off to the northeast.  At your feet is a large\nsteel grate, next to which is a sign that reads, \"Treasure Vault.\nKeys in main office.\""
  maptag = Repository sw end
  short = You're at sw end.
  sound = SNAKES_HISSING
  travel = [{"action":["goto","LOC_NE"],"cond":null,"verbs":["NE"]},{"action":["speak","GRATE_NOWAY"],"cond":null,"verbs":["DOWN"]}]
%entity LOC_SWCHASM
  conditions = {"DEEP":true}
  long = "You are on one side of a large, deep chasm.  A heavy white mist rising\nup from below obscures all view of the far side.  A sw path leads away\nfrom the chasm into a winding corridor."
  short = You're on sw side of chasm.
  travel = [{"action":["goto","LOC_WINDING"],"cond":null,"verbs":["SW"]},{"action":["speak","TROLL_BLOCKS"],"cond":["with","TROLL"],"verbs":["MOT_41","MOT_42","CROSS","NE"]},{"action":["speak","BRIDGE_GONE"],"cond":["not","CHASM","TROLL_BRIDGE"],"verbs":["MOT_41"]},{"action":["special",3],"cond":null,"verbs":["MOT_41"]},{"action":["goto","LOC_NOMAKE"],"cond":["not","CHASM","TROLL_BRIDGE"],"verbs":["MOT_39"]},{"action":["speak","CROSS_BRIDGE"],"cond":null,"verbs":["MOT_39"]}]
%entity LOC_WINDING
  conditions = {"DEEP":true}
  long = "You are in a long winding corridor sloping out of sight in both\ndirections."
  short = You're in sloping corridor.
  travel = [{"action":["goto","LOC_LOWROOM"],"cond":null,"verbs":["DOWN"]},{"action":["goto","LOC_SWCHASM"],"cond":null,"verbs":["UP"]}]
%entity LOC_SECRET4
  conditions = {"DEEP":true}
  long = You are in a secret canyon which exits to the north and east.
  maptag = Secret canyon
  travel = [{"action":["goto","LOC_SECRET1"],"cond":null,"verbs":["NORTH","OUTSIDE"]},{"action":["speak","NASTY_DRAGON"],"cond":null,"verbs":["EAST","FORWARD"]}]
