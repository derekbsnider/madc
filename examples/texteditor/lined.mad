// lined — the line-mode text editor (Track 7.2 R4, design doc §7.7).
// Usage: madc examples/texteditor/lined.mad <file> [ro]
// Run it from the repository root (the verb bodies load by relative
// path). Commands: p [N [M]] print · c N TEXT change · i N TEXT insert ·
// a TEXT append · d N [M] delete · f TEXT find · w write · q quit ·
// q! quit discarding.
#include "lined_core.inc"

int main(int argc, char **argv)
{
    if ( argc < 2 )
    {
	printf("usage: lined <file> [ro]\n");
	return 1;
    }
    run_session(argv[1], argc > 2);
    return 0;
}
