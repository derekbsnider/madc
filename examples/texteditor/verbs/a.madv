// lineed verb: a TEXT — append a line at the end of the document.
long doc = ui::entity_by_name(w, "document");
var ro;
ui::get(ro, w, doc, "read_only");
if ( !ro.is_null() && ro.as_boolean() )
    return "Document is read-only.";
var t = format("{}\n", arg);
ui::text_insert(w, doc, ui::text_size(w, doc), t.c_str());
ui::set(w, doc, "modified", true);
return "Appended.";
