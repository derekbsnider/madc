// lineed verb: w — write the document back to its own path (the text
// component is runtime-only; persistence is THIS verb's file write). The
// read-only rule is the shared availability check (checks/editable.madv).
long doc = ui::entity_by_name(w, "document");
var p;
ui::get(p, w, doc, "path");
if ( p.is_null() )
    return "No path.";
value t;
ui::text(t, w, doc);
long nb = php::file_put_contents(p.c_str(), t);
if ( nb < 0 )
    return "Write failed.";
ui::set(w, doc, "modified", false);
return format("Wrote {} bytes.", nb);
